diff --git a/drivers/usb-console/muic.c b/drivers/usb-console/muic.c
new file mode 100644
index 0000000..805bb55
--- /dev/null
+++ b/drivers/usb-console/muic.c
@@ -0,0 +1,239 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* G9209 MAX77843 MUIC, HSI2C1 pins GPD2[2:3]. Single-master boot-time access.
+ * GPIO and register assignments come from Samsung's zeroflte 3.10 tree.
+ * Drive only low; release to the board pullups for a logic one. */
+#include "utils.h"
+
+#define GPD2_CON 0x134700e0UL
+#define GPD2_DAT 0x134700e4UL
+#define SDA 2
+#define SCL 3
+#define PIN_MASK ((15U << (SDA * 4)) | (15U << (SCL * 4)))
+
+static void line(unsigned int pin, int high)
+{
+    mask32(GPD2_CON, 15U << (pin * 4), (high ? 0U : 1U) << (pin * 4));
+    usb_udelay(5);
+}
+
+static int clock_high(void)
+{
+    line(SCL, 1);
+    for (unsigned int i = 0; i < 1000; i++) {
+        if (read32(GPD2_DAT) & BIT(SCL)) return 0;
+        usb_udelay(1);
+    }
+    return -1;
+}
+
+static int start(void)
+{
+    line(SDA, 1);
+    if (clock_high()) return -1;
+    line(SDA, 0);
+    line(SCL, 0);
+    return 0;
+}
+
+static void stop(void)
+{
+    line(SCL, 0);
+    line(SDA, 0);
+    clock_high();
+    line(SDA, 1);
+}
+
+static int send_byte(u8 value)
+{
+    for (unsigned int bit = 0; bit < 8; bit++) {
+        line(SDA, value & 0x80);
+        if (clock_high()) return -1;
+        line(SCL, 0);
+        value <<= 1;
+    }
+    line(SDA, 1);
+    if (clock_high()) return -1;
+    int nack = !!(read32(GPD2_DAT) & BIT(SDA));
+    line(SCL, 0);
+    return nack ? -1 : 0;
+}
+
+static int read_reg(u8 reg, u8 *value)
+{
+    int ret = -1;
+    if (start() || send_byte(0x4a) || send_byte(reg) || start() || send_byte(0x4b))
+        goto out;
+    *value = 0;
+    line(SDA, 1);
+    for (unsigned int bit = 0; bit < 8; bit++) {
+        if (clock_high()) goto out;
+        *value = (*value << 1) | !!(read32(GPD2_DAT) & BIT(SDA));
+        line(SCL, 0);
+    }
+    /* A single-byte read ends with NACK, then STOP. */
+    line(SDA, 1);
+    if (clock_high()) goto out;
+    line(SCL, 0);
+    ret = 0;
+out:
+    stop();
+    return ret;
+}
+
+static int write_reg(u8 reg, u8 value)
+{
+    int ret = start() || send_byte(0x4a) || send_byte(reg) || send_byte(value);
+    stop();
+    return ret ? -1 : 0;
+}
+
+int usb_muic_prepare(void)
+{
+    u32 con = read32(GPD2_CON), dat = read32(GPD2_DAT);
+    u8 id = 0, s1 = 0, s2 = 0, ctrl = 0, cdet = 0, after = 0;
+    int result = -1;
+    /* Save both pins, release the bus, then preload output-low values. */
+    mask32(GPD2_CON, PIN_MASK, 0);
+    clear32(GPD2_DAT, BIT(SDA) | BIT(SCL));
+    if (!(read32(GPD2_DAT) & BIT(SDA)) || clock_high()) {
+        printk(KERN_WARNING, "[muic] bus not idle; no transaction attempted\n");
+        goto out;
+    }
+    if (read_reg(0x00, &id) || read_reg(0x04, &s1) || read_reg(0x05, &s2) ||
+        read_reg(0x0a, &cdet) || read_reg(0x0c, &ctrl)) {
+        printk(KERN_WARNING, "[muic] read failed id=%02x; no register writes\n", id);
+        goto out;
+    }
+    printk(KERN_NOTICE, "[muic] id=%02x status=%02x/%02x CDETCTRL1=%02x CTRL1=%02x pins=%08x\n",
+           id, s1, s2, cdet, ctrl, con);
+    result = 0;
+    /* This unit's ID is b5 (measured under TWRP). Route only a normal
+     * B-cable with VBUS, never an audio/UART/factory accessory. */
+    if (id == 0xb5 && (s1 & 0x1f) == 0x1f && (s2 & BIT(6)) &&
+        (ctrl & 0x3f) != 0x09) {
+        u8 usb = (ctrl & ~0x3f) | 0x09;
+        if (write_reg(0x0c, usb) || read_reg(0x0c, &after) || after != usb) {
+            printk(KERN_ERR, "[muic] USB route verification failed old=%02x wanted=%02x got=%02x\n",
+                   ctrl, usb, after);
+            result = -1;
+        } else {
+            printk(KERN_NOTICE, "[muic] USB route restored CTRL1=%02x -> %02x\n", ctrl, after);
+            result = 1;
+        }
+    }
+out:
+    /* Restore only our two pins; retain every unrelated GPIO setting. */
+    mask32(GPD2_DAT, BIT(SDA) | BIT(SCL), dat & (BIT(SDA) | BIT(SCL)));
+    mask32(GPD2_CON, PIN_MASK, con & PIN_MASK);
+    return result;
+}
+
+/* ------------------------------------------------------------------
+ * DSH 2026-10-20: 读 MAX77843 电量计（地址 0x36）。
+ *
+ * 目的：手机没有充电管理驱动时，每次 boot 前先把电池电压/SOC 读出来，
+ * 把"是不是欠压"从猜测变成数据。
+ *
+ * 寄存器（MAX17050/MAX77843 FG，主线 max77843-private.h 已定义）：
+ *   0x09 VCELL  16 位，LSB = 78.125 uV  => mV = raw * 78125 / 1000000
+ *   0x06 SOC    16 位，LSB = 1/256 %    => % = raw / 256
+ *   0x0A CURRENT 16 位有符号，LSB = 156.25 uA
+ * 只做只读访问，不改任何寄存器。
+ *
+ * 总线与 MUIC 相同：GPD2-2=SDA, GPD2-3=SCL（vendor hsi2c@13650000 的引脚）。
+ * ------------------------------------------------------------------ */
+
+/* 从 waddr 写寄存器地址，再从 raddr 读两个字节（高字节 ACK、低字节 NACK）。*/
+static int read_word(u8 waddr, u8 raddr, u8 reg, u8 *hi, u8 *lo)
+{
+    int ret = -1;
+    if (start() || send_byte(waddr) || send_byte(reg) ||
+        start() || send_byte(raddr))
+        goto out;
+
+    *hi = 0;
+    line(SDA, 1);
+    for (unsigned int bit = 0; bit < 8; bit++) {
+        if (clock_high()) goto out;
+        *hi = (u8)((*hi << 1) | !!(read32(GPD2_DAT) & BIT(SDA)));
+        line(SCL, 0);
+    }
+    /* ACK: master drives SDA low for one clock */
+    line(SDA, 0);
+    if (clock_high()) goto out;
+    line(SCL, 0);
+
+    *lo = 0;
+    line(SDA, 1);
+    for (unsigned int bit = 0; bit < 8; bit++) {
+        if (clock_high()) goto out;
+        *lo = (u8)((*lo << 1) | !!(read32(GPD2_DAT) & BIT(SDA)));
+        line(SCL, 0);
+    }
+    /* NACK + STOP */
+    line(SDA, 1);
+    if (clock_high()) goto out;
+    line(SCL, 0);
+    ret = 0;
+out:
+    stop();
+    return ret;
+}
+
+int usb_read_battery(void)
+{
+    static const u8 FG_W = 0x6c;   /* 0x36 << 1 */
+    static const u8 FG_R = 0x6d;
+    u32 con = read32(GPD2_CON), dat = read32(GPD2_DAT);
+    u8 hi, lo;
+    unsigned int vcell, soc, cur;
+    unsigned long mv;
+    int nack = 0;
+
+    /* 释放总线并预置输出低（与 usb_muic_prepare 同款） */
+    mask32(GPD2_CON, PIN_MASK, 0);
+    clear32(GPD2_DAT, BIT(SDA) | BIT(SCL));
+    if (!(read32(GPD2_DAT) & BIT(SDA)) || clock_high()) {
+        printk(KERN_WARNING, "[bat] bus not idle; no transaction attempted\n");
+        goto out;
+    }
+
+    if (read_word(FG_W, FG_R, 0x09, &hi, &lo)) {
+        printk(KERN_WARNING, "[bat] VCELL(0x09) read failed (NACK / bus error)\n");
+        nack++;
+        goto report;
+    }
+    vcell = ((unsigned int)hi << 8) | lo;
+
+    if (read_word(FG_W, FG_R, 0x06, &hi, &lo)) {
+        printk(KERN_WARNING, "[bat] SOC(0x06) read failed\n");
+        goto report;
+    }
+    soc = ((unsigned int)hi << 8) | lo;
+
+    if (read_word(FG_W, FG_R, 0x0a, &hi, &lo)) {
+        printk(KERN_WARNING, "[bat] CURRENT(0x0a) read failed\n");
+        goto report_soc;
+    }
+    cur = ((unsigned int)hi << 8) | lo;
+
+    /* mV = raw * 78125 / 1000000 = raw * 125 / 1600 */
+    mv = (unsigned long)(((unsigned long long)vcell * 78125ULL) / 1000000ULL);
+    printk(KERN_NOTICE,
+           "[bat] VCELL=%umV (0x%04x) SOC=%u.%02u%% (0x%04x) CURRENT=%dmA (0x%04x)\n",
+           (unsigned int)mv, vcell,
+           soc / 256, ((soc % 256) * 100) / 256, soc,
+           (int)((signed short)cur * 156250 / 1000000), cur);
+    mask32(GPD2_DAT, BIT(SDA) | BIT(SCL), dat & (BIT(SDA) | BIT(SCL)));
+    mask32(GPD2_CON, PIN_MASK, con & PIN_MASK);
+    return 0;
+
+report_soc:
+    mv = (unsigned long)(((unsigned long long)vcell * 78125ULL) / 1000000ULL);
+    printk(KERN_NOTICE, "[bat] VCELL=%umV (0x%04x)\n", (unsigned int)mv, vcell);
+report:
+    mask32(GPD2_DAT, BIT(SDA) | BIT(SCL), dat & (BIT(SDA) | BIT(SCL)));
+    mask32(GPD2_CON, PIN_MASK, con & PIN_MASK);
+out:
+    return -1;
+}
diff --git a/drivers/usb-console/ringbuffer.c b/drivers/usb-console/ringbuffer.c
new file mode 100644
index 0000000..f7ecb16
--- /dev/null
+++ b/drivers/usb-console/ringbuffer.c
@@ -0,0 +1,81 @@
+#include "ringbuffer.h"
+#include "malloc.h"
+#include "types.h"
+
+ringbuffer_t *ringbuffer_alloc(size_t len)
+{
+    ringbuffer_t *bfr = calloc(1, sizeof(*bfr));
+    if (!bfr)
+        return NULL;
+
+    bfr->buffer = calloc(len, 1);
+    if (!bfr->buffer) {
+        free(bfr);
+        return NULL;
+    }
+
+    bfr->read = 0;
+    bfr->write = 0;
+    bfr->len = len;
+
+    return bfr;
+}
+
+void ringbuffer_free(ringbuffer_t *bfr)
+{
+    if (bfr)
+        free(bfr->buffer);
+    free(bfr);
+}
+
+size_t ringbuffer_read(u8 *target, size_t len, ringbuffer_t *bfr)
+{
+    size_t read;
+
+    for (read = 0; read < len; ++read) {
+        if (bfr->read == bfr->write)
+            break;
+
+        *target = bfr->buffer[bfr->read];
+        target++;
+
+        bfr->read++;
+        bfr->read %= bfr->len;
+    }
+
+    return read;
+}
+
+size_t ringbuffer_write(const u8 *src, size_t len, ringbuffer_t *bfr)
+{
+    size_t written;
+
+    for (written = 0; written < len; ++written) {
+        if (((bfr->write + 1) % bfr->len) == bfr->read)
+            break;
+
+        bfr->buffer[bfr->write] = *src;
+        src++;
+
+        bfr->write++;
+        bfr->write %= bfr->len;
+    }
+
+    return written;
+}
+
+size_t ringbuffer_get_used(ringbuffer_t *bfr)
+{
+    size_t read = bfr->read;
+    size_t write = bfr->write;
+
+    if (write < read)
+        write += bfr->len;
+
+    return write - read;
+}
+
+size_t ringbuffer_get_free(ringbuffer_t *bfr)
+{
+    return bfr->len - ringbuffer_get_used(bfr);
+}
