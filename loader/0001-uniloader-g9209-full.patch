+
+static void *probe_fdt;
+
+/* Board-specific A/B switch: changes only this boot's expanded FDT. */
+void dsh_reserve_el3(void)
+{
+	const fdt32_t reg[] = { 0, cpu_to_fdt32(0xfe800000U),
+			       0, cpu_to_fdt32(0x01800000U) };
+	int parent, node, ret;
+	if (!probe_fdt || fdt_check_header(probe_fdt)) return;
+	parent = fdt_path_offset(probe_fdt, "/reserved-memory");
+	if (parent < 0) {
+		printk(KERN_ERR, "[dt] missing reserved-memory: %d\n", parent);
+		return;
+	}
+	node = fdt_subnode_offset(probe_fdt, parent, "trustzone@fe800000");
+	if (node == -FDT_ERR_NOTFOUND)
+		node = fdt_add_subnode(probe_fdt, parent, "trustzone@fe800000");
+	ret = node < 0 ? node : fdt_setprop(probe_fdt, node, "reg", reg, sizeof(reg));
+	if (!ret) ret = fdt_setprop(probe_fdt, node, "no-map", NULL, 0);
+	printk(ret ? KERN_ERR : KERN_NOTICE,
+	       "[dt] reserve EL3 fe800000+01800000 no-map result=%d\n", ret);
+}
+
+void dsh_unreserve_el3(void)
+{
+	int node, ret;
+	if (!probe_fdt || fdt_check_header(probe_fdt)) return;
+	node = fdt_path_offset(probe_fdt, "/reserved-memory/trustzone@fe800000");
+	ret = node < 0 ? node : fdt_del_node(probe_fdt, node);
+	printk(ret ? KERN_ERR : KERN_NOTICE,
+	       "[dt] unreserve EL3 result=%d; diagnostic A/B only\n", ret);
+}
+
+/* Updated from vmlinux by build_mainline.sh. */
+#define DSH_MARKER_PHYS 0x913d3960UL
+#define DSH_REGS_PHYS 0x913d3968UL
+#define DSH_DIAG_PHYS 0x913d3700UL
+#define DSH_DIAG_BUILD_ID 0x18dff874314c6416UL
+#define DSH_DIAG_TEST_PHYS 0x913d3a50UL
 
-void boot_kernel(void* dt, void* kernel, void* ramdisk)
+static unsigned long diag_run_id;
+
+/* The loader runs with M=0, where unaligned Device accesses fault even
+ * with SCTLR.A clear.  In particular, memcpy's end-relative word loads
+ * are unsafe for a retained message whose length is not word aligned.
+ * Volatile byte accesses also prevent the compiler widening this loop. */
+static void diag_copy_bytes(void *dst, const void *src, unsigned long bytes)
 {
+	volatile unsigned char *d = dst;
+	const volatile unsigned char *s = src;
+	while (bytes--)
+		*d++ = *s++;
+}
+
+static unsigned long diag_checksum(const struct dsh_diag_record *r)
+{
+	const unsigned char *p = (const unsigned char *)r;
+	unsigned long hash = 0xcbf29ce484222325UL;
+	for (unsigned int i = 0; i < sizeof(*r); ++i) {
+		hash ^= i >= 88 && i < 96 ? 0 : p[i];
+		hash *= 0x100000001b3UL;
+	}
+	return hash;
+}
+
+void dsh_arm_diag_record(unsigned long test_mode)
+{
+	struct dsh_diag_record r;
+	memset(&r, 0, sizeof(r));
+	r.magic = DSH_DIAG_MAGIC;
+	r.version = 1;
+	r.bytes = sizeof(r);
+	r.build_id = DSH_DIAG_BUILD_ID;
+	r.run_id = ++diag_run_id;
+	r.checksum = diag_checksum(&r);
+	diag_copy_bytes((void *)DSH_DIAG_PHYS, &r, sizeof(r));
+	*(volatile unsigned long *)DSH_DIAG_TEST_PHYS = test_mode;
+	printk(KERN_NOTICE, "[diagrec] armed build=%016lx run=%lu PA=%08lx test=%lu\n",
+	       r.build_id, r.run_id, (unsigned long)DSH_DIAG_PHYS, test_mode);
+}
+
+static void dsh_previous_record(void)
+{
+	struct dsh_diag_record r;
+	diag_copy_bytes(&r, (const void *)DSH_DIAG_PHYS, sizeof(r));
+	if (r.magic != DSH_DIAG_MAGIC || r.version != 1 || r.bytes != sizeof(r) ||
+	    r.text_len >= sizeof(r.text) || diag_checksum(&r) != r.checksum) {
+		printk(KERN_NOTICE, "[diagrec] no valid retained record\n");
+		return;
+	}
+	diag_run_id = r.run_id;
+	printk(KERN_NOTICE, "[diagrec] previous build=%016lx run=%lu seq=%lu matching=%lu\n",
+	       r.build_id, r.run_id, r.sequence,
+	       (unsigned long)(r.build_id == DSH_DIAG_BUILD_ID));
+	printk(KERN_NOTICE, "[diagrec] stage=%016lx initcall=%016lx caller=%016lx fmt=%016lx\n",
+	       r.stage, r.initcall, r.caller, r.fmt);
+	for (unsigned int off = 0; off < r.text_len; off += 128) {
+		char line[129];
+		unsigned int n = r.text_len - off;
+		if (n > 128) n = 128;
+		diag_copy_bytes(line, r.text + off, n);
+		line[n] = 0;
+		printk(KERN_NOTICE, "[diagrec] text: %s\n", line);
+	}
+}
+
+int dsh_arm_probe(unsigned int stage)
+{
+	unsigned long el, sctlr, spsel;
+	asm volatile("mrs %0, CurrentEL" : "=r"(el));
+	asm volatile("mrs %0, SCTLR_EL1" : "=r"(sctlr));
+	asm volatile("mrs %0, SPSel" : "=r"(spsel));
+	if (el != 4 || (sctlr & 1) || spsel != 1 || stage < 1 || stage > 69) {
+		printk(KERN_ERR, "[probe] requires EL1, MMU off, SP_EL1 and stage 1..69\n");
+		return -1;
+	}
+	volatile unsigned long *r = (volatile unsigned long *)DSH_REGS_PHYS;
+	for (unsigned int i = 0; i < 24; ++i) r[i] = 0;
+	r[12] = (unsigned long)dsh_probe_return;
+	r[13] = stage;
+	r[15] = 0x44534850524f4245UL;
+	printk(KERN_NOTICE, "[probe] armed stage=%u callback=%08lx regs=%08lx\n",
+	       stage, r[12], (unsigned long)DSH_REGS_PHYS);
+	return 0;
+}
+
+void dsh_report_probe(unsigned long result)
+{
+	static const char *const names[] = {
+		"invalid", "kernel entry", "identity map built", "CPU setup complete",
+		"MMU enable returned", "kernel mapping built", "relocation complete",
+		"high virtual entry", "initial task and stack installed",
+		"BSS cleared", "early FDT mapping returned", "before start_kernel",
+		"C start_kernel entry",
+		/* DSH: setup_machine_fdt 内部的 C 检查点 */
+		"setup_machine_fdt entry", "DT fixmap mapped",
+		"before DT scan", "DT scan OK",
+		"before RO remap", "RO remap returned",
+		"machine name read", "setup_machine_fdt done",
+		"setup_machine_fdt returned",
+		"jump_label done", "early params done", "DAIF restored",
+		"before idmap uninstall", "idmap uninstalled", "memblock done",
+		"paging_init done", "DT unflattened", "bootmem done",
+		"PSCI init done",
+		/* start_kernel 后半段 */
+		"after setup_arch", "trap_init done", "mm_core_init done",
+		"sched_init done", "time_init done", "before console_init",
+		"console_init done", "before rest_init",
+		/* time_init 内部 */
+		"time_init entry", "of_clk_init done", "timer_probe done",
+		"hrtimer broadcast", "arch timer rate", "time_init done",
+		"timekeeping_init done",
+		/* timekeeping_init 内部 */
+		"tk entry", "tk persistent clock", "tk before lock", "tk lock held",
+		"tk ntp done", "tk clk enable", "tk setup internals", "tk done",
+		/* start_kernel 中段（sched_init 之后）*/
+		"housekeeping done", "workqueue early done", "rcu_init done",
+		"trace_init done", "ctx tracking done", "before early_irq_init",
+		"early_irq_init done", "init_IRQ(GIC) done", "tick_init done",
+		"rcu_nohz done", "init_timers done", "srcu_init done"
+	};
+	volatile unsigned long *r = (volatile unsigned long *)DSH_REGS_PHYS;
+	if (result == 0x8000) {
+		printk(KERN_ERR, "[probe] EARLY EXCEPTION after checkpoint=%lu\n", r[14]);
+		printk(KERN_ERR, "[probe] ESR=%016lx FAR=%016lx ELR=%016lx\n",
+		       r[8], r[9], r[10]);
+	} else {
+		printk(KERN_NOTICE, "[probe] reached %lu: %s\n", result,
+		       result < sizeof(names)/sizeof(names[0]) ? names[result] : "invalid");
+	}
+	printk(KERN_NOTICE, "[probe] SCTLR=%016lx M=%lu C=%lu I=%lu EL=%lu\n",
+	       r[2], r[2]&1, (r[2]>>2)&1, (r[2]>>12)&1, r[6]>>2);
+	printk(KERN_NOTICE, "[probe] TCR=%016lx MAIR=%016lx\n", r[0], r[1]);
+	printk(KERN_NOTICE, "[probe] TTBR0=%016lx TTBR1=%016lx SP=%016lx\n",
+	       r[4], r[3], r[5]);
