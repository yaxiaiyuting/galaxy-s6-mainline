diff --git a/include/main/pstore-ring.h b/include/main/pstore-ring.h
new file mode 100644
index 0000000..7e9c7c1
--- /dev/null
+++ b/include/main/pstore-ring.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef DSH_PSTORE_RING_H
+#define DSH_PSTORE_RING_H
+
+/* Linux 6.6 persistent_ram_buffer: little-endian sig/start/size, then data.
+ * Use byte accesses: the loader runs with translation disabled. */
+struct dsh_pram_view {
+	const volatile unsigned char *data;
+	unsigned long capacity, start, size;
+};
+
+static inline unsigned long dsh_pram_u32(const volatile unsigned char *p)
+{
+	return (unsigned long)p[0] | (unsigned long)p[1] << 8 |
+		(unsigned long)p[2] << 16 | (unsigned long)p[3] << 24;
+}
+
+static inline int dsh_pram_view(const volatile unsigned char *zone,
+			      unsigned long bytes, struct dsh_pram_view *v)
+{
+	if (bytes < 12 || dsh_pram_u32(zone) != 0x43474244UL)
+		return -1;
+	v->data = zone + 12;
+	v->capacity = bytes - 12;
+	v->start = dsh_pram_u32(zone + 4);
+	v->size = dsh_pram_u32(zone + 8);
+	if (v->size > v->capacity || v->start > v->size)
+		return -2;
+	/* Reject a partially published non-full ring rather than report it. */
+	if (v->size < v->capacity && v->start != v->size)
+		return -3;
+	return 0;
+}
+
+static inline unsigned char dsh_pram_byte(const struct dsh_pram_view *v,
+					unsigned long offset)
+{
+	return v->data[(v->start + v->capacity - v->size + offset) % v->capacity];
+}
+
+#endif
