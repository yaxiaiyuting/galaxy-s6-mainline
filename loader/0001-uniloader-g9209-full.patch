index 0000000..56c8b29
--- /dev/null
+++ b/drivers/usb-console/console.c
@@ -0,0 +1,716 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Polling USB CDC console for SM-G9209; no Linux, interrupts, or dynamic runtime. */
+#include <drivers/usb-console.h>
+#include <lib/debug.h>
+#include <main/boot.h>
+#include <string.h>
+#include "types.h"
+#include "utils.h"
+#include "usb_dwc3.h"
+
+#define USB_BASE 0x15400000UL
+#define PHY_BASE 0x15500000UL
+#define WDT_BASE 0x10020000UL
+#define WDT_WTCON (WDT_BASE + 0x00)
+#define WDT_WTDAT (WDT_BASE + 0x04)
+#define WDT_WTCNT (WDT_BASE + 0x08)
+#define WDT_WTCLRINT (WDT_BASE + 0x0c)
+#define WDT_ENABLE BIT(5)
+#define WDT_RESET_ENABLE BIT(0)
+#define WDT_CONTROL (0xff00 | (3 << 3) | WDT_ENABLE | WDT_RESET_ENABLE)
+#define PMU_WDT_AUTO_DISABLE 0x105c0408UL
+#define PMU_WDT_RESET_MASK 0x105c040cUL
+#define PMU_WDT_ATLAS BIT(23)
+#define PMU_WDT_APOLLO BIT(24)
+#define PMU_SWRESET 0x105c0400UL
+#define PMU_INFORM2 0x105c0808UL
+#define PMU_INFORM3 0x105c080cUL
+#define REBOOT_MODE_PREFIX 0x12345670U
+#define REBOOT_MODE_RECOVERY 4U
+#define HEAP_SIZE (2 * 1024 * 1024)
+static unsigned char heap[HEAP_SIZE] __attribute__((aligned(16384)));
+static size_t heap_used;
+static dwc3_dev_t *device;
+static int polling, ready_before, boot_requested;
+static unsigned int probe_requested;
+static unsigned long log_sent;
+static char command[1024];
+static unsigned int command_len;
+static int watchdog_owned;
+static unsigned int reconnect_attempts;
+static u32 last_setup_count;
+static unsigned long usb_progress_counter;
+static int muic_checked;
+/*
+ * DSH: PSCI CPU_ON 冒烟测试用的安全桩。
+ * 汇编已用 aarch64-linux-gnu-as + objdump 验证：
+ *   mov  x0, #0x46df0000   (d2a8dbe0)
+ *   movk x0, #0xf800       (f29f0000)   -> x0 = 0x46dff800
+ *   mov  w1, #0x5a5a       (528b4b41)
+ *   movk w1, #0x5a5a,lsl16 (72ab4b41)   -> w1 = 0x5a5a5a5a
+ *   str  w1, [x0]          (b9000001)
+ *   dsb  sy                (d5033f9f)
+ *   wfe                    (d503205f)
+ *   b    -4                (17ffffff)
+ * 从核执行到就写 marker 0x5a5a5a5a 到 0x46dff800，然后自旋。
+ * 0x46dff000 在 ramoops 区（0x46d80000+0x80000）内，DT 已 reserved。
+ */
+static const unsigned int psci_smoke_stub[8] = {
+    0xd2a8dbe0, 0xf29f0000, 0x528b4b41, 0x72ab4b41,
+    0xb9000001, 0xd5033f9f, 0xd503205f, 0x17ffffff,
+};
+#define PSCI_STUB_ENTRY   0x46dff000UL
+#define PSCI_MARKER_ADDR  0x46dff800UL
+#define PSCI_MARKER_VAL   0x5a5a5a5aU
+
+static void psci_install_stub(unsigned long entry)
+{
+    int i;
+    for (i = 0; i < 8; i++) write32(entry + (unsigned long)i * 4, psci_smoke_stub[i]);
+    write32(PSCI_MARKER_ADDR, 0);
+}
+
+static void set_reboot_mode(unsigned int mode);
+static int usb_console_reconnect(void);
+extern char dsh_log[];
+extern unsigned long dsh_log_len;
+
+void *usb_memalign(size_t align, size_t size)
+{
+    size_t offset = (heap_used + align - 1) & ~(align - 1);
+    if (!align || (align & (align - 1)) || offset > HEAP_SIZE || size > HEAP_SIZE - offset)
+        return NULL;
+    heap_used = offset + size;
+    return heap + offset;
+}
+
+void *usb_calloc(size_t n, size_t size)
+{
+    if (size && n > HEAP_SIZE / size) return NULL;
+    void *p = usb_memalign(64, n * size);
+    if (p) memset(p, 0, n * size);
+    return p;
+}
+
+/* Single USB instance with a boot-lifetime arena; free is intentionally a no-op. */
+void usb_free(void *p) { (void)p; }
+
+void usb_dma_sync(void)
+{
+    unsigned long begin = (unsigned long)heap;
+    unsigned long end = begin + heap_used;
+    for (unsigned long p = begin; p < end; p += 64)
+        asm volatile("dc civac, %0" :: "r"(p) : "memory");
+    asm volatile("dsb sy" ::: "memory");
+}
+
+void usb_console_flush_dma(void)
+{
+    usb_dma_sync();
+}
+
+static inline unsigned long usb_cntpct(void)
+{
+    unsigned long v;
+    asm volatile("isb; mrs %0, cntpct_el0" : "=r"(v) :: "memory");
+    return v;
+}
+
+/*
+ * DSH: 用 CNTPCT 做精确延时。
+ *
+ * 原实现是"每微秒 256 个 nop"的忙等，实际时长完全不可标定（MMU 关闭时
+ * 每次迭代都是慢速 Device 访问，实测偏差可能上百倍 —— 注释里自己都写
+ * 了 usb_udelay(3000) 可能是 0.27~0.73 秒）。
+ *
+ * 本机 CNTFRQ_EL0 为 0（S-Boot 从不编程），但实测 CNTPCT 确实在递增，
+ * 按 Exynos7420 的 24 MHz 系统计数器换算：1 us = 24 ticks。
+ * 万一计数器不递增（理论上不该发生），用最大迭代数兜底，绝不无限等。
+ */
+void usb_udelay(unsigned int us)
+{
+    unsigned long start = usb_cntpct();
+    unsigned long ticks = (unsigned long)us * 24UL;
+    unsigned long guard = 0;
+
+    if (!ticks)
+        ticks = 1;
+    while ((usb_cntpct() - start) < ticks) {
+        if (++guard > (unsigned long)us * 200000UL + 1000000UL)
+            break;          /* 计数器疑似冻结，别把机器等死 */
+    }
+}
+
+/* Exynos7420 WDT_APL: Samsung's working clock table uses PERIS PCLK bit 7.
+ * Its ARM64 pmu.c type1 clears ATLAS|APOLLO in AUTOMATIC_DISABLE_WDT and
+ * APOLLO in MASK_WDT_RESET_REQUEST. The legacy ARM32 bit0 scheme is wrong.
+ * Keep the inherited PERIS parent clock; no PLL or shared mux changes. */
+static int watchdog_arm_ticks(unsigned int ticks)
+{
+    set32(0x10040900UL, BIT(7));
+    write32(WDT_WTCON, 0);
+    write32(WDT_WTCLRINT, 1);
+    clear32(PMU_WDT_AUTO_DISABLE, PMU_WDT_ATLAS | PMU_WDT_APOLLO);
+    clear32(PMU_WDT_RESET_MASK, PMU_WDT_APOLLO);
+    write32(WDT_WTDAT, ticks);
+    write32(WDT_WTCNT, ticks);
+    write32(WDT_WTCON, WDT_CONTROL);
+    watchdog_owned = 1;
+
+    /* A readback alone cannot establish that its parent clock is running. */
+    unsigned int first = read32(WDT_WTCNT);
+    usb_udelay(1000);
+    unsigned int second = read32(WDT_WTCNT);
+    if (!(read32(WDT_WTCON) & WDT_ENABLE) || second >= first) {
+        write32(WDT_WTCON, 0);
+        watchdog_owned = 0;
+        printk(KERN_ERR, "[wdt] failed to observe countdown: %u -> %u\n",
+               first, second);
+        return 0;
+    }
+    unsigned int automatic = read32(PMU_WDT_AUTO_DISABLE);
+    unsigned int request_mask = read32(PMU_WDT_RESET_MASK);
+    printk(KERN_NOTICE, "[wdt] count=%u -> %u WTCON=%08x PMU=%08x/%08x\n",
+           first, second, read32(WDT_WTCON), automatic, request_mask);
+    if ((automatic & (PMU_WDT_ATLAS | PMU_WDT_APOLLO)) ||
+        (request_mask & PMU_WDT_APOLLO)) {
+        write32(WDT_WTCON, 0);
+        watchdog_owned = 0;
+        printk(KERN_ERR, "[wdt] countdown observed but PMU reset route remains masked; no reset guard\n");
+        return 0;
+    }
+    printk(KERN_NOTICE, "[wdt] countdown and PMU reset unmask verified; reset expiry still requires hardware test\n");
+    return 1;
+}
+
+/* Call only after copying/cleaning the payload, immediately before entry.
+ * Maximum count expires in ~32.5 s at 66 MHz or ~89.5 s at 24 MHz.
+ * Stop it immediately on probe return, before recopying the payload. */
+int usb_console_watchdog_arm(void)
+{
+    set_reboot_mode(0);
+    return watchdog_arm_ticks(0xffff);
+}
+
+int usb_console_watchdog_stop(void)
+{
+    /* Firmware may hand over a running watchdog independently of our BSS
+     * ownership flag. Enable its register clock and verify the actual stop. */
+    set32(0x10040900UL, BIT(7));
+    unsigned int before = read32(WDT_WTCON);
+    write32(WDT_WTCON, 0);
+    write32(WDT_WTCLRINT, 1);
+    asm volatile("dsb sy" ::: "memory");
+    unsigned int after = read32(WDT_WTCON);
+    if (!after) watchdog_owned = 0;
+    printk(after ? KERN_ERR : KERN_NOTICE,
+           "[wdt] stop WTCON=%08x -> %08x WTCNT=%08x gate=%08x; %s\n",
+           before, after, read32(WDT_WTCNT), read32(0x10040900UL),
+           after ? "FAILED" : "verified");
+    return after == 0;
+}
+
+static unsigned long psci_call4(unsigned long function, unsigned long a1,
+                                 unsigned long a2, unsigned long a3)
+{
+    register unsigned long x0 asm("x0") = function;
+    register unsigned long x1 asm("x1") = a1;
+    register unsigned long x2 asm("x2") = a2;
+    register unsigned long x3 asm("x3") = a3;
+    asm volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+                 : : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11",
+                     "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+    return x0;
+}
+
+static unsigned long psci_call(unsigned long function)
+{
+    /* Initialize the fixed argument registers immediately before SMC.
+     * In particular, printk and DMA cleaning must not occur in between. */
+    register unsigned long x0 asm("x0") = function;
+    register unsigned long x1 asm("x1") = 0;
+    register unsigned long x2 asm("x2") = 0;
+    register unsigned long x3 asm("x3") = 0;
+    asm volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+                 : : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11",
+                     "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+    return x0;
+}
+
+static void set_reboot_mode(unsigned int mode)
+{
+    /* Same bootloader contract as Samsung sec_reboot.c: keep out of charging
+     * mode and select normal BOOT or RECOVERY for either reset mechanism. */
+    write32(PMU_INFORM2, 0x12345678U);
+    write32(PMU_INFORM3, REBOOT_MODE_PREFIX | mode);
+}
+
+static void request_reboot(unsigned int mode)
+{
+    set_reboot_mode(mode);
+    printk(KERN_NOTICE, "[usb] reboot requested (%s); PMU SWRESET with watchdog fallback\n",
+           mode == REBOOT_MODE_RECOVERY ? "recovery" : "normal");
+    watchdog_arm_ticks(4096);
+    usb_console_flush_dma();
+    /* Working Exynos7420 ARM64 exynos_restart(): PMU_SWRESET = 1. */
+    write32(PMU_SWRESET, 1);
+    printk(KERN_ERR, "[usb] PMU SWRESET returned; waiting for watchdog fallback\n");
+}
+
+/*
+ * DSH: PHYCLKRST (0x15500010) 的位定义以 mainline phy-exynos5-usbdrd.c 为准：
+ *   BIT(0)  = COMMONONN   公共块（HS bias + MPLL）使能
+ *   BIT(1)  = PORTRESET   端口/PCS 复位
+ *   BIT(4)  = RETENABLEN  数字电源保持
+ *   BIT(19) = REF_SSP_EN  SS PLL 参考使能（启动 MPLL 的边沿位）
+ *   BIT(20) = SSC_EN      扩频使能
+ * 注意：这里没有 "PHYRESET" 或 "PHY_ENABLE" 位，早期注释是错的。
+ */
+#define DSH_PHYCLKRST_OFF      (BIT(4) | (2u << 2) | (5u << 5) | (0x68u << 11))
+
+static void exynos7420_usb_phy_init(void)
+{
+    /*
+     * DSH: 顺序非常重要 —— 时钟必须在任何 PHY 寄存器访问之前打开，
+     * 否则写入可能被静默丢弃（PHY 的 APB 时钟是 ACLK_USBDRD300）。
+     */
+    /* ① TOP1 父时钟 */
+    set32(0x105e080cUL, BIT(28));
+    set32(0x105e0a24UL, BIT(28));
+    set32(0x10e90200UL, BIT(24));
+    set32(0x10e90204UL, BIT(28));
+    /* ② FSYS0 门控（含 7420 额外的 LINKH AHB） */
+    set32(0x10e90800UL, BIT(19) | BIT(29));
+    set32(0x10e90804UL, BIT(29));            /* ACLK_USBDRD300 = PHY APB */
+    set32(0x10e90a04UL, BIT(4) | BIT(8));    /* SUSPENDCLK + REFCLK(24M) */
+    set32(0x10e90a08UL, BIT(24) | BIT(28));
+    set32(0x10e90a10UL, BIT(28));
+    /* ③ 解除 PMU 对 PHY 的隔离 */
+    set32(0x105c0704UL, BIT(0));
+    usb_udelay(2000);
+
+    /* Quiesce the link while PHY clocks are still running. Keep the pullup
+     * absent long enough for the host to finish the previous connection. */
+    u32 inherited_dctl = read32(USB_BASE + 0xc704);
+    u32 inherited_dsts = read32(USB_BASE + 0xc70c);
+    clear32(USB_BASE + 0xc704, BIT(31) | BIT(19));
+    int halt_timeout = poll32(USB_BASE + 0xc70c, BIT(22), BIT(22), 10000);
+    printk(halt_timeout ? KERN_WARNING : KERN_NOTICE,
+           "[usb] detach before PHY reset: old=%08x/%08x halt=%s dwell=200ms\n",
+           inherited_dctl, inherited_dsts, halt_timeout ? "timeout" : "acknowledged");
+    usb_udelay(200000);
+
+    {
+        u32 pre = read32(PHY_BASE + 0x10);
+        u32 pre_utmi = read32(PHY_BASE + 0x08);
+        u32 pre_test = read32(PHY_BASE + 0x28);
+        printk(KERN_NOTICE,
+               "[usb] PHY before power-cycle: PHYCLKRST=%08x PHYUTMI=%08x PHYTEST=%08x\n",
+               pre, pre_utmi, pre_test);
+
+        /*
+         * ④ 强制 PHY 掉电 —— 等价于 mainline 的 phy_exit()。
+         *
+         * 这是整个修复的核心：热启动时 COMMONONN/REF_SSP_EN/SSC_EN 本来就是 1，
+         * 单纯读-改-写回同值不会产生任何模拟动作，MPLL/SSC/HS-bias 不会重新
+         * 校准，于是 USB 表现为"能枚举但所有请求失败"。
+         * 必须先清零这三位（真正放电），再在后面重新置 1 形成上电边沿。
+         */
+        set32 (PHY_BASE + 0x28,
+               BIT(3) | BIT(2));                       /* PHYTEST: POWERDOWN_SSP|HSP */
+        write32(PHY_BASE + 0x08, 0x43);                /* PHYUTMI: OTGDISABLE|FORCESUSPEND|FORCESLEEP */
+        mask32(PHY_BASE + 0x10,
+               BIT(0) | BIT(19) | BIT(20),             /* COMMONONN | REF_SSP_EN | SSC_EN */
+               BIT(1));                                /* 同时保持 PORTRESET */
+        usb_udelay(5000);                               /* 让 bias/PLL 真正放电 */
+
+        /* ⑤ 参考时钟拉掉再恢复：确保 MPLL 看到时钟边沿 */
+        clear32(0x10e90a04UL, BIT(8));
+        usb_udelay(2000);
+        set32  (0x10e90a04UL, BIT(8));
+        usb_udelay(2000);
+    }
+
+
+    /* Exynos7420 USB3 CAL USB2/UTMI initialization, 24 MHz reference.
+     * See Samsung phy-samsung-usb3-cal.c in the working 3.10 source. */
+    clear32(PHY_BASE + 0x28, BIT(2) | BIT(3));
+    usb_udelay(500);
+    clear32(PHY_BASE + 0x08, 0x7f);
+    set32(PHY_BASE + 0x0c, BIT(4));
+    clear32(PHY_BASE + 0x1c, BIT(31));
+    set32(PHY_BASE + 0x04, BIT(27) | (0x20 << 1));
+    u32 clk = read32(PHY_BASE + 0x10);
+    clk &= ~((0x3f << 5) | (0x7f << 11) | (0xffu << 23) | (3u << 21) |
+             BIT(18) | BIT(31) | (3u << 2));
+    clk |= BIT(0) | BIT(1) | BIT(4) | BIT(19) | BIT(20) |
+           (2u << 2) | (5u << 5) | (0x68u << 11) | (0x88u << 23);
+    write32(PHY_BASE + 0x10, clk);
+    usb_udelay(100);
+    clear32(PHY_BASE + 0x10, BIT(1));
+    usb_udelay(1000);
+    /* Switch the user muxes to the now-running PHY clocks (60/125 MHz),
+     * rather than inheriting a possible 24 MHz oscillator selection. */
+    set32(0x10e90208UL, BIT(24) | BIT(28));
+    usb_udelay(100);
+}
+
+static void execute_command(void)
+{
+    command[command_len] = 0;
+    if (!strcmp(command, "boot") || !strcmp(command, "testboot")) {
+        printk(KERN_NOTICE, "[usb] %s requested; stopping USB DMA before kernel entry\n", command);
+        probe_requested = 0;
+        boot_requested = !strcmp(command, "testboot") ? 2 : 1;
+    } else if (!strncmp(command, "probe ", 6) &&
+               ((command_len == 7 && command[6] >= '1' && command[6] <= '9') ||
+                (command_len == 8 && command[6] >= '1' && command[6] <= '6' &&
+                 command[7] >= '0' && command[7] <= '9') ||
+                (command_len == 8 && command[6] == '3' && command[7] == '1'))) {
+        probe_requested = command_len == 7 ? command[6] - '0'
+                                           : 10 * (command[6] - '0') + (command[7] - '0');
+        if (probe_requested < 1 || probe_requested > 69)
+            probe_requested = 0;
+        boot_requested = 0;
+        printk(KERN_NOTICE, "[usb] probe %u requested; USB stays owned by loader\n",
+               probe_requested);
+    } else if (!strcmp(command, "reboot")) {
+        request_reboot(0);
+    } else if (!strcmp(command, "reboot recovery")) {
+        request_reboot(REBOOT_MODE_RECOVERY);
+    } else if (!strcmp(command, "usb reconnect")) {
+        printk(KERN_NOTICE, "[usb] explicit reconnect requested\n");
+        usb_console_reconnect();
+    } else if (!strcmp(command, "psci version") || !strcmp(command, "psci reset")) {
+        unsigned long function = !strcmp(command, "psci version") ?
+                                 0x84000000UL : 0x84000009UL;
+        set_reboot_mode(0);
+        printk(KERN_NOTICE, "[usb] explicit PSCI call %08lx; arming watchdog first\n",
+               function);
+        /* Never enter an unverified firmware call without an observed timer. */
+        if (watchdog_arm_ticks(4096)) {
+            usb_console_flush_dma();
+            unsigned long result = psci_call(function);
+            usb_console_watchdog_stop();
+            printk(KERN_NOTICE, "[usb] PSCI %08lx returned %016lx\n", function, result);
+        } else {
+            printk(KERN_ERR, "[usb] PSCI skipped: watchdog protection unavailable\n");
+        }
+
+    } else if (!strncmp(command, "psci cpuon ", 11)) {
+        /* DSH: PSCI CPU_ON 冒烟测试。
+         * 用法： psci cpuon <mpidr> [entry]
+         *   mpidr: 0x0=A57 core0, 0x101=A53 core0, 0x100=A57? 按需
+         *   entry: 缺省 0x46dff000（会自动装入安全桩并清 marker）
+         * 目的：直接验证 EL3 是否接受 CPU_ON，绕开整个内核路径。
+         * 挂死说明 EL3/secure monitor 层面拒绝，需从 secure 世界想办法；
+         * 正常返回说明 PSCI 协议可用，问题在内核路径。
+         */
+        unsigned long mpidr = 0x101, entry = PSCI_STUB_ENTRY;
+        char *p = command + 11;
+        mpidr = 0; while (*p == ' ') p++;
+        { int base = 0; if (p[0]=='0' && (p[1]=='x'||p[1]=='X')) { base = 16; p += 2; }
+          while (base == 16 ? ( (*p>='0'&&*p<='9')||(*p>='a'&&*p<='f')||(*p>='A'&&*p<='F') )
+                            : (*p>='0'&&*p<='9')) {
+              int d = (*p<='9') ? *p-'0' : ((*p|32)-'a'+10);
+              mpidr = mpidr*(base?16:10) + d; p++;
+          } }
+        while (*p == ' ') p++;
+        if (*p) { int base = 0; if (p[0]=='0' && (p[1]=='x'||p[1]=='X')) { base = 16; p += 2; }
+          entry = 0;
+          while (base == 16 ? ( (*p>='0'&&*p<='9')||(*p>='a'&&*p<='f')||(*p>='A'&&*p<='F') )
+                            : (*p>='0'&&*p<='9')) {
+              int d = (*p<='9') ? *p-'0' : ((*p|32)-'a'+10);
+              entry = entry*(base?16:10) + d; p++;
+          } }
+        printk(KERN_NOTICE, "[psci] CPU_ON(0xC4000003) mpidr=%016lx entry=%016lx; arming watchdog\n",
+               mpidr, entry);
+        if (watchdog_arm_ticks(0xffff)) {
+            /* 缺省 entry 时自动装入安全桩，省掉 8 条手工 mwr */
+            if (entry == PSCI_STUB_ENTRY) psci_install_stub(entry);
+            usb_console_flush_dma();
+            unsigned long r = psci_call4(0xC4000003UL, mpidr, entry, 0);
+            usb_console_watchdog_stop();
+            printk(KERN_NOTICE,
+                   "[psci] CPU_ON returned %016lx (%ld) marker@46dff800=%08x\n",
+                   r, (long)r, read32(PSCI_MARKER_ADDR));
+        } else {
+            printk(KERN_ERR, "[psci] skipped: no watchdog\n");
+        }
+    } else if (!strcmp(command, "watchdog arm")) {
+        usb_console_watchdog_arm();
+    } else if (!strcmp(command, "watchdog test") ||
+               !strcmp(command, "watchdog test recovery")) {
+        set_reboot_mode(!strcmp(command, "watchdog test recovery") ?
+                        REBOOT_MODE_RECOVERY : 0);
+        printk(KERN_NOTICE, "[wdt] reset test requested; short countdown\n");
+        watchdog_arm_ticks(4096);
+    } else if (!strcmp(command, "watchdog off")) {
+        usb_console_watchdog_stop();
+    } else if (!strcmp(command, "watchdog status")) {
+        set32(0x10040900UL, BIT(7));
+        printk(KERN_NOTICE, "[wdt] WTCON=%08x WTDAT=%08x WTCNT=%08x PMU=%08x/%08x\n",
+               read32(WDT_WTCON), read32(WDT_WTDAT), read32(WDT_WTCNT),
+               read32(0x105c0408UL), read32(0x105c040cUL));
+    } else if (!strcmp(command, "timer status")) {
+        unsigned long frq, c0, c1, ctl, cval;
+        asm volatile("mrs %0, cntfrq_el0" : "=r"(frq));
+        asm volatile("isb; mrs %0, cntpct_el0" : "=r"(c0) :: "memory");
+        usb_udelay(1000);
+        asm volatile("isb; mrs %0, cntpct_el0" : "=r"(c1) :: "memory");
+        asm volatile("mrs %0, cntp_ctl_el0" : "=r"(ctl));
+        asm volatile("mrs %0, cntp_cval_el0" : "=r"(cval));
+        printk(KERN_NOTICE, "[timer] CNTFRQ=%lu CNTPCT=%lu->%lu delta=%lu CTL=%lx CVAL=%lx (read-only)\n",
+               frq, c0, c1, c1-c0, ctl, cval);
+    } else if (!strcmp(command, "dt reserve el3")) {
+        dsh_reserve_el3();
+    } else if (!strcmp(command, "bat") || !strcmp(command, "battery")) {
+        /* DSH: 读 MAX77843 电量计（只读，安全），用于判断是否欠压。*/
+        extern int usb_read_battery(void);
+        usb_read_battery();
+    } else if (!strcmp(command, "prevlog")) {
+        /* DSH: 按需打印 ramoops 里的上一轮内核日志（默认不打印，
+         * 避免启动时 6KB 输出塞满 USB 缓冲导致控制台死掉）。*/
+        extern void dsh_dump_ramoops(void);
+        dsh_dump_ramoops();
+    } else if (!strcmp(command, "pmsgdump")) {
+        dsh_dump_pmsg();
+    } else if (!strncmp(command, "setcmd ", 7)) {
+        /* DSH: setcmd <text> —— 把命令带进内核的 /proc/cmdline，
+         * 由 initramfs 里的 /init 读取执行（本机没有任何输入设备，
+         * 这是唯一的"交互"通道）。结果经 /dev/kmsg 进 ramoops 回读。*/
+        extern char dsh_user_cmd[1024];
+        size_t n = strlen(command + 7);
+        if (n >= sizeof(dsh_user_cmd))
+            n = sizeof(dsh_user_cmd) - 1;
+        for (size_t i = 0; i < n; i++)
+            ((volatile char *)dsh_user_cmd)[i] = ((const volatile char *)command)[i + 7];
+        dsh_user_cmd[n] = 0;
+        printk(KERN_NOTICE, "[cmd] set bytes=%lu; applied at kernel handoff\n", (unsigned long)n);
+    } else if (!strcmp(command, "setcmd")) {
+        extern char dsh_user_cmd[1024];
+        dsh_user_cmd[0] = 0;
+        printk(KERN_NOTICE, "[cmd] cleared\n");
+    } else if (!strncmp(command, "mrd ", 4) || !strncmp(command, "mwr ", 4)) {
+        /* DSH: 32 位单次 MMIO 读/写。
+         * dump 命令拒绝 <0x40000000 的地址，而且用 64 位读 —— 对 32 位
+         * 寄存器窗口不安全（可能读两个寄存器或触发协议错误）。
+         * 这里单独做，mwr 会先读回旧值再打印新值。*/
+        char *p = command + 4;
+        unsigned long addr = 0, val = 0, got = 0;
+        while (*p == ' ') p++;
+        while (*p) {
+            unsigned long v = 0; int g = 0;
+            if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) p += 2;
+            while (1) {
+                char c = *p; unsigned long d;
+                if (c >= '0' && c <= '9') d = c - '0';
+                else if (c >= 'a' && c <= 'f') d = c - 'a' + 10;
+                else if (c >= 'A' && c <= 'F') d = c - 'A' + 10;
+                else break;
+                v = (v << 4) | d; p++; g = 1;
+            }
+            if (!g) break;
+            if (!got) addr = v; else val = v;
+            got++; while (*p == ' ') p++;
+        }
+        if (!got || (addr & 3)) {
+            printk(KERN_ERR, "[mmio] usage: mrd <hexaddr> | mwr <hexaddr> <hexval>\n");
+        } else if (command[1] == 'r') {
+            printk(KERN_NOTICE, "[mmio] R %08lx = %08x\n", addr,
+                   read32((uintptr_t)addr));
+        } else if (got >= 2) {
+            u32 before = read32((uintptr_t)addr);
+            write32((uintptr_t)addr, (u32)val);
+            printk(KERN_NOTICE, "[mmio] W %08lx %08x -> %08x\n",
+                   addr, before, read32((uintptr_t)addr));
+        } else {
+            printk(KERN_ERR, "[mmio] mwr needs a value\n");
+        }
+    } else if (!strncmp(command, "dump ", 5)) {
+        /* DSH: dump <hex地址> <hex长度> —— 直接读物理内存并打印十六进制。
+         * loader 是裸机程序，不受 /dev/mem 限制，这是唯一能在设备上
+         * 读取 ramoops / 诊断结构等物理内存区域的办法。*/
+        unsigned long addr = 0, len = 0;
+        char *p = command + 5;
+        while (*p == ' ') p++;
+        while (*p) {
+            unsigned long v = 0; int got = 0;
+            if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) p += 2;
+            while (1) {
+                char c = *p; unsigned long d;
+                if (c >= '0' && c <= '9') d = c - '0';
+                else if (c >= 'a' && c <= 'f') d = c - 'a' + 10;
+                else if (c >= 'A' && c <= 'F') d = c - 'A' + 10;
+                else break;
+                v = (v << 4) | d; p++; got = 1;
+            }
+            if (!got) break;
+            if (!addr) { addr = v; while (*p == ' ') p++; }
+            else { len = v; break; }
+        }
+        if (!addr) {
+            printk(KERN_ERR, "[dump] usage: dump <hexaddr> <hexlen>\n");
+        } else {
+            if (!len) len = 256;
+            if (len > 4096) len = 4096;
+            /* MMU 关闭时对 Device 内存做非对齐访问会触发对齐异常，
+             * 因此强制 8 字节对齐（否则直接拒绝）。*/
+            if (addr & 7) {
+                printk(KERN_ERR, "[dump] address %08lx is not 8-byte aligned\n", addr);
+            } else if ((addr < 0x40000000UL) || (addr + len > 0x100000000UL)) {
+                printk(KERN_ERR, "[dump] address %08lx + %lu out of RAM range\n", addr, len);
+            } else {
+                printk(KERN_NOTICE, "[dump] PA=%08lx len=%lu\n", addr, len);
+                for (unsigned long off = 0; off < len; off += 16) {
+                    unsigned long v0 = *(volatile unsigned long *)(addr + off);
+                    unsigned long v1 = *(volatile unsigned long *)(addr + off + 8);
+                    printk(KERN_NOTICE, "[dump] %08lx: %016lx %016lx\n", addr + off, v0, v1);
+                }
+            }
+        }
+    } else if (!strcmp(command, "dt unreserve el3")) {
+        dsh_unreserve_el3();
+    } else if (!strcmp(command, "log")) {
+        log_sent = 0;
+    } else if (!strcmp(command, "status")) {
+        printk(KERN_NOTICE, "[usb] log=%lu sent=%lu heap=%lu; loader active; kernel is not running\n",
+               dsh_log_len, log_sent, heap_used);
+        {
+            extern char dsh_user_cmd[1024];
+            printk(KERN_NOTICE, "[usb] cmd='%s'\n", dsh_user_cmd);
+        }
+        printk(KERN_NOTICE, "[usb] GCTL=%08x DCTL=%08x DSTS=%08x events=%08x\n",
+               read32(USB_BASE+0xc110),read32(USB_BASE+0xc704),
+               read32(USB_BASE+0xc70c),read32(USB_BASE+0xc40c));
+    } else if (command_len) {
+        printk(KERN_NOTICE, "[usb] commands: status | log | probe 1..69 | boot | reboot [recovery] | watchdog arm/off/status/test | psci version/reset | prevlog | setcmd <text> | dump <addr> <len> | mrd <addr> | mwr <addr> <val>\n");
+    }
+    command_len = 0;
+}
+
+void usb_console_start(void)
+{
+    printk(KERN_NOTICE, "[usb] initializing standalone Exynos7420 DWC3 CDC console\n");
+    polling = 1;
+    if (!muic_checked) {
+        extern int usb_muic_prepare(void);
+        muic_checked = 1;
+        /* An inaccessible GPIO bus must return to TWRP, rather than leave
+         * the phone in an infinite early-MMIO hang without a USB channel. */
+        set_reboot_mode(REBOOT_MODE_RECOVERY);
+        if (watchdog_arm_ticks(4096)) usb_muic_prepare();
+        usb_console_watchdog_stop();
+        set_reboot_mode(0);
+    }
+    exynos7420_usb_phy_init();
+    printk(KERN_NOTICE, "[usb] GSNPSID=%08x PHYCLKRST=%08x\n",
+           read32(USB_BASE+0xc120),read32(PHY_BASE+0x10));
+    device = usb_dwc3_init(USB_BASE);
+    last_setup_count = 0;
+    usb_progress_counter = usb_cntpct();
+    polling = 0;
+    printk(device ? KERN_NOTICE : KERN_ERR,
+           device ? "[usb] device running; connect to G9209-UNILOADER ttyACM\n" :
+                    "[usb] initialization failed; retained framebuffer/RAM log\n");
+    /* DSH: 关键寄存器自检 —— 热启动失败时靠这行判断是 PHY 还是控制器的问题。
+     *   PHYCLKRST BIT(0)=COMMONONN BIT(1)=PORTRESET BIT(19)=REF_SSP_EN
+     *   期望：PHYCLKRST=441b40b8, PHYUTMI=00, PHYTEST=bit3/2=0, PMU=bit0=1 */
+    printk(KERN_NOTICE, "[usb] selftest PHYCLKRST=%08x PHYUTMI=%08x PHYTEST=%08x "
+           "PMU105c0704=%08x REFGATE=%08x MUX=%08x GCTL=%08x DCTL=%08x DSTS=%08x "
+           "DCFG=%08x PHYCFG=%08x\n",
+           read32(PHY_BASE + 0x10), read32(PHY_BASE + 0x08),
+           read32(PHY_BASE + 0x28), read32(0x105c0704UL),
+           read32(0x10e90a04UL), read32(0x10e90208UL),
+           read32(USB_BASE + 0xc110), read32(USB_BASE + 0xc704),
+           read32(USB_BASE + 0xc70c), read32(USB_BASE + 0xc700),
+           read32(USB_BASE + 0xc200));
+}
+
+static int usb_console_reconnect(void)
+{
+    polling = 1;
+    if (device) usb_dwc3_shutdown(device);
+    device = NULL;
+    /* usb_free is a no-op: reclaim the arena only after hardware reset has
+     * stopped every DMA owner. A failed halt must keep the old storage. */
+    if (!(read32(USB_BASE + 0xc70c) & BIT(22)) ||
+        (read32(USB_BASE + 0xc704) & (BIT(31) | BIT(30)))) {
+        printk(KERN_ERR, "[usb] reconnect refused: controller not safely halted; arena retained\n");
+        polling = 0;
+        return 0;
+    }
+    asm volatile("dsb sy" ::: "memory");
+    heap_used = 0;
+    ready_before = 0;
+    log_sent = 0;
+    command_len = 0;
+    usb_console_start();
+    return device != NULL;
+}
+
+void usb_console_poll(void)
+{
+    if (!device || polling) return;
+    polling = 1;
+    usb_dwc3_handle_events(device);
+    int ready = usb_dwc3_can_write(device, CDC_ACM_PIPE_0);
+    if (ready && !ready_before) { log_sent = 0; command_len = 0; }
+    ready_before = ready;
+    if (ready && log_sent < dsh_log_len) {
+        unsigned long n = dsh_log_len - log_sent;
+        if (n > 512) n = 512;
+        log_sent += usb_dwc3_write(device, CDC_ACM_PIPE_0, dsh_log+log_sent, n);
+    }
+    /* Only read bytes already received; never wait inside a printk call. */
+    unsigned int budget = 64;
+    while (budget-- && usb_dwc3_can_read(device, CDC_ACM_PIPE_0) > 0) {
+        unsigned char c = usb_dwc3_getbyte(device, CDC_ACM_PIPE_0);
+        if (c == '\n' || c == '\r') execute_command();
+        else if (c >= 32 && c < 127 && command_len + 1 < sizeof(command))
+            command[command_len++] = c;
+    }
+    if (device && !usb_dwc3_is_configured(device) && !boot_requested && !probe_requested) {
+        u32 setups = usb_dwc3_setup_count(device);
+        unsigned long now = usb_cntpct();
+        if (setups != last_setup_count) {
+            last_setup_count = setups;
+            usb_progress_counter = now;
+        } else if (reconnect_attempts < 3 && now - usb_progress_counter >= 5UL * 24000000UL) {
+            reconnect_attempts++;
+            printk(KERN_WARNING,
+                   "[usb] enumeration idle: retry=%u setup=%u DCTL=%08x DSTS=%08x UTMI=%08x\n",
+                   reconnect_attempts, setups, read32(USB_BASE + 0xc704),
+                   read32(USB_BASE + 0xc70c), read32(PHY_BASE + 0x08));
+            usb_console_reconnect();
+            return;
+        }
+    }
+    polling = 0;
+}
+
+unsigned int usb_console_wait(void)
+{
+    printk(KERN_NOTICE, "[usb] DCTL=%08x DSTS=%08x PHYCFG=%08x events=%08x\n",
+           read32(USB_BASE+0xc704), read32(USB_BASE+0xc70c),
+           read32(USB_BASE+0xc200), read32(USB_BASE+0xc40c));
+    printk(KERN_NOTICE, "[usb] kernel copied; waiting in loader. Send 'probe 1..69' or 'boot'.\n");
+    /* Deliberately stay here until the host has collected diagnostics. */
+    while (!boot_requested && !probe_requested) usb_console_poll();
+    /* Bounded drain: a disconnected or stalled host cannot block kernel entry. */
+    for (unsigned int i = 0; i < 20000; ++i) usb_console_poll();
+    unsigned int request = probe_requested;
+    if (boot_requested == 2) request = 0x10000;
+    probe_requested = 0;
+    boot_requested = 0;
+    return request;
+}
+
+void usb_console_stop(void)
+{
+    polling = 1;
+    if (device) usb_dwc3_shutdown(device);
+    device = NULL;
+    polling = 0;
+    printk(KERN_NOTICE, "[usb] controller stopped\n");
+}
