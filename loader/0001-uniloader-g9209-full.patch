+	 * r[20]=引导程序给的 DT 物理地址 r[21]=映射后虚拟地址(0=失败) r[22]=size */
+	printk(KERN_NOTICE, "[probe] DT phys=%016lx virt=%016lx size=%08lx\n",
+	       r[20], r[21], r[22]);
+	printk(KERN_NOTICE, "[probe] pgalloc PA=%016lx count=%lu phase=%lu\n",
+	       r[16], r[17], r[18]);
+	/* A normal boot must never reuse the diagnostic callback. */
+	r[15] = 0;
+	r[12] = 0;
+	printk(KERN_NOTICE, "[probe] loader context restored; USB commands available\n");
+}
+
+static void dsh_previous_boot(void)
+{
+	volatile unsigned long *r = (volatile unsigned long *)DSH_REGS_PHYS;
+	unsigned long marker = *(volatile unsigned long *)DSH_MARKER_PHYS;
+
+	printk(KERN_WARNING, "[prev] marker@%08lx=%016lx (may be stale)\n",
+	       (unsigned long)DSH_MARKER_PHYS, marker);
+
+	/* DSH: 无条件打印全部 dsh_regs，便于在任何挂死情形下定位。
+	 * 内核早期的最小异常处理器会把现场写进 [8..11]：
+	 *   r[8]=ESR  r[9]=FAR  r[10]=ELR  r[11]=handler_step
+	 * 之前只在 marker==0x2800 时才打印，别的挂死形态就看不到现场。*/
+	printk(KERN_WARNING, "[prev] r[00..07]=%016lx %016lx %016lx %016lx %016lx %016lx %016lx %016lx\n",
+	       r[0], r[1], r[2], r[3], r[4], r[5], r[6], r[7]);
+	printk(KERN_WARNING, "[prev] r[08..15]=%016lx %016lx %016lx %016lx %016lx %016lx %016lx %016lx\n",
+	       r[8], r[9], r[10], r[11], r[12], r[13], r[14], r[15]);
+	printk(KERN_WARNING, "[prev] r[16..23]=%016lx %016lx %016lx %016lx %016lx %016lx %016lx %016lx\n",
+	       r[16], r[17], r[18], r[19], r[20], r[21], r[22], r[23]);
+
+	if (marker == 0x2800)
+		printk(KERN_WARNING, "[prev] >>> ?: step=%lu ESR=%016lx FAR=%016lx ELR=%016lx\n",
+		       r[11], r[8], r[9], r[10]);
+	if (r[11] >= 1 && r[11] <= 5 && r[8] != 0xdead)
+		printk(KERN_WARNING, "[prev] >>> ?: step=%lu ESR=%016lx FAR=%016lx ELR=%016lx\n",
+		       r[11], r[8], r[9], r[10]);
+}
+
+void boot_kernel(void *dt, void *kernel, void *ramdisk)
+{
+	/* DSH: 不再自动打印 ramoops —— 6KB 输出会塞满 USB 发送缓冲
+	 * 导致 loader 控制台死掉。改为按需：send "prevlog"。*/
+	dsh_previous_boot();
+	dsh_previous_record();
 #ifdef CONFIG_LIBFDT
 	patch_dtb(&dt);
 #endif
-
+	probe_fdt = dt;
+	dsh_pstore_init(dt);
 	printk(KERN_INFO, "Booting kernel...\n");
 	arch_load_kernel(kernel, dt, ramdisk);
 }
diff --git a/main/diag.c b/main/diag.c
new file mode 100644
index 0000000..a353f3f
--- /dev/null
+++ b/main/diag.c
@@ -0,0 +1,332 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * 诊断与自动修复模块 —— 为 SM-G9209 (zeroflte) 主线移植调试加入
+ *
+ * 目的：在没有串口线的情况下，把内核拿到的关键硬件状态打到屏幕上，
+ *       并把已知会导致内核在极早期挂死的 DT 缺陷当场补上。
+ *
+ * 背景：该机型 S-Boot 不会为内核配置 ARM 通用定时器寄存器（CNTFRQ_EL0），
+ *       而 mainline 的 arch timer 驱动在缺少
+ *         - clock-frequency
+ *         - arm,cpu-registers-not-fw-configured
+ *       两个属性时，会去读 CNTFRQ；若该寄存器为 0，内核在 time_init 阶段
+ *       即挂死 —— 现象为：跳转后完全无输出。
+ */
+
+#include <lib/debug.h>
+#include <main/boot.h>
+#include <lib/libfdt/libfdt.h>
+#include <drivers/usb-console.h>
+
+#define TIMER_FREQ_HZ	24000000UL	/* 0x16e3600，与原厂 DT 一致 */
+
+struct arm64_image_header {
+	uint32_t code0;
+	uint32_t code1;
+	uint64_t text_offset;
+	uint64_t image_size;
+	uint64_t flags;
+	uint64_t res2, res3, res4;
+	uint32_t magic;
+	uint32_t res5;
+};
+
+/*
+ * 跳转前把可能残留在 D-cache 里的脏数据写回内存并失效。
+ * arm64 引导协议要求内核入口时 cache 处于干净/关闭状态；uniLoader
+ * 做过的 memcpy（内核镜像、initramfs）如果不写回，内核读到的可能是旧数据。
+ */
+static void dcache_clean_inval(unsigned long start, unsigned long end)
+{
+	unsigned long p;
+	for (p = start & ~63UL; p < end; p += 64)
+		asm volatile("dc civac, %0" :: "r"(p) : "memory");
+	asm volatile("dsb sy" ::: "memory");
+	asm volatile("isb" ::: "memory");
+}
+
+/* Run after all DT changes and after stopping USB DMA, immediately before
+ * kernel entry. The old diagnostic-time flush happened before fdt_setprop. */
+/* DSH: 由 setcmd 命令设置，会被拼进 bootargs 供内核侧 /init 读取。*/
+char dsh_user_cmd[1024] = {0};
+
+int dsh_apply_user_command(void *dt)
+{
+	/* DSH-SMP-BISECT (2026-10-18): maxcpus=1 -> 2 so that smp_init()
+	 * actually issues the first PSCI CPU_ON. Restore to maxcpus=1 when the
+	 * bisect is finished: this file is the only place that takes effect
+	 * (/chosen/bootargs from the board DTS is overwritten here). */
+	static const char args[] =
+		/* DSH 2026-10-20: 降噪提速。
+		 * 原来是 loglevel=8 + systemd.log_level=debug + show_status=1，
+		 * 每个 systemd 消息都要写 115200 baud 的 USB 串口 + journal，
+		 * 实测把启动拖慢到 90 秒还在 udev，GNOME 迟迟出不来。
+		 * 改成 loglevel=4 + systemd.log_level=warning，串口只留警告以上。 */
+		"console=tty0 console=ttyGS0 loglevel=4 nohz=off panic=10 clocksource=arch_sys_counter rcu_cpu_stall_suppress=1 rcupdate.rcu_cpu_stall_suppress=1 systemd.log_level=warning systemd.log_target=kmsg systemd.log_color=0 systemd.show_status=0 "
+		"clk_ignore_unused pd_ignore_unused deferred_probe_timeout=0 "
+		"rodata=off keep_bootcon mitigations=off nokaslr kpti=off";
+	int node = fdt_path_offset(dt, "/chosen");
+	int ret;
+	if (node < 0) return node;
+	ret = fdt_setprop(dt, node, "bootargs", args, sizeof(args));
+	if (ret) return ret;
+	/* A DT string preserves shell spaces/quotes without turning them into
+	 * kernel parameters or init argv. Apply after the USB command, at boot. */
+	if (dsh_user_cmd[0])
+		ret = fdt_setprop(dt, node, "g9209,command", dsh_user_cmd,
+				 strlen(dsh_user_cmd) + 1);
+	else {
+		ret = fdt_delprop(dt, node, "g9209,command");
+		if (ret == -FDT_ERR_NOTFOUND) ret = 0;
+	}
+	printk(ret ? KERN_ERR : KERN_NOTICE,
+	       "[cmd] applied bytes=%lu in /chosen/g9209,command result=%d\n",
+	       (unsigned long)strlen(dsh_user_cmd), ret);
+	return ret;
+}
+
+void arch_prepare_kernel(void *dt)
+{
+	extern char _reloc_start[], _reloc_end[];
+	/* Preserve inherited PERIS parents and enable register access for
+	 * MCT (bit 5) and WDT_APL (bit 7); do not reprogram a shared PLL. */
+	{
+		volatile unsigned int *gate = (volatile unsigned int *)0x10040900UL;
+		unsigned int before = *gate;
+		*gate = before | (1u << 5) | (1u << 7);
+		__asm__ __volatile__("dsb sy" ::: "memory");
+		printk(KERN_NOTICE, "[handoff] PERIS gate 0x10040900: %08x -> %08x (MCT|WDT)\n",
+		       before, *gate);
+	}
+	/* CNTFRQ is metadata, not a counter enable. It is writable only at the
+	 * highest implemented EL (EL3 here), so never write it from this EL1
+	 * loader. Linux gets the known 24 MHz rate from the FDT instead. */
+	{
+		unsigned long frq, c0, c1;
+		asm volatile("mrs %0, cntfrq_el0" : "=r"(frq));
+		asm volatile("isb; mrs %0, cntpct_el0" : "=r"(c0) :: "memory");
+		for (volatile unsigned int i = 0; i < 100000; i++)
+			asm volatile("nop" ::: "memory");
+		asm volatile("isb; mrs %0, cntpct_el0" : "=r"(c1) :: "memory");
+		printk(KERN_NOTICE, "[handoff] CNTFRQ=%lu (read-only); CNTPCT %lu -> %lu delta=%lu\n",
+		       frq, c0, c1, c1 - c0);
+	}
+	printk(KERN_NOTICE, "[handoff] clean kernel payload\n");
+	dcache_clean_inval(CONFIG_PAYLOAD_ENTRY,
+		CONFIG_PAYLOAD_ENTRY + (unsigned long)&kernel_size);
+#ifndef CONFIG_RAMDISK_NO_COPY
+	printk(KERN_NOTICE, "[handoff] clean ramdisk\n");
+	dcache_clean_inval(CONFIG_RAMDISK_ENTRY,
+		CONFIG_RAMDISK_ENTRY + (unsigned long)&ramdisk_size);
+#endif
+	printk(KERN_NOTICE, "[handoff] clean FDT\n");
+	dcache_clean_inval((unsigned long)dt,
+		(unsigned long)dt + fdt_totalsize(dt));
+	printk(KERN_NOTICE, "[handoff] clean loader region\n");
+	dcache_clean_inval((unsigned long)_reloc_start, (unsigned long)_reloc_end);
+	asm volatile("ic iallu; dsb sy; isb" ::: "memory");
+	printk(KERN_NOTICE, "[handoff] cache preparation complete\n");
+}
+
+/* Probe entry enforces EL1 M=0, so CPU data accesses are uncached. Publish
+ * and invalidate the USB arena first; no dirty cached CPU alias may race
+ * with DMA when the common preparation cleans the full loader range. */
+void arch_prepare_probe(void *dt)
+{
+	dcache_clean_inval(CONFIG_PAYLOAD_ENTRY,
+		CONFIG_PAYLOAD_ENTRY + ((volatile unsigned long *)CONFIG_PAYLOAD_ENTRY)[2]);
+	usb_console_flush_dma();
+	arch_prepare_kernel(dt);
+}
+
+extern unsigned long kernel_size;
+extern unsigned long ramdisk_size;
+
+void arch_diag(void *dt)
+{
+	printk(KERN_INFO, "[cache] clean+inval ? %lu ? / initramfs %lu ?\n",
+	       (unsigned long)&kernel_size, (unsigned long)&ramdisk_size);
+	dcache_clean_inval(CONFIG_PAYLOAD_ENTRY,
+			   CONFIG_PAYLOAD_ENTRY + (unsigned long)&kernel_size);
+#ifndef CONFIG_RAMDISK_NO_COPY
+	dcache_clean_inval(CONFIG_RAMDISK_ENTRY,
+			   CONFIG_RAMDISK_ENTRY + (unsigned long)&ramdisk_size);
+#endif
+	dcache_clean_inval(0x47000000UL, 0x48000000UL);	/* uniLoader 自身/栈 */
+#ifdef CONFIG_FRAMEBUFFER_BASE
+	dcache_clean_inval(CONFIG_FRAMEBUFFER_BASE, CONFIG_FRAMEBUFFER_BASE + 0x1000000);
+#endif
+	printk(KERN_INFO, "[cache] ?\n");
+
+
+	unsigned long el, cntfrq, midr, mpidr, sctlr;
+	struct arm64_image_header *h;
+	const void *p;
+	uint32_t v;
+	int off, ret;
+
+	/* ---------- CPU / 定时器状态 ---------- */
+	asm volatile("mrs %0, CurrentEL" : "=r"(el));
+	el = (el >> 2) & 3;
+	asm volatile("mrs %0, CNTFRQ_EL0" : "=r"(cntfrq));
+	asm volatile("mrs %0, MIDR_EL1" : "=r"(midr));
+	asm volatile("mrs %0, MPIDR_EL1" : "=r"(mpidr));
+
+	printk(KERN_INFO, "[diag] EL%lu CNTFRQ=%luHz MIDR=%08lx MPIDR=%08lx\n",
+	       el, cntfrq, midr, mpidr);
+
+	if (el >= 2) {
+		asm volatile("mrs %0, SCTLR_EL2" : "=r"(sctlr));
+		printk(KERN_INFO, "[diag] SCTLR_EL2=%08lx MMU=%lu\n", sctlr, sctlr & 1);
+		if (!cntfrq && el == 3) {
+			asm volatile("msr CNTFRQ_EL0, %0" :: "r"((unsigned long)TIMER_FREQ_HZ));
+			asm volatile("mrs %0, CNTFRQ_EL0" : "=r"(cntfrq));
+			printk(KERN_WARNING, "[fix] CNTFRQ=0 ? %lu -> ? %lu\n",
+			       (unsigned long)TIMER_FREQ_HZ, cntfrq);
+		}
+	} else {
+		asm volatile("mrs %0, SCTLR_EL1" : "=r"(sctlr));
+		printk(KERN_INFO, "[diag] SCTLR_EL1=%08lx MMU=%lu\n", sctlr, sctlr & 1);
+		if (!cntfrq)
+			printk(KERN_ERR, "[warn] CNTFRQ=0 ? EL1? DT ?\n");
+	}
+
+	/* ---------- 内核镜像头（确认 payload 正确）---------- */
+	h = (struct arm64_image_header *)CONFIG_PAYLOAD_ENTRY;
+	printk(KERN_INFO, "[diag] kimg code0=%08x code1=%08x magic=%08x\n",
+	       h->code0, h->code1, h->magic);
+	printk(KERN_INFO, "[diag] kimg text_off=%08x%08x img_size=%08x%08x flags=%08x%08x\n",
+	       (unsigned)(h->text_offset >> 32), (unsigned)h->text_offset,
+	       (unsigned)(h->image_size >> 32), (unsigned)h->image_size,
+	       (unsigned)(h->flags >> 32), (unsigned)h->flags);
+	{
+		unsigned op0 = h->code0 >> 26, op1 = h->code1 >> 26;
+		if (op0 == 0x05 || op1 == 0x05)
+			printk(KERN_INFO, "[diag] ? OK (B ? @%s)\n",
+			       op0 == 0x05 ? "code0" : "code1");
+		else
+			printk(KERN_ERR, "[diag] ? FAIL (? EFI/PE ?)\n");
+	}
+
+	/* ---------- DT: /timer 检查与修补 ---------- */
+	off = fdt_path_offset(dt, "/timer");
+	printk(KERN_INFO, "[diag] /timer off=%d\n", off);
+	if (off >= 0) {
+		p = fdt_getprop(dt, off, "clock-frequency", NULL);
+		if (p) {
+			printk(KERN_INFO, "[diag] clock-frequency=%u\n", fdt32_to_cpu(*(const uint32_t *)p));
+		} else {
+			v = cpu_to_fdt32((uint32_t)TIMER_FREQ_HZ);
+			ret = fdt_setprop(dt, off, "clock-frequency", &v, 4);
+			printk(KERN_WARNING, "[fix] ? clock-frequency=%lu ret=%d\n",
+			       (unsigned long)TIMER_FREQ_HZ, ret);
+		}
+		if (!fdt_getprop(dt, off, "arm,cpu-registers-not-fw-configured", NULL)) {
+			ret = fdt_setprop(dt, off, "arm,cpu-registers-not-fw-configured", NULL, 0);
+			printk(KERN_WARNING, "[fix] ? cpu-registers-not-fw-configured ret=%d\n", ret);
+		} else {
+			printk(KERN_INFO, "[diag] not-fw-configured ?\n");
+		}
+	}
+
+	/* ---------- DT: model / memory ---------- */
+	p = fdt_getprop(dt, fdt_path_offset(dt, "/"), "model", NULL);
+	if (p)
+		printk(KERN_INFO, "[diag] model=%s\n", (const char *)p);
+	off = fdt_path_offset(dt, "/memory@40000000");
+	if (off < 0)
+		off = fdt_path_offset(dt, "/memory");
+	if (off >= 0) {
+		p = fdt_getprop(dt, off, "reg", NULL);
+		if (p) {
+			const uint32_t *r = (const uint32_t *)p;
+			printk(KERN_INFO, "[diag] mem base=%08x%08x size=%08x%08x\n",
+			       fdt32_to_cpu(r[0]), fdt32_to_cpu(r[1]),
+			       fdt32_to_cpu(r[2]), fdt32_to_cpu(r[3]));
+		}
+	}
+
+	/* ---------- DSH: 拷贝后校验 —— 内核镜像是否真的进了 0x90000000 ---------- */
+	{
+		volatile unsigned long *pl = (volatile unsigned long *)0x90000000UL;
+		unsigned long c0 = pl[0] & 0xffffffffUL;
+
+		printk(KERN_WARNING, "[chk] ? payload[0]=%016lx payload[1]=%016lx\n", pl[0], pl[1]);
+		if (c0 == 0xd503201fUL)
+			printk(KERN_WARNING, "[chk] >>> OK ? 0x90000000?NOP+b ?\n");
+		else
+			printk(KERN_ERR, "[chk] >>> FAIL 0x90000000 ?\n");
+	}
+
+	/* ---------- 读 ID 寄存器：确认 TGran4 字段（内核据此判断能否开 MMU）---------- */
+	{
+		unsigned long mmfr0, pfr0;
+		printk(KERN_INFO, "[id] reading ID_AA64MMFR0_EL1 ...\n");
+		asm volatile("mrs %0, ID_AA64MMFR0_EL1" : "=r"(mmfr0));
+		printk(KERN_INFO, "[id] ID_AA64MMFR0 = %016lx\n", mmfr0);
+		printk(KERN_INFO, "[id]   PARange=%lu  TGran4=%lu  TGran16=%lu  TGran64=%lu\n",
+		       mmfr0 & 0xf, (mmfr0 >> 28) & 0xf, (mmfr0 >> 20) & 0xf, (mmfr0 >> 24) & 0xf);
+		if (((mmfr0 >> 28) & 0xf) > 1)
+			printk(KERN_ERR, "[id]   >>> TGran4 ? 0/1 -> ? __enable_mmu ?\n");
+		printk(KERN_INFO, "[id] reading ID_AA64PFR0_EL1 ...\n");
+		asm volatile("mrs %0, ID_AA64PFR0_EL1" : "=r"(pfr0));
+		printk(KERN_INFO, "[id] ID_AA64PFR0 = %016lx (EL0=%lu EL1=%lu EL2=%lu EL3=%lu)\n",
+		       pfr0, pfr0 & 0xf, (pfr0 >> 4) & 0xf, (pfr0 >> 8) & 0xf, (pfr0 >> 12) & 0xf);
+	}
+
+
+	/* ---------- DSH: 直接读硬件真实 MMU 寄存器（内核还没跑，这是 S-Boot 留下的真值）---------- */
+	{
+		unsigned long tcr, ttbr0, ttbr1, sctlr, mair, vbar;
+
+		printk(KERN_WARNING, "[real] ?...\n");
+		asm volatile("mrs %0, tcr_el1"   : "=r"(tcr));
+		asm volatile("mrs %0, ttbr0_el1" : "=r"(ttbr0));
+		asm volatile("mrs %0, ttbr1_el1" : "=r"(ttbr1));
+		asm volatile("mrs %0, sctlr_el1" : "=r"(sctlr));
+		asm volatile("mrs %0, mair_el1"  : "=r"(mair));
+		asm volatile("mrs %0, vbar_el1"  : "=r"(vbar));
+		printk(KERN_WARNING, "[real] TCR_EL1  =%016lx\n", tcr);
+		printk(KERN_WARNING, "[real]   T0SZ=%lu T1SZ=%lu EPD0=%lu EPD1=%lu IPS=%lu\n",
+		       tcr & 0x3f, (tcr >> 16) & 0x3f, (tcr >> 22) & 1, (tcr >> 23) & 1, (tcr >> 32) & 7);
+		printk(KERN_INFO, "[real] inherited state with M=%lu; kernel will program its own TCR/TTBR\n",
+		       sctlr & 1);
+		printk(KERN_WARNING, "[real] TTBR0=%016lx TTBR1=%016lx\n", ttbr0, ttbr1);
+		printk(KERN_WARNING, "[real] SCTLR=%016lx MAIR=%016lx VBAR=%016lx\n", sctlr, mair, vbar);
+	}
+
+	/* ---------- /chosen: 打印并强制写入我们自己的 cmdline ---------- */
+	off = fdt_path_offset(dt, "/chosen");
+	printk(KERN_INFO, "[diag] /chosen off=%d\n", off);
+	if (off >= 0) {
+		p = fdt_getprop(dt, off, "bootargs", NULL);
+		if (p)
+			printk(KERN_WARNING, "[diag] ? bootargs: %s\n", (const char *)p);
+		else
+			printk(KERN_WARNING, "[diag] ? bootargs ?\n");
+
+		dsh_apply_user_command(dt);
+
+		/* 检查 simple-framebuffer 是否在 chosen 下（决定能否有屏幕输出）*/
+		p = fdt_getprop(dt, off, "linux,initrd-start", NULL);
+		if (p)
+			printk(KERN_INFO, "[diag] initrd-start=%08x%08x\n",
+			       fdt32_to_cpu(((const uint32_t *)p)[0]),
+			       fdt32_to_cpu(((const uint32_t *)p)[1]));
+		{
+			int c = fdt_first_subnode(dt, off);
+			while (c >= 0) {
+				printk(KERN_INFO, "[diag] chosen ?: %s\n", fdt_get_name(dt, c, NULL));
+				c = fdt_next_subnode(dt, c);
+			}
+			if (c == -FDT_ERR_NOTFOUND)
+				printk(KERN_INFO, "[diag] (chosen ?)\n");
+		}
+	}
+
+	/* CMU 探针已完成使命（定位到 cmu_top0 @0x105d0000），移除以免挂死 */
+
+	/* This board advertises the legacy PSCI 0.1 interface. Do not issue an
+	 * optional VERSION SMC before USB recovery and a reset guard exist. */
+	printk(KERN_INFO, "[diag] optional PSCI_VERSION deferred until USB console\n");
+}
diff --git a/main/main.c b/main/main.c
index 579def3..8a1e2c6 100644
--- a/main/main.c
+++ b/main/main.c
@@ -9,6 +9,7 @@
 #include <main/boot.h>
 #include <main/main.h>
 #include <lib/debug.h>
+#include <drivers/usb-console.h>
 
 extern struct board_data board_ops;
 
diff --git a/main/pstore.c b/main/pstore.c
new file mode 100644
index 0000000..bdcfd70
--- /dev/null
+++ b/main/pstore.c
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <main/boot.h>
+#include <main/pstore-ring.h>
+#include <lib/debug.h>
+#include <lib/libfdt/libfdt.h>
+
+static const void *pstore_fdt;
+
+void dsh_pstore_init(const void *dt)
+{
+	pstore_fdt = dt;
+}
+
+static unsigned long property(int node, const char *name)
+{
+	int len;
+	const fdt32_t *p = fdt_getprop(pstore_fdt, node, name, &len);
+	return p && len == 4 ? fdt32_to_cpu(*p) : 0;
+}
+
+static unsigned long power2(unsigned long n)
+{
+	unsigned long r = 0;
+	while (n) { r = r ? r << 1 : 1; n >>= 1; }
+	return r;
+}
+
+/* Match fs/pstore/ram.c allocation order: dmesg, console, pmsg, ftrace.
+ * ECC is deliberately rejected because it reduces each ring's data area. */
+static int zone(int pmsg, unsigned long *address, unsigned long *bytes)
+{
+	unsigned long base, total, record, console, message, trace, dump, used = 0;
+	const fdt32_t *reg;
+	int node, len;
+	if (!pstore_fdt || fdt_check_header(pstore_fdt)) return -1;
+	node = fdt_node_offset_by_compatible(pstore_fdt, -1, "ramoops");
+	if (node < 0 || property(node, "ecc-size")) return -1;
+	reg = fdt_getprop(pstore_fdt, node, "reg", &len);
+	if (!reg || len != 16 || fdt32_to_cpu(reg[0]) || fdt32_to_cpu(reg[2])) return -1;
+	base = fdt32_to_cpu(reg[1]); total = fdt32_to_cpu(reg[3]);
+	if (base < 0x40000000UL || !total || total > 0x100000UL ||
+	    base > 0x100000000UL - total) return -1;
+	record = power2(property(node, "record-size"));
+	console = power2(property(node, "console-size"));
+	message = power2(property(node, "pmsg-size"));
+	trace = power2(property(node, "ftrace-size"));
+	if (console + message + trace > total) return -1;
+	dump = total - console - message - trace;
+	if (record && dump) {
+		unsigned long count = dump / record;
+		if (!count) return -1;
+		used = (dump / count) * count;
+	}
+	*address = base + used + (pmsg ? console : 0);
+	*bytes = pmsg ? message : console;
+	return *bytes >= 12 ? 0 : -1;
+}
+
+static void dump_zone(int pmsg)
+{
+	unsigned long address, bytes, off, begin;
+	struct dsh_pram_view v;
+	char line[177];
+	unsigned int n = 0;
+	const char *tag = pmsg ? "pmsg" : "prevlog";
+	if (zone(pmsg, &address, &bytes)) {
+		printk(KERN_ERR, "[%s] unsupported or missing ramoops layout\n", tag);
+		return;
+	}
+	int result = dsh_pram_view((const volatile unsigned char *)address, bytes, &v);
+	printk(KERN_NOTICE, "[%s] zone=%08lx bytes=%lu validation=%d\n", tag, address, bytes, result);
+	if (result) {
+		printk(KERN_NOTICE, "[%s] no valid retained ring\n", tag);
+		return;
+	}
+	begin = v.size > 16384 ? v.size - 16384 : 0;
+	printk(KERN_NOTICE, "[%s] start=%lu size=%lu capacity=%lu offset=%lu\n",
+	       tag, v.start, v.size, v.capacity, begin);
+	/* Print chronological tail only, bounded below the loader transcript's
+	 * 128 KiB limit; old bytes and another zone are never scanned. */
+	for (off = begin; off < v.size; off++) {
+		unsigned char c = dsh_pram_byte(&v, off);
+		if (c != '\n') {
+			line[n++] = c >= 32 && c < 127 ? c : '.';
+			if (n < sizeof(line) - 1) continue;
+		}
+		line[n] = 0;
+		printk(KERN_NOTICE, "[%s] %s\n", tag, line);
+		n = 0;
+	}
+	if (n) { line[n] = 0; printk(KERN_NOTICE, "[%s] %s\n", tag, line); }
+	printk(KERN_NOTICE, "[%s] === end ===\n", tag);
+}
+
+void dsh_dump_ramoops(void) { dump_zone(0); }
+void dsh_dump_pmsg(void) { dump_zone(1); }
