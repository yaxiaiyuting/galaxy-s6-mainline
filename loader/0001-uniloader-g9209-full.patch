+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef USB_PORT_UTILS_H
+#define USB_PORT_UTILS_H
+#include "types.h"
+#include <lib/debug.h>
+#define min(a,b) ((a)<(b)?(a):(b))
+#define max(a,b) ((a)>(b)?(a):(b))
+#define debug_printf(...) printk(KERN_DEBUG, __VA_ARGS__)
+static inline u32 read32(uintptr_t a) { u32 v=*(volatile u32 *)a; asm volatile("dmb sy" ::: "memory"); return v; }
+static inline void write32(uintptr_t a, u32 v) { asm volatile("dmb sy" ::: "memory"); *(volatile u32 *)a=v; asm volatile("dsb sy" ::: "memory"); }
+static inline void mask32(uintptr_t a,u32 mask,u32 value) {write32(a,(read32(a)&~mask)|value);}
+static inline void set32(uintptr_t a,u32 value) {mask32(a,0,value);}
+static inline void clear32(uintptr_t a,u32 value) {mask32(a,value,0);}
+void usb_udelay(unsigned int us);
+static inline void mdelay(unsigned int ms) {while(ms--) usb_udelay(1000);}
+static inline int poll32(uintptr_t a,u32 mask,u32 value,unsigned int us) {
+    while(us--) {if ((read32(a)&mask)==value) return 0; usb_udelay(1);} return -1;
+}
+#endif
