diff --git a/arch/aarch64/load-kernel.c b/arch/aarch64/load-kernel.c
index 8eee041..7406f52 100644
--- a/arch/aarch64/load-kernel.c
+++ b/arch/aarch64/load-kernel.c
@@ -6,12 +6,155 @@
 
 #include <main/boot.h>
 #include <string.h>
+#include <lib/debug.h>	/* DSH: 拷贝进度打印 */
+#include <drivers/usb-console.h>
+#include <main/dsh-diag.h>
+
+static volatile unsigned long copy_done;
+static volatile unsigned long copy_src;
+static volatile unsigned long copy_dst;
+static volatile unsigned long fault_active;
+
+/* No return: the caller's registers were not saved by the fatal vectors. */
+void dsh_loader_fault(unsigned long esr, unsigned long far,
+		      unsigned long elr, unsigned long el)
+{
+	if (!fault_active) {
+		fault_active = 1;
+		printk(KERN_EMERG, "[LOADER FAULT] EL%lu ESR=%016lx\n", el, esr);
+		printk(KERN_EMERG, "[LOADER FAULT] FAR=%016lx PC=%016lx\n", far, elr);
+		printk(KERN_EMERG, "[LOADER FAULT] src=%08lx dst=%08lx done=%lu\n",
+		       copy_src, copy_dst, copy_done);
+	}
+	for (;;)
+		asm volatile("wfe");
+}
+
+static void copy_checked(void *dst, const void *src, unsigned long size)
+{
+	const unsigned long chunk_size = 2UL * 1024 * 1024;
+	unsigned long done = 0;
+
+	copy_src = (unsigned long)src;
+	copy_dst = (unsigned long)dst;
+	copy_done = 0;
+	/* Bound linker-provided lengths before calculating addresses. */
+	if (!size || size > 29360128UL || copy_src < 0x40000000UL ||
+	    copy_src > 0x100000000UL - size || copy_dst < 0x40000000UL ||
+	    copy_dst > 0x100000000UL - size ||
+	    (copy_dst < copy_src + size && copy_src < copy_dst + size)) {
+		printk(KERN_EMERG, "[copy] invalid range/size: %lu; stopped\n", size);
+		for (;;)
+			asm volatile("wfe");
+	}
+	while (done < size) {
+		unsigned long n = size - done;
+		if (n > chunk_size)
+			n = chunk_size;
+		/*
+		 * DSH: 一律使用逐字节的易失访问来拷贝。
+		 *
+		 * 之前非 8 字节对齐时会走 __optimized_memcpy（汇编版），注释里
+		 * 自己承认"may issue unaligned paired accesses"，而 MMU 关闭时
+		 * 对 Device 内存做非对齐成对访问会触发对齐异常 —— 实测表现为
+		 * 偶发的 [LOADER FAULT] ESR=...（initramfs 大小 3,946,234 字节，
+		 * 末端 2 字节不对齐，最后一块正好命中）。
+		 *
+		 * 总共只拷 ~25 MB，速度不是瓶颈，正确性优先。用 volatile 逐字节
+		 * 循环可以确保编译器不会把它优化回成对访问。
+		 */
+		{
+			volatile unsigned char *d = (volatile unsigned char *)dst + done;
+			const volatile unsigned char *s2 =
+				(const volatile unsigned char *)src + done;
+			unsigned long k;
+			for (k = 0; k < n; k++)
+				d[k] = s2[k];
+		}
+		/* DSH: 同样用逐字节易失比较，避免 memcmp 生成非对齐成对访问。*/
+		{
+			volatile unsigned char *d = (volatile unsigned char *)dst + done;
+			const volatile unsigned char *s2 =
+				(const volatile unsigned char *)src + done;
+			unsigned long k;
+			for (k = 0; k < n; k++) {
+				if (d[k] != s2[k]) {
+					printk(KERN_EMERG,
+					       "[copy] VERIFY FAILED at offset %lu\n",
+					       done + k);
+					for (;;)
+						asm volatile("wfe");
+				}
+			}
+		}
+		done += n;
+		copy_done = done;
+		printk(KERN_WARNING, "[copy] verified %lu/%lu bytes\n", done, size);
+	}
+}
 
 void arch_load_kernel(void* kernel, void* dt, void* ramdisk)
 {
-	memcpy((void*)CONFIG_PAYLOAD_ENTRY, kernel, (unsigned long) &kernel_size);
+	/* Stop the firmware's watchdog before copying or waiting for a host. */
+	if (!usb_console_watchdog_stop()) {
+		printk(KERN_ERR, "[wdt] initial stop failed; kernel entry blocked; use reboot recovery\n");
+		usb_console_start();
+		for (;;) usb_console_poll();
+	}
+	printk(KERN_WARNING, "[copy] kernel: src=%016lx dst=%08x bytes=%lu\n",
+	       (unsigned long)kernel, CONFIG_PAYLOAD_ENTRY, (unsigned long)&kernel_size);
+	copy_checked((void*)CONFIG_PAYLOAD_ENTRY, kernel, (unsigned long) &kernel_size);
+	printk(KERN_WARNING, "[copy] kernel OK dst[0]=%016lx\n",
+	       *(volatile unsigned long *)CONFIG_PAYLOAD_ENTRY);
 #ifndef CONFIG_RAMDISK_NO_COPY
-	__optimized_memcpy((void*)CONFIG_RAMDISK_ENTRY, ramdisk, (unsigned long) &ramdisk_size);
+	printk(KERN_WARNING, "[copy] ramdisk: src=%016lx dst=%08x bytes=%lu\n",
+	       (unsigned long)ramdisk, CONFIG_RAMDISK_ENTRY, (unsigned long)&ramdisk_size);
+	copy_checked((void*)CONFIG_RAMDISK_ENTRY, ramdisk, (unsigned long) &ramdisk_size);
+	printk(KERN_WARNING, "[copy] ramdisk OK\n");
 #endif
+	arch_diag(dt);
+	unsigned long diagnostic_test_mode = 0;
+	/* Replay earlier logs after the long kernel copy/cache flush has finished. */
+	usb_console_start();
+	for (;;) {
+		unsigned int stage = usb_console_wait();
+		if (!stage || stage == 0x10000) {
+			/* Normal boot runs without the diagnostic watchdog deadline. */
+			if (!usb_console_watchdog_stop()) {
+				printk(KERN_ERR, "[wdt] handoff stop failed; kernel entry blocked; USB remains active\n");
+				continue;
+			}
+			if (dsh_apply_user_command(dt)) {
+				printk(KERN_ERR, "[cmd] FDT update failed; USB remains active\n");
+				continue;
+			}
+			diagnostic_test_mode = stage == 0x10000;
+			break;
+		}
+		/* Each probe starts from the original Image, with its NOBITS tail
+		 * cleared too. Reusing mutated page tables would invalidate results. */
+		copy_checked((void *)CONFIG_PAYLOAD_ENTRY, kernel, (unsigned long)&kernel_size);
+		unsigned long image_size = ((volatile unsigned long *)CONFIG_PAYLOAD_ENTRY)[2];
+		unsigned long file_size = (unsigned long)&kernel_size;
+		if (image_size < file_size || image_size > 0x4000000UL) {
+			printk(KERN_ERR, "[probe] invalid Image memory size\n");
+			continue;
+		}
+		memset((void *)(CONFIG_PAYLOAD_ENTRY + file_size), 0, image_size - file_size);
+		if (dsh_arm_probe(stage)) continue;
+		dsh_arm_diag_record(0);
+		arch_prepare_probe(dt);
+		usb_console_watchdog_arm();
+		unsigned long result = arch_probe_kernel(dt, (void *)CONFIG_PAYLOAD_ENTRY);
+		usb_console_watchdog_stop();
+		dsh_report_probe(result);
+		/* Restore the payload before accepting a subsequent normal boot. */
+		copy_checked((void *)CONFIG_PAYLOAD_ENTRY, kernel, file_size);
+		memset((void *)(CONFIG_PAYLOAD_ENTRY + file_size), 0, image_size - file_size);
+	}
+	dsh_arm_diag_record(diagnostic_test_mode);
+	usb_console_stop();
+	arch_prepare_kernel(dt);
+	printk(KERN_NOTICE, "[handoff] jumping to kernel at %08x\n", CONFIG_PAYLOAD_ENTRY);
 	load_kernel_and_jump(dt, 0, 0, 0, (void*)CONFIG_PAYLOAD_ENTRY);
 }
diff --git a/arch/aarch64/probe.S b/arch/aarch64/probe.S
new file mode 100644
index 0000000..d2d693d
--- /dev/null
+++ b/arch/aarch64/probe.S
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* EL1 diagnostic call/return. The kernel exits through an identity-mapped
+ * trampoline with M/C off; no loader C code runs under kernel page tables. */
+.text
+.balign 16
+.global arch_probe_kernel
+.type arch_probe_kernel, %function
+arch_probe_kernel:
+	adrp x9, dsh_probe_context
+	add x9, x9, :lo12:dsh_probe_context
+	stp x19, x20, [x9, #0]
+	stp x21, x22, [x9, #16]
+	stp x23, x24, [x9, #32]
+	stp x25, x26, [x9, #48]
+	stp x27, x28, [x9, #64]
+	stp x29, x30, [x9, #80]
+	mov x10, sp
+	str x10, [x9, #96]
+	mrs x10, daif
+	str x10, [x9, #104]
+	mrs x10, sctlr_el1
+	str x10, [x9, #112]
+	mrs x10, tcr_el1
+	str x10, [x9, #120]
+	mrs x10, mair_el1
+	str x10, [x9, #128]
+	mrs x10, ttbr0_el1
+	str x10, [x9, #136]
+	mrs x10, ttbr1_el1
+	str x10, [x9, #144]
+	mrs x10, vbar_el1
+	str x10, [x9, #152]
+	mrs x10, cpacr_el1
+	str x10, [x9, #160]
+	mrs x10, mdscr_el1
+	str x10, [x9, #168]
+	mrs x10, pmuserenr_el0
+	str x10, [x9, #176]
+	mrs x10, sp_el0
+	str x10, [x9, #184]
+	mrs x10, tpidr_el1
+	str x10, [x9, #192]
+	mrs x10, tpidrro_el0
+	str x10, [x9, #200]
+	mrs x10, tpidr_el0
+	str x10, [x9, #208]
+	msr daifset, #0xf
+	dsb sy
+	mov x16, x1
+	mov x1, xzr
+	mov x2, xzr
+	mov x3, xzr
+	br x16
+.size arch_probe_kernel, .-arch_probe_kernel
+
+.global dsh_probe_return
+.type dsh_probe_return, %function
+dsh_probe_return:
+	msr daifset, #0xf
+	adrp x9, dsh_probe_context
+	add x9, x9, :lo12:dsh_probe_context
+	ldr x10, [x9, #120]
+	msr tcr_el1, x10
+	ldr x10, [x9, #128]
+	msr mair_el1, x10
+	ldr x10, [x9, #136]
+	msr ttbr0_el1, x10
+	ldr x10, [x9, #144]
+	msr ttbr1_el1, x10
+	ldr x10, [x9, #152]
+	msr vbar_el1, x10
+	ldr x10, [x9, #160]
+	msr cpacr_el1, x10
+	ldr x10, [x9, #168]
+	msr mdscr_el1, x10
+	ldr x10, [x9, #176]
+	msr pmuserenr_el0, x10
+	ldr x10, [x9, #184]
+	msr sp_el0, x10
+	ldr x10, [x9, #192]
+	msr tpidr_el1, x10
+	ldr x10, [x9, #200]
+	msr tpidrro_el0, x10
+	ldr x10, [x9, #208]
+	msr tpidr_el0, x10
+	tlbi vmalle1
+	dsb sy
+	isb
+	ldr x10, [x9, #112]
+	msr sctlr_el1, x10
+	isb
+	ldp x19, x20, [x9, #0]
+	ldp x21, x22, [x9, #16]
+	ldp x23, x24, [x9, #32]
+	ldp x25, x26, [x9, #48]
+	ldp x27, x28, [x9, #64]
+	ldp x29, x30, [x9, #80]
+	ldr x10, [x9, #96]
+	mov sp, x10
+	ldr x10, [x9, #104]
+	msr daif, x10
+	ret
+.size dsh_probe_return, .-dsh_probe_return
+
+.bss
+.balign 64
+dsh_probe_context:
+	.skip 256
+.section .note.GNU-stack,"",%progbits
diff --git a/arch/aarch64/start.S b/arch/aarch64/start.S
index de454f9..b8f9a8e 100644
--- a/arch/aarch64/start.S
+++ b/arch/aarch64/start.S
@@ -41,6 +41,21 @@ ENTRY(_start)
 	str     xzr, [x0], #8
 	b       1b
 2:
+	/* Capture loader faults before entering C. All interrupts stay masked. */
+	msr daifset, #0xf
+	adrp x9, dsh_loader_vectors
+	add x9, x9, #:lo12:dsh_loader_vectors
+	mrs x10, CurrentEL
+	cmp x10, #0xc
+	b.eq 3f
+	cmp x10, #0x8
+	b.eq 4f
+	msr vbar_el1, x9
+	b 5f
+3:	msr vbar_el3, x9
+	b 5f
+4:	msr vbar_el2, x9
+5:	isb
 
 	/* Fall through */
 	adrp    x0, dtb             /* Load page of dtb */
@@ -59,3 +74,30 @@ ENTRY(load_kernel_and_jump)
 	br	x4
 END(load_kernel_and_jump)
 
+.balign 2048
+dsh_loader_vectors:
+	.rept 16
+	b dsh_loader_exception
+	.balign 128
+	.endr
+
+dsh_loader_exception:
+	mrs x3, CurrentEL
+	lsr x3, x3, #2
+	cmp x3, #3
+	b.eq 1f
+	cmp x3, #2
+	b.eq 2f
+	mrs x0, esr_el1
+	mrs x1, far_el1
+	mrs x2, elr_el1
+	b dsh_loader_fault
+1:	mrs x0, esr_el3
+	mrs x1, far_el3
+	mrs x2, elr_el3
+	b dsh_loader_fault
+2:	mrs x0, esr_el2
+	mrs x1, far_el2
+	mrs x2, elr_el2
+	b dsh_loader_fault
+
diff --git a/board/samsung/board-zeroflte.c b/board/samsung/board-zeroflte.c
index ac70d4a..66db8bb 100644
--- a/board/samsung/board-zeroflte.c
+++ b/board/samsung/board-zeroflte.c
@@ -16,6 +16,24 @@ int zeroflte_init(void)
 {
 	/* Allow framebuffer to be written to */
 	*(int*) (DECON_F_BASE + HW_SW_TRIG_CONTROL) = 0x2058;
+
+	/*
+	 * DSH: Exynos7420 SMP 修复 —— 第一步（最小改动，只加这一条）。
+	 *
+	 * 背景：本板引导核是 A53（CPU0 mpidr=0x80000100，cluster 1），
+	 * A57 在 cluster 0。内核 smp_init() 第一次 PSCI CPU_ON 的目标就是
+	 * A57/ATLAS —— 这是本次启动中 ATLAS 第一次上电。
+	 * 主线缺少 7420 在 SMP 之前必须做的集群准备，所以第一次 CPU_ON 挂死。
+	 * maxcpus=1 全程不碰 ATLAS，所以能启动。
+	 *
+	 * 原厂内核里唯一在 smp_init() 之前执行的 7420 PMU 动作就是
+	 * early_initcall(exynos7420_atlas_dbg_pmu_init)：PMU 0x105c2440 |= 0x30000
+	 * （ATLAS_DBG wakeup）。这里在 loader 里提前做掉。
+	 *
+	 * 注意：一次只加这一条。如果 8 核能起来，根因就确认了。
+	 */
+	*(volatile unsigned int *)0x105c2440 |= (0x3u << 16);
+
 	return 0;
 }
 
