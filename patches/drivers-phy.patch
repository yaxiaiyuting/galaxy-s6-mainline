+++ b/drivers/phy/samsung/phy-samsung-ufs.c
@@ -150,6 +150,7 @@ static int samsung_ufs_phy_clks_init(struct samsung_ufs_phy *phy)
 
 static int samsung_ufs_phy_init(struct phy *phy)
 {
+	pr_emerg("DSHPHY: phy_init enter\n");
 	struct samsung_ufs_phy *ss_phy = get_samsung_ufs_phy(phy);
 
 	ss_phy->lane_cnt = phy->attrs.bus_width;
@@ -163,16 +164,27 @@ static int samsung_ufs_phy_power_on(struct phy *phy)
 	struct samsung_ufs_phy *ss_phy = get_samsung_ufs_phy(phy);
 	int ret;
 
+	pr_emerg("DSHPHY: power_on: >>> ctrl_isol(false)\n");
 	samsung_ufs_phy_ctrl_isol(ss_phy, false);
+	pr_emerg("DSHPHY: power_on: ctrl_isol done\n");
 
+	pr_emerg("DSHPHY: power_on: >>> clk_bulk_prepare_enable\n");
 	ret = clk_bulk_prepare_enable(ss_phy->drvdata->num_clks, ss_phy->clks);
+	pr_emerg("DSHPHY: power_on: clk_bulk ret=%d\n", ret);
 	if (ret) {
 		dev_err(ss_phy->dev, "failed to enable ufs phy clocks\n");
 		return ret;
 	}
 
+	/*
+	 * DSH 二分测试：临时跳过 calibrate。
+	 * 如果跳过能启动 => samsung_ufs_phy_calibrate 是挂死原因
+	 * 如果照样挂  => clk_bulk_prepare_enable 或 ctrl_isol 是原因
+	 */
 	if (ss_phy->ufs_phy_state == CFG_PRE_INIT) {
+		pr_emerg("DSHPHY: power_on: >>> calibrate\n");
 		ret = samsung_ufs_phy_calibrate(phy);
+		pr_emerg("DSHPHY: power_on: calibrate ret=%d\n", ret);
 		if (ret)
 			dev_err(ss_phy->dev, "ufs phy calibration failed\n");
 	}
