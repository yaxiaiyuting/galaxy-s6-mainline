 {
 	struct device *dev = &pdev->dev;
+	pr_emerg("DSHPHY: phy probe enter\n");
 	const struct of_device_id *match;
 	struct samsung_ufs_phy *phy;
 	struct phy *gen_phy;
@@ -282,7 +295,9 @@ static int samsung_ufs_phy_probe(struct platform_device *pdev)
 
 	phy->lane_cnt = PHY_DEF_LANE_CNT;
 
+	pr_emerg("DSHPHY: before clks_init\n");
 	err = samsung_ufs_phy_clks_init(phy);
+	pr_emerg("DSHPHY: clks_init ret=%d\n", err);
 	if (err) {
 		dev_err(dev, "failed to get phy clocks\n");
