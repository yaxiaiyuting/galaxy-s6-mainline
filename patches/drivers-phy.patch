diff --git a/drivers/phy/samsung/phy-exynos7-ufs.c b/drivers/phy/samsung/phy-exynos7-ufs.c
index a982e7c12..07a884a87 100644
--- a/drivers/phy/samsung/phy-exynos7-ufs.c
+++ b/drivers/phy/samsung/phy-exynos7-ufs.c
@@ -68,6 +68,14 @@ static const struct samsung_ufs_phy_cfg *exynos7_ufs_phy_cfgs[CFG_TAG_MAX] = {
 	[CFG_POST_PWR_HS]	= exynos7_post_pwr_hs_cfg,
 };
 
+/*
+ * DSH 时钟二分测试：7420 上只保留 ref_clk。
+ * 原厂 exynos7 要 4 个时钟，实测挂死在 clk_bulk_prepare_enable，
+ * 而 devm_clk_bulk_get 要求 4 个全在（少一个就 probe 失败），
+ * 所以只能在 drvdata 里减少数量来二分。
+ *   - 如果能启动 => 挂死在那 3 个 symbol clock 的某一个
+ *   - 如果还挂   => 就是 ref_clk 本身
+ */
 static const char * const exynos7_ufs_phy_clks[] = {
 	"tx0_symbol_clk", "rx0_symbol_clk", "rx1_symbol_clk", "ref_clk",
 };
diff --git a/drivers/phy/samsung/phy-samsung-ufs.c b/drivers/phy/samsung/phy-samsung-ufs.c
index 183c88e3d..7774247b4 100644
