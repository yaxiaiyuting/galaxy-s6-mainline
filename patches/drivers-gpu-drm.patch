+/*
+ * DSH 2026-10-20: find the S-Boot framebuffer described under /chosen.
+ * uniLoader injects a "simple-framebuffer" node with reg = base,size.
+ * Mapping this one-to-one in the IOMMU domain is much more robust than
+ * reading VIDW_BUF_START back from the DECON (those registers may be in an
+ * unexpected triple-buffer state).
+ */
+static void dsh_decon_find_boot_fb(struct decon_context *ctx)
+{
+	struct device_node *chosen, *fb;
+	struct resource res;
+
+	ctx->boot_fb.base = 0;
+	ctx->boot_fb.size = 0;
+
+	chosen = of_find_node_by_path("/chosen");
+	if (!chosen)
+		return;
+
+	for_each_child_of_node(chosen, fb) {
+		if (!of_device_is_compatible(fb, "simple-framebuffer"))
+			continue;
+		if (of_address_to_resource(fb, 0, &res))
+			continue;
+		ctx->boot_fb.base = res.start;
+		ctx->boot_fb.size = resource_size(&res);
+		of_node_put(fb);
+		break;
+	}
+	of_node_put(chosen);
+	pr_err(DSH_DISP_TAG " decon: boot_fb base=%pa size=%#zx\n",
+	       &ctx->boot_fb.base, ctx->boot_fb.size);
+}
