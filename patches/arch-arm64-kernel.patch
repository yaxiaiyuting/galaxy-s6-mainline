+/* A probe ends this kernel run. Snapshot the tested state BEFORE repairing
+ * TTBR0, then reinstall the initial identity map from the high mapping.
+ * cpu_uninstall_idmap() must run unchanged; its empty TTBR0 cannot execute
+ * the physical exit trampoline. init_idmap_pg_dir is distinct from the
+ * init_pg_dir freed by paging_init(), and remains live through setup_arch.
+ * Scope: EL1, 4K/39-bit VA, payload PA 0x90000000, before free_initmem(). */
+	/* The permanent kernel mapping marks .idmap.text as NX at its high VA.
+	 * Keep this diagnostic entry executable through TTBR1 after paging_init;
+	 * the initial identity map also covers this ordinary .text address. */
+	.pushsection .text, "ax"
+SYM_CODE_START(dsh_probe_exit)
+	msr	daifset, #0xf
+	adr_l	x9, dsh_regs
+	ldr	x10, [x9, #184]
+	cbnz	x10, .Lprobe_park
+	mov	x10, #1
+	str	x10, [x9, #184]
+	mrs	x10, tcr_el1
+	str	x10, [x9]
+	mrs	x10, mair_el1
+	str	x10, [x9, #8]
+	mrs	x10, sctlr_el1
+	str	x10, [x9, #16]
+	mrs	x10, ttbr1_el1
+	str	x10, [x9, #24]
+	mrs	x10, ttbr0_el1
+	str	x10, [x9, #32]
+	mov	x10, sp
+	str	x10, [x9, #40]
+	mrs	x10, CurrentEL
+	str	x10, [x9, #48]
+	ldr	x17, [x9, #96]
+	/* Low-VA checkpoints still execute through the original identity map.
+	 * Only the high-VA path can safely replace TTBR0 underneath itself. */
+	mrs	x10, sctlr_el1
+	tbz	x10, #0, .Lprobe_jump_phys
+	adr	x10, .
+	tbz	x10, #63, .Lprobe_jump_phys
+	adr_l	x11, _text
+	mov_q	x12, 0x90000000
+	sub	x11, x11, x12		// high-VA to physical offset
+	adr_l	x10, reserved_pg_dir
+	sub	x10, x10, x11
+	dsb	ishst
+	msr	ttbr0_el1, x10
+	isb
+	tlbi	vmalle1
+	dsb	ish
+	isb
+	mrs	x10, tcr_el1
+	bic	x10, x10, #0x3f
+	mov	x12, #(64 - VA_BITS)
+	orr	x10, x10, x12
+	msr	tcr_el1, x10
+	isb
+	adr_l	x10, init_idmap_pg_dir
+	sub	x10, x10, x11
+	msr	ttbr0_el1, x10
+	isb
+.Lprobe_jump_phys:
+	adr_l	x9, dsh_probe_exit_phys
+	adr_l	x10, _text
+	sub	x9, x9, x10
+	mov_q	x10, 0x90000000
+	add	x9, x9, x10
+	br	x9
+SYM_INNER_LABEL(dsh_probe_exit_phys, SYM_L_LOCAL)
+	/* All memory touched so far is inside the loaded kernel (including
+	 * its page tables); make it coherent before returning with M/C off. */
+	adr_l	x10, _text
+	adr_l	x11, _end
+.Lprobe_flush:
+	dc	civac, x10
+	add	x10, x10, #64
+	cmp	x10, x11
+	b.lo	.Lprobe_flush
+	dsb	sy
+	mrs	x10, sctlr_el1
+	bic	x10, x10, #SCTLR_ELx_M
+	bic	x10, x10, #SCTLR_ELx_C
+	msr	sctlr_el1, x10
+	isb
+	ic	iallu
+	dsb	sy
+	isb
+	br	x17
+.Lprobe_park:
+	wfe
+	b	.Lprobe_park
+SYM_CODE_END(dsh_probe_exit)
+	.popsection
+
+/* ===== DSH_MIN: 最小异常向量表 =====
+ * 设计原则：处理程序自身必须绝对可靠，所以每一步都先留痕（写 dsh_regs[11] 计数器），
+ * 这样即使处理程序内部再出问题，也能从内存里看出它走到哪一步。*/
+	.pushsection .text, "ax"
+	.align	11
+dsh_vectors:
+	.rept	16
+	b	dsh_sync_handler
+	.align	7
+	.endr
+
+dsh_sync_handler:
+	/* 步骤 1：写"已进入处理程序"标记（最早、最简单）*/
+	adr_l	x15, dsh_marker
+	mov	x16, #0x2800
+	str	x16, [x15]
+	/* 步骤 2：计数器 = 1 */
+	adr_l	x15, dsh_regs
+	mov	x16, #1
+	str	x16, [x15, #88]
+	/* 步骤 3：ESR */
+	mrs	x16, esr_el1
+	str	x16, [x15, #64]
+	mov	x16, #2
+	str	x16, [x15, #88]
+	/* 步骤 4：FAR */
+	mrs	x16, far_el1
+	str	x16, [x15, #72]
+	mov	x16, #3
+	str	x16, [x15, #88]
+	/* 步骤 5：ELR */
+	mrs	x16, elr_el1
+	str	x16, [x15, #80]
+	mov	x16, #4
+	str	x16, [x15, #88]
+	/* On an armed probe, deliver the actual fault over loader USB. */
+	ldr	x9, [x15, #120]
+	mov_q	x10, 0x44534850524f4245
+	cmp	x9, x10
+	b.ne	.Lprobe_no_fault_return
+	ldr	x9, [x15, #96]
+	cbz	x9, .Lprobe_no_fault_return
+	mov	x0, #0x8000
+	b	dsh_probe_exit
+.Lprobe_no_fault_return:
+	/* A physical framebuffer is not in the temporary identity map.
+	 * Only draw with MMU off, or this handler would recurse on its store. */
+	mrs	x9, sctlr_el1
+	tbnz	x9, #0, 3f
+	mov	x9, #0xe2a0
+	lsl	x9, x9, #16
+	mov	w10, #0xff00
+	movk	w10, #0xff00, lsl #16
+	mov	x11, #46080
+1:	str	w10, [x9], #4
+	str	w10, [x9], #4
+	subs	x11, x11, #1
+	b.ne	1b
+3:
+	mov	x16, #5
+	adr_l	x15, dsh_regs
+	str	x16, [x15, #88]
+	dc	cvac, x15
+	add	x15, x15, #64
+	dc	cvac, x15
+	adr_l	x15, dsh_marker
+	dc	cvac, x15
+	dsb	sy
+2:	wfe
+	wfi
+	b	2b
+	.popsection
