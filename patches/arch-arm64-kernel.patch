@@ -181,16 +181,62 @@ asmlinkage void __init early_fdt_map(u64 dt_phys)
 	early_fdt_ptr = fixmap_remap_fdt(dt_phys, &fdt_size, PAGE_KERNEL);
 }
 
+/*
+ * DSH: 在 C 代码里触发一次探针检查点，等价于 head.S 里的 dsh_probe_checkpoint。
+ * 如果 loader 已武装（dsh_regs[15]==魔数）且目标就是本检查点，就直接跳到
+ * loader 回调；本次内核运行就此结束，下次探针重新拷贝原始 Image。
+ * 未武装时开销极小，直接返回。
+ */
+void dsh_probe_c(unsigned int stage)
+{
+	extern volatile unsigned long dsh_regs[];
+	extern void dsh_probe_exit(unsigned long stage);	/* 内核侧跳板 */
+	unsigned long target;
+
+	if (dsh_regs[15] != 0x44534850524f4245UL)	/* "DSHPROBE" */
+		return;
+	dsh_regs[14] = stage;
+	target = dsh_regs[13];
+	if (stage != target || !dsh_regs[12])
+		return;
+	/*
+	 * 关键：必须交给内核侧的 dsh_probe_exit 跳板，而【不能】直接调 loader 的
+	 * 回调地址。因为此刻 MMU 开着、页表只映射了内核镜像，loader 所在的
+	 * 0x47000000 区域没有映射 —— 直接跳过去会触发取指异常：
+	 *   ESR=0x86000005 (EC=0x21 instruction abort, DFSC=5 translation fault L1)
+	 *   FAR=ELR=loader 回调地址
+	 * dsh_probe_exit 负责关 MMU/缓存并完成物理地址过渡。
+	 */
+	dsh_probe_exit(stage);
+}
