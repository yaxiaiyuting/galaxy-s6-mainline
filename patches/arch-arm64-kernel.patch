+
+	dsh_regs[21] = (unsigned long)dt_virt;	/* 映射后的虚拟地址（0 = 映射失败）*/
+	dsh_regs[22] = (unsigned long)size;
+	dsh_marker = 0x4012;		/* fixmap_remap_fdt 返回 */
+	dsh_probe_c(14);		/* 探针：DT 映射返回 */
 
