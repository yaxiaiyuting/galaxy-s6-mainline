+static const resource_size_t exynos7420_pd_blk_addr[PD_NUM_BLKS] = {
+	[PD_BLK_TOP0] = 0x105d0000,
+	[PD_BLK_DISP] = 0x13ad0000,
+	[PD_BLK_VPP] = 0x13ed0000,
+	[PD_BLK_PMU] = 0x105c0000,
