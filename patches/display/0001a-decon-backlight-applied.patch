+/*
+ * DSH 2026-10-20: find the S-Boot framebuffer described under /chosen.
+ * uniLoader injects a "simple-framebuffer" node with reg = base,size.
+ * Mapping this one-to-one in the IOMMU domain is much more robust than
+ * reading VIDW_BUF_START back from the DECON (those registers may be in an
+ * unexpected triple-buffer state).
+ */
+static void dsh_decon_find_boot_fb(struct decon_context *ctx)
+{
+	struct device_node *chosen, *fb;
+	struct resource res;
+
+	ctx->boot_fb.base = 0;
+	ctx->boot_fb.size = 0;
+
+	chosen = of_find_node_by_path("/chosen");
+	if (!chosen)
+		return;
+
+	for_each_child_of_node(chosen, fb) {
+		if (!of_device_is_compatible(fb, "simple-framebuffer"))
+			continue;
+		if (of_address_to_resource(fb, 0, &res))
+			continue;
+		ctx->boot_fb.base = res.start;
+		ctx->boot_fb.size = resource_size(&res);
+		of_node_put(fb);
+		break;
+	}
+	of_node_put(chosen);
+	pr_err(DSH_DISP_TAG " decon: boot_fb base=%pa size=%#zx\n",
+	       &ctx->boot_fb.base, ctx->boot_fb.size);
+}
+
+/* ---------------- DSH: DSIM DCS 通道（亮度 / 熄屏） ---------------- */
+
+static int dsh_dsim_wait_empty(struct decon_context *ctx, u32 mask, int usec)
+{
+	while (usec-- > 0) {
+		if ((readl(ctx->dsim_regs + DSIM_FIFOCTRL) & mask) == mask)
+			return 0;
+		udelay(1);
+	}
+
+	return -ETIME;
+}
+
+static int dsh_dsim_write_short(struct decon_context *ctx, u8 data_id,
+				u8 p0, u8 p1)
+{
+	u32 val = DSIM_PKTHDR_ID(data_id) | DSIM_PKTHDR_DATA0(p0) |
+		  DSIM_PKTHDR_DATA1(p1);
+	int ret;
+
+	ret = dsh_dsim_wait_empty(ctx, DSIM_SFR_HEADER_EMPTY, 2000);
+	if (ret)
+		return ret;
+
+	writel(val, ctx->dsim_regs + DSIM_PKTHDR);
+
+	/* header FIFO 排空 == 包已经发到 lane 上 */
+	return dsh_dsim_wait_empty(ctx, DSIM_SFR_HEADER_EMPTY, 20000);
+}
+
+static int dsh_dsim_write_long(struct decon_context *ctx, const u8 *buf, int len)
+{
+	int i, ret;
+
+	ret = dsh_dsim_wait_empty(ctx, DSIM_SFR_HEADER_EMPTY |
+					 DSIM_SFR_PAYLOAD_EMPTY, 2000);
+	if (ret)
+		return ret;
+
+	/* payload 先进 PL FIFO，每 32bit 一个 word，尾端补 0 */
+	for (i = 0; i < len; i += 4) {
+		u32 word = 0;
+		int j;
+
+		for (j = 0; j < 4 && i + j < len; j++)
+			word |= (u32)buf[i + j] << (8 * j);
+
+		writel(word, ctx->dsim_regs + DSIM_PAYLOAD);
+	}
+
+	/* 长包 header：ID | WC_LSB | WC_MSB，WC = payload 字节数 */
+	writel(DSIM_PKTHDR_ID(DSH_DSI_DCS_LONG_WRITE) | ((u32)len << 8),
+	       ctx->dsim_regs + DSIM_PKTHDR);
+
+	ret = dsh_dsim_wait_empty(ctx, DSIM_SFR_HEADER_EMPTY, 20000);
+	if (ret)
+		return ret;
+
+	return dsh_dsim_wait_empty(ctx, DSIM_SFR_PAYLOAD_EMPTY, 20000);
+}
+
+static int dsh_dsim_dcs_write(struct decon_context *ctx, const u8 *buf, int len)
+{
+	if (!ctx->dsim_regs)
+		return -ENODEV;
+
+	if (len <= 0)
+		return -EINVAL;
+
+	if (len == 1)
+		return dsh_dsim_write_short(ctx, DSH_DSI_DCS_SHORT_WRITE,
+					    buf[0], 0);
+	if (len == 2)
+		return dsh_dsim_write_short(ctx, DSH_DSI_DCS_SHORT_WRITE_PARAM,
+					    buf[0], buf[1]);
+
+	return dsh_dsim_write_long(ctx, buf, len);
+}
+
+/*
+ * 亮度：先置 0x53(BCTRL)=1 打开 MIPI 亮度控制，再写 0x51(DBV)。
+ * 这是 MIPI 标准路径；vendor 走的是 0xCA gamma 表，两者可以并存，
+ * 但 gamma 路径需要 Smart-Dimming 表 + MTP 读取，留到阶段 2（文档 §6）。
+ */
+static int dsh_dsim_set_level(struct decon_context *ctx, unsigned int level)
+{
+	u8 seq[2];
+	int ret;
+
+	if (!ctx->dsim_regs || !ctx->bl_dev)
+		return 0;
+
+	if (level > ctx->bl_dev->props.max_brightness)
+		level = ctx->bl_dev->props.max_brightness;
+
+	if (!ctx->bctrl) {
+		seq[0] = MIPI_DCS_WRITE_CONTROL_DISPLAY;
+		seq[1] = 0x20;			/* BIT(5) = BCTRL */
+		ret = dsh_dsim_dcs_write(ctx, seq, 2);
+		if (ret) {
+			pr_err(DSH_DISP_TAG " decon: DCS BCTRL failed (%d)\n", ret);
+			return ret;
+		}
+		ctx->bctrl = true;
+	}
+
+	seq[0] = MIPI_DCS_SET_DISPLAY_BRIGHTNESS;
+	seq[1] = (u8)level;
+
+	return dsh_dsim_dcs_write(ctx, seq, 2);
+}
+
+/*
+ * 熄屏 = DCS 0x28(display off)：面板停止发光，这是 -346mA 里最大的那一块。
+ * 刻意不发 0x10(sleep in)：进 sleep 要 0x11 + 完整初始化序列才能回来，
+ * 而 mainline 手里没有 s6e3hf2 的初始化序列（那是 S-Boot 做的）。
+ */
+static int dsh_dsim_display(struct decon_context *ctx, bool on)
+{
+	u8 cmd = on ? MIPI_DCS_SET_DISPLAY_ON : MIPI_DCS_SET_DISPLAY_OFF;
+	int ret;
+
+	if (!ctx->dsim_regs || !ctx->bl_dev)
+		return 0;
+
+	ret = dsh_dsim_dcs_write(ctx, &cmd, 1);
+	if (ret) {
+		pr_err(DSH_DISP_TAG " decon: DCS 0x%02x failed (%d)\n", cmd, ret);
+		return ret;
+	}
+
+	ctx->panel_off = !on;
+	pr_err(DSH_DISP_TAG " decon: panel display %s\n", on ? "ON" : "OFF");
+
+	return 0;
+}
+
+static int dsh_bl_get_brightness(struct backlight_device *bl)
+{
+	return bl->props.brightness;
+}
+
+static int dsh_bl_update_status(struct backlight_device *bl)
+{
+	struct decon_context *ctx = bl_get_data(bl);
+
+	/* DPMS off 期间只记住亮度，绝不把面板点亮 */
+	if (ctx->panel_off)
+		return 0;
+
+	return dsh_dsim_set_level(ctx, bl->props.brightness);
+}
+
+static const struct backlight_ops dsh_bl_ops = {
+	.get_brightness	= dsh_bl_get_brightness,
+	.update_status	= dsh_bl_update_status,
+};
+
+static void dsh_bl_register(struct decon_context *ctx)
+{
+	struct device *dev = ctx->dev;
+	struct backlight_device *bl;
+	struct backlight_properties props;
+	u32 status;
+
+	if (!of_property_read_bool(dev->of_node, "dsh,dsim-backlight"))
+		return;
+	if (!dsh_disp_bl)
+		return;
+
+	ctx->dsim_regs = of_iomap(dev->of_node, 1);
+	if (!ctx->dsim_regs) {
+		dev_warn(dev, "no DSIM reg window, backlight disabled\n");
+		return;
+	}
+
+	/*
+	 * 死活判定：DISP 域没电时 AXI 根本不会应答（直接挂死），能读到全 1
+	 * 说明总线活着但 IP 状态不对 —— 这种情况立刻停手，别往里写包。
+	 */
+	status = readl(ctx->dsim_regs + DSIM_STATUS);
+	if (status == 0xffffffff) {
+		pr_err(DSH_DISP_TAG " decon: DSIM not responding (STATUS=0x%08x), backlight disabled\n",
+		       status);
+		iounmap(ctx->dsim_regs);
+		ctx->dsim_regs = NULL;
+		return;
+	}
+
+	/* 诊断模式：只读状态、不注册、不发包 */
+	if (dsh_disp_bl_dump) {
+		pr_err(DSH_DISP_TAG " decon: DSIM STATUS=%08x FIFOCTRL=%08x (dump only)\n",
+		       status, readl(ctx->dsim_regs + DSIM_FIFOCTRL));
+		iounmap(ctx->dsim_regs);
+		ctx->dsim_regs = NULL;
+		return;
+	}
+
+	props = (struct backlight_properties) {
+		.type		= BACKLIGHT_PLATFORM,
+		.max_brightness	= 255,
+		.brightness	= min_t(unsigned int, dsh_disp_bl_level, 255),
+		.power		= FB_BLANK_UNBLANK,
+	};
+
+	bl = backlight_device_register("s6e3hf2", dev, ctx, &dsh_bl_ops, &props);
+	if (IS_ERR(bl)) {
+		dev_err(dev, "failed to register backlight (%ld)\n", PTR_ERR(bl));
+		iounmap(ctx->dsim_regs);
+		ctx->dsim_regs = NULL;
+		return;
+	}
+
+	ctx->bl_dev = bl;
+
+	pr_err(DSH_DISP_TAG " decon: backlight registered (level=%u, DSIM STATUS=%08x)\n",
+	       bl->props.brightness, status);
+
+	/* 立刻下发一次，确认 DCS 通道是否真的通（看 dmesg 有无失败打印） */
+	dsh_dsim_set_level(ctx, bl->props.brightness);
+}
+
+static void dsh_bl_unregister(struct decon_context *ctx)
+{
+	if (ctx->bl_dev) {
+		backlight_device_unregister(ctx->bl_dev);
+		ctx->bl_dev = NULL;
+	}
+
+	if (ctx->dsim_regs) {
+		iounmap(ctx->dsim_regs);
+		ctx->dsim_regs = NULL;
+	}
+}
