+/*
+ * DSH 2026-10-23: 面板侧亮度 / 熄屏通道 —— 直接往 DSIM 的 SFR FIFO 塞 DCS 包。
+ *
+ * 现状（证据：文档/05-专项/背光控制调研-20261023.md）：
+ *   S-Boot 把 DSIM0(0x13900000) 初始化成 command 模式，DECON 走 i80 把每帧推给
+ *   DSIM，DSIM 再打到 S6E3HF2。mainline 里 **没有任何驱动绑定 DSIM**
+ *   （exynos7.dtsi 没有 dsi 节点，samsung-dsim 从未 probe），所以 PLL / PHY /
+ *   lane / CONFIG 全是 S-Boot 留下的状态。本文件只做一件事：往 SFR FIFO 写
+ *   DCS 短包/长包，其它寄存器一概不碰。
+ *
+ * 为什么不会挂总线：
+ *   - DSIM 的 APB 时钟门控 CLK_PCLK_DSIM0 带 CLK_IGNORE_UNUSED
+ *     (drivers/clk/samsung/clk-exynos7.c:1564)，bootargs 另有 clk_ignore_unused，
+ *     且 DISP 电源域由运行中的 DECON 保持 —— 寄存器访问不会 AXI 无应答。
+ *   - DCS 包走 SFR header/payload FIFO，DECON 的 i80 帧数据走 i80 FIFO
+ *     （FIFOCTRL bit23/21/22/20 vs bit19/17/18/16），两条通路独立。
+ *   - 不写 FIFOCTRL / DSIM_CONFIG / PLL / PHY，S-Boot 的链路配置原样保留。
+ *
+ * 面板侧命令（vendor drivers/video/exynos/decon_7420/panels/s6e3hf2_wqhd_param.h）：
+ *   SEQ_DISPLAY_ON  = { 0x29 } (:138)，SEQ_DISPLAY_OFF = { 0x28 } (:142)
+ *   vendor 用 0xCA gamma 表 + 0xB6 ELVSS + 0xF4 VINT 做亮度（Smart Dimming），
+ *   这里先用 MIPI 标准的 0x53(BCTRL) + 0x51(DBV)；这颗 DDI 是否支持 0x51
+ *   待设备验证，不支持的退化情况 = 只有开/关，见实现方案文档 §6。
+ */
+/* DSIM 寄存器（offset 取自 vendor drivers/video/exynos/decon_7420/regs-dsim.h） */
+#define DSIM_STATUS			0x004
+#define DSIM_PKTHDR			0x03c
+#define DSIM_PAYLOAD			0x040
+#define DSIM_FIFOCTRL			0x04c
+
+#define DSIM_PKTHDR_ID(x)		((x) & 0x3f)
+#define DSIM_PKTHDR_DATA0(x)		(((x) & 0xff) << 8)
+#define DSIM_PKTHDR_DATA1(x)		(((x) & 0xff) << 16)
+
+/* DSIM_FIFOCTRL 状态位（同 samsung-dsim.c:157-168） */
+#define DSIM_SFR_HEADER_EMPTY		BIT(22)
+#define DSIM_SFR_PAYLOAD_EMPTY		BIT(20)
+
+/* MIPI DSI 包数据类型（mipi_display.h 只定义 DCS 命令号） */
+#define DSH_DSI_DCS_SHORT_WRITE		0x05
+#define DSH_DSI_DCS_SHORT_WRITE_PARAM	0x15
+#define DSH_DSI_DCS_LONG_WRITE		0x39
+
+/*
+ * DSH 2026-10-23: DSIM 亮度开关。
+ *   backlight=0  → 完全不碰 DSIM（与打补丁前行为一致，回滚用）
+ *   bl_dump=1    → 只在 probe 读一次 DSIM_STATUS/FIFOCTRL，不注册 backlight、
+ *                  不发任何 DCS 包（上机第一步用这个）
+ *   bl_level     → 初始亮度（0..255）
+ */
+bool dsh_disp_bl = true;
+module_param_named(backlight, dsh_disp_bl, bool, 0644);
+bool dsh_disp_bl_dump;
+module_param_named(bl_dump, dsh_disp_bl_dump, bool, 0644);
+unsigned int dsh_disp_bl_level = 160;
+module_param_named(bl_level, dsh_disp_bl_level, uint, 0644);
 
