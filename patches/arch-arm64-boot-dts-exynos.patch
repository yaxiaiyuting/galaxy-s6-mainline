+++ b/arch/arm64/boot/dts/exynos/exynos7420-zeroflte-touch-power.dtsi
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Diagnostic supply candidate. Use touch-power-test.config before a boot
+ * build: the unrelated S2MPS15 RTC driver must remain disabled.
+ * Both buses replace the disabled stock HSI2C functions on these pins.
+ * S-Boot/APM bus ownership must be established before hardware use.
+ */
+/ {
+	/delete-node/ regulator-tsp-io;
+	/delete-node/ regulator-tsp-avdd;
+
+	/*
+	 * DSH: s2mps15 走 gpd2（MUIC 的 I2C）。
+	 * 实测：s2mps15 的 mainline s2mps11 驱动在 enable 时返回 -ENXIO，
+	 * 换到 gpg3 也一样 —— 所以是驱动/regmap 的问题，不是总线问题。
+	 * 因此这一版**不依赖 mainline 驱动**给 LDO15 上电，
+	 * 改由 /etc/rc 里的 i2cset 直接写 LDO15 控制寄存器（0x3f）。
+	 */
+	i2c-tsp-main-pmic {
+		compatible = "i2c-gpio";
+		/* DSH: 按原厂真机 DTB 修正引脚。
+		 * vendor hsi2c@13660000 里 s2mps15_pmic@66 的
+		 *   gpio_sda = <&gpg3 0 ...>;   gpio_scl = <&gpg3 1 ...>;
+		 * 实测证据：在 gpd2 上跑 i2cdetect 只找到 0x31（别的设备），
+		 * 0x66 完全没响应，所有读写都返回 -ENXIO。
+		 * 而 s2mpb02 在 gpg3-2/3 上工作正常（LDO17 = 0xec ✓）。
+		 * 所以两个 PMIC 共用 gpg3 这一个 bank，只是引脚不同：
+		 *   s2mps15  -> gpg3-0 / gpg3-1
+		 *   s2mpb02  -> gpg3-2 / gpg3-3
+		 */
+		sda-gpios = <&gpg3 0 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&gpg3 1 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <5>;
+		i2c-gpio,timeout-ms = <100>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		pmic@66 {
+			compatible = "samsung,s2mps15-pmic";
+			reg = <0x66>;
+			regulators {
+				tsp_io_ldo15: LDO15 {
+					regulator-name = "tsp_io";
+					/* DSH: 故意不写 regulator-min/max-microvolt。
+					 * 原因：写了之后 machine_constraints_voltage() 会调用
+					 * _regulator_get_voltage() → regmap_read(LDO15 VSEL=0x42)，
+					 * 实测返回 -ENXIO（s2mps15 的 regmap 拒绝了这次读），
+					 * 导致整个 regulator 注册失败（err=-6），
+					 * 进而 probe of s2mps15-regulator returned 6。
+					 * 不写电压约束就不会读寄存器，注册能成功；
+					 * 电压保持 S-Boot 留下的值（原厂就是 1.85V）。
+					 * 【已修正】根因是引脚接错（gpd2 -> gpg3-0/1），
+					 * 现在恢复电压约束和 always-on，让驱动真正上电。 */
+					regulator-min-microvolt = <1850000>;
+					regulator-max-microvolt = <1850000>;
+					regulator-always-on;
+					regulator-boot-on;
+				};
+			};
+		};
+	};
+
+	i2c-tsp-analog-pmic {
+		compatible = "i2c-gpio";
+		sda-gpios = <&gpg3 2 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&gpg3 3 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <5>;
+		i2c-gpio,timeout-ms = <100>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		pmic@59 {
+			compatible = "samsung,s2mpb02";
+			reg = <0x59>;
+			regulators {
+				tsp_avdd_ldo17: ldo17 {
+					regulator-name = "tsp_avdd";
+					regulator-min-microvolt = <3300000>;
+					regulator-max-microvolt = <3300000>;
+					regulator-always-on;
+				};
+			};
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/exynos/exynos7420-zeroflte-touch-test.dts b/arch/arm64/boot/dts/exynos/exynos7420-zeroflte-touch-test.dts
