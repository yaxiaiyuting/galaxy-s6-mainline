index 000000000..12ebc64c7
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos7420-zeroflte-touch-gpio-test.dts
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Diagnostic candidate A: PERIC1 oscillator bypass and an empty GPIO bus.
+ * No touchscreen or PMIC transaction is requested by this variant.
+ * CMU_PERIC1 accessibility itself still requires a hardware test.
+ */
+#include "exynos7420-zeroflte.dts"
+
+&clock_peric1 {
+	status = "okay";
+	/* Do not depend on disabled TOP0. Only the bus oscillator input
+	 * is exercised; UART/SPI/audio clocks remain unused in this test.
+	 */
+	clocks = <&fin_pll>, <&fin_pll>, <&fin_pll>, <&fin_pll>,
+		 <&fin_pll>, <&fin_pll>, <&fin_pll>, <&fin_pll>,
+		 <&fin_pll>, <&fin_pll>, <&fin_pll>, <&fin_pll>, <&fin_pll>;
+	assigned-clocks = <&clock_peric1 MOUT_ACLK_PERIC1_66_USER>;
+	assigned-clock-parents = <&fin_pll>;
+};
+
+/ {
+	tsp_gpio_test: i2c-tsp {
+		compatible = "i2c-gpio";
+		sda-gpios = <&gpj1 0 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&gpj1 1 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <5>;
+		i2c-gpio,timeout-ms = <100>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		/* No default pinctrl state: existing get_sda/get_scl diagnostic
+		 * checkpoints run before GPIO direction changes touch GPJ1.
+		 */
+	};
+};
