diff --git a/kernel/panic.c b/kernel/panic.c
index ffa037fa7..e0ae76b12 100644
--- a/kernel/panic.c
+++ b/kernel/panic.c
@@ -24,6 +24,7 @@
 #include <linux/delay.h>
 #include <linux/kexec.h>
 #include <linux/panic_notifier.h>
+#include <linux/dsh_diag.h>
 #include <linux/sched.h>
 #include <linux/string_helpers.h>
 #include <linux/sysrq.h>
@@ -331,6 +332,13 @@ void panic(const char *fmt, ...)
 	if (len && buf[len - 1] == '\n')
 		buf[len - 1] = '\0';
 
+	/* Publish the selected panic CPU's formatted message before printk
+	 * or notifier paths can block. The record has its own cache flush
+	 * and never repurposes the probe exit guard in dsh_regs[23].
+	 */
+	dsh_diag_panic(buf, (unsigned long)fmt,
+		       (unsigned long)__builtin_return_address(0));
+
 	pr_emerg("Kernel panic - not syncing: %s\n", buf);
 #ifdef CONFIG_DEBUG_BUGVERBOSE
 	/*
