+/*
+ * Quirk data for controllers which must not be probed at ->probe() time.
+ *
+ * On Exynos7420 the System MMU register block sits in the DISP power/clock
+ * domain and is only guaranteed to be accessible once the master (DECON) is
+ * powered up.  Reading REG_MMU_VERSION from ->probe() - which is what the
+ * generic path below does - is therefore the first (and fatal) MMIO access:
+ * an access to a powered-down/ungated IP block on this SoC never completes
+ * on the AXI bus, so the CPU hangs silently.  The vendor v6 driver avoids
+ * this by only clk_prepare()ing the clocks in ->probe() and never touching a
+ * register until the master is running (exynos-iommu-v6.c: __sysmmu_setup()
+ * -> __sysmmu_init_clock(), and __sysmmu_enable() which only programs the
+ * hardware when is_sysmmu_runtime_active()).
+ *
+ * Such controllers are selected through a dedicated DT compatible and get
+ * their version/variant from this table instead of the version register.
+ * The first real register access then happens in __sysmmu_enable(), which is
+ * only reachable after the master has powered the display (see
+ * exynos_iommu_master_ready()).
+ */
+struct exynos_sysmmu_desc {
+	unsigned int version;			/* hardware version to assume */
+	const struct sysmmu_variant *variant;	/* register layout to assume */
+};
+
+/* Exynos7420: SysMMU v6, register layout identical to v5 */
+static const struct exynos_sysmmu_desc exynos7420_sysmmu_desc = {
+	.version = MAKE_MMU_VER(6, 0),
+	.variant = &sysmmu_v5_variant,
+};
