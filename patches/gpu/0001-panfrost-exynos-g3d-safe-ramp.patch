@@ -5,11 +5,14 @@
 #define __PANFROST_DEVFREQ_H__
 
 #include <linux/devfreq.h>
+#include <linux/mutex.h>
 #include <linux/spinlock.h>
 #include <linux/ktime.h>
 
 struct devfreq;
 struct thermal_cooling_device;
+struct clk;
+struct dentry;
 
 struct panfrost_device;
 
@@ -19,6 +22,28 @@ struct panfrost_devfreq {
 	struct devfreq_simple_ondemand_data gov_data;
 	bool opp_of_table_added;
 
+	/*
+	 * DSH 2026-10-23: Exynos 7420 / Mali-T760 的安全变频句柄。
+	 *
+	 * 硬件拓扑（vendor clk-exynos7420.c）：
+	 *   fin_pll(24M) --\
+	 *                  MUX_SEL_G3D.bit8 --> aclk_g3d(gate) --> GPU
+	 *   g3d_pll   -----/
+	 * 没有 aclk 分频器，GPU 频率 == PLL 频率，所以变频 = 改 PLL。
+	 * 但直接在线改 PLL 会让 GPU 在 PLL 重锁的 µs 级窗口里吃到不稳定时钟
+	 * （实测 266->700 后第一次 GPU 渲染即 SError/panic）。vendor 的做法是
+	 * 把 mux 先切到 fin_pll，改 PLL，再切回（gpu_exynos7420.c:gpu_set_clock）。
+	 * 下面三个 clock 就是做这件事所需的句柄，缺任何一个就退回上游行为。
+	 */
+	struct clk *g3d_pll;	/* fout_g3d_pll，真正可编程的 PLL1452X */
+	struct clk *g3d_mux;	/* mout_aclk_g3d_400，PLL/fin_pll 二选一 */
+	struct clk *g3d_safe;	/* fin_pll，24MHz 常稳时钟，改 PLL 时挂上去 */
+	unsigned int g3d_strategy;
+	bool g3d_ramp_ok;
+	struct dentry *g3d_debugfs;
+	/* 串行化"mux 切走 -> 改 PLL -> 切回"，避免 devfreq 与 debugfs 互踩 */
+	struct mutex g3d_lock;
+
 	ktime_t busy_time;
 	ktime_t idle_time;
 	ktime_t time_last_update;
