--- a/drivers/gpu/drm/panfrost/panfrost_devfreq.c
+++ b/drivers/gpu/drm/panfrost/panfrost_devfreq.c
@@ -2,8 +2,11 @@
 /* Copyright 2019 Collabora ltd. */
 
 #include <linux/clk.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
 #include <linux/devfreq.h>
 #include <linux/devfreq_cooling.h>
+#include <linux/fs.h>
 #include <linux/nvmem-consumer.h>
 #include <linux/platform_device.h>
 #include <linux/pm_opp.h>
@@ -11,6 +14,301 @@
 #include "panfrost_device.h"
 #include "panfrost_devfreq.h"
 
+/*
+ * DSH 2026-10-23: Exynos 7420 (Mali-T760 MP8) 的安全变频
+ * ====================================================
+ *
+ * 硬件事实（全部有 vendor 源码行号支撑，详见
+ * 文档/05-专项/GPU-DVFS实现方案-20261023.md）：
+ *
+ *   CMU_G3D 的 GPU 核心时钟路径上**没有分频器**：
+ *       g3d_pll (PLL1452X, 可编程) --\
+ *                                    mux(MUX_SEL_G3D.bit8) -> aclk_g3d(bit0) -> GPU
+ *       fin_pll (24MHz, 常稳)     --/
+ *   所以 GPU 频率 == PLL 频率，变频只能改 PLL；而 PLL 是"在线"给 GPU 供时钟的。
+ *
+ *   vendor 的每个频点都是 900000µV（gpu_dvfs_table_default[]，
+ *   platform/exynos/gpu_exynos7420.c:56-64），266MHz 与 700MHz 同压。
+ *
+ *   vendor 的变频序列（同文件 gpu_set_clock()，:302-352）：
+ *       ① clk_set_parent(mout_g3d, fin_pll)     // GPU 先退回 24MHz
+ *       ② clk_set_rate(fout_g3d_pll, target)    // 此时改 PLL 对 GPU 不可见
+ *       ③ clk_set_rate(sclk_hpm_g3d, ...)       // 只影响 HPM 计数器
+ *       ④ clk_set_parent(mout_g3d, fout_g3d_pll)
+ *
+ * 2026-10-22 实测：直接在 266MHz 的 CON0 上改成 700MHz（严格照 mainline
+ * samsung_pll35xx_set_rate 的写序），PLL 立刻回读"已锁定"，GPU 挂起两秒
+ * 无异常，但一发起真实渲染就 SError -> panic。既然同压，"电压不足"解释
+ * 不了它；"PLL 重锁窗口漏给了 GPU"完全解释得了：mainline 的
+ * samsung_pll35xx_set_rate() 在 PLL 使能时 busy-poll LOCK 位，而写 PMS 之前
+ * LOCK 本来就是 1，poll 第一次读就直接返回，relock 的尾巴全喂给了 GPU。
+ * （vendor 用的是 145xx 自己的 set_rate，并且从不把 PLL 直接连在 GPU 上改。）
+ *
+ * 因此这里的 target() 不再把频率请求直接甩给 clk_set_rate()，而是走 vendor
+ * 的 mux 绕行序列，并在回切前显式 udelay() 一个 PLL 稳定窗口。
+ *
+ * 可选 DT 属性（写在 gpu 节点里）：
+ *   samsung,g3d-fixed-rate-hz = <700000000>;
+ * probe 时用同一套序列把 PLL 一次性设到该频率：即使 devfreq 还没接上，
+ * 也能先验证"700MHz 本身能不能跑"。
+ */
+
+#define PANFROST_G3D_STRATEGY_MUX	0	/* vendor 序列：mux 切到 24MHz（默认） */
+#define PANFROST_G3D_STRATEGY_GATE	1	/* 实验策略：先关 aclk_g3d 再改 PLL */
+
+#define PANFROST_G3D_SAFE_RATE		24000000UL
+#define PANFROST_G3D_SETTLE_US		50
+
+/*
+ * 改 PLL 前把 GPU 的时钟源切到 24MHz 的 fin_pll，改完再切回来。
+ *
+ * 为什么不是"关掉 aclk_g3d 再改"：alcl_g3d 一关 GPU 就完全没有时钟，
+ * 正在执行的 job 会直接卡死（超时/SError）；vendor 从不在 GPU 活动时关它，
+ * 只在域下电时关。切到 fin_pll 则是"变慢但不中断"，这也是 vendor 唯一
+ * 验证过的序列。GATE 策略只保留给"GPU 确定空闲"的调试用。
+ */
+static int panfrost_g3d_set_rate(struct panfrost_device *pfdev, unsigned long rate)
+{
+	struct panfrost_devfreq *pfdevfreq = &pfdev->pfdevfreq;
+	struct device *dev = pfdev->dev;
+	long rounded;
+	unsigned long cur;
+	int ret = 0;
+
+	if (!pfdevfreq->g3d_ramp_ok)
+		return -ENODEV;
+
+	if (!rate)
+		return -EINVAL;
+
+	/*
+	 * devfreq 的 target() 与 debugfs 的 rate 写口可能并发；两个 ramp 交错
+	 * 会把 mux 留在 fin_pll 上（GPU 掉到 24MHz）。这里串行化。
+	 */
+	mutex_lock(&pfdevfreq->g3d_lock);
+
+	/*
+	 * 只接受 PLL 频率表里能精确整除出来的频点。samsung_pll_round_rate()
+	 * 在带表的情况下只返回表里的值，这里提前挡掉"静默取整"。
+	 */
+	rounded = clk_round_rate(pfdevfreq->g3d_pll, rate);
+	if (rounded < 0 || (unsigned long)rounded != rate) {
+		dev_err(dev, "g3d: %lu Hz is not a supported PLL rate (rounds to %ld)\n",
+			rate, rounded);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (clk_get_rate(pfdevfreq->g3d_pll) == rate) {
+		/* 频率没变，但顺手保证 mux 还挂在 PLL 上（失败回滚后可自愈） */
+		if (pfdevfreq->g3d_strategy == PANFROST_G3D_STRATEGY_MUX)
+			clk_set_parent(pfdevfreq->g3d_mux, pfdevfreq->g3d_pll);
+		goto out;
+	}
+
+	if (pfdevfreq->g3d_strategy == PANFROST_G3D_STRATEGY_MUX) {
+		/* ① GPU 时钟源切到 fin_pll：此后改 PLL 对 GPU 不可见 */
+		ret = clk_set_parent(pfdevfreq->g3d_mux, pfdevfreq->g3d_safe);
+		if (ret) {
+			dev_err(dev, "g3d: cannot mux to safe parent (%d)\n", ret);
+			goto out;
+		}
+	} else {
+		/* 实验策略：直接关 aclk_g3d（调用者必须保证 GPU 空闲） */
+		clk_disable_unprepare(pfdev->clock);
+	}
+
+	/* ② 改 PLL */
+	ret = clk_set_rate(pfdevfreq->g3d_pll, rate);
+	if (ret) {
+		dev_err(dev, "g3d: clk_set_rate(%lu) failed (%d)\n", rate, ret);
+	} else {
+		/*
+		 * ③ 等 PLL 真正稳定。mainline 的 LOCK 位轮询在
+		 * "写之前就是 1" 的情况下会立即返回，所以这里补一个显式
+		 * 稳定窗口，再让 GPU 看到 PLL。
+		 */
+		udelay(PANFROST_G3D_SETTLE_US);
+	}
+
+	if (pfdevfreq->g3d_strategy == PANFROST_G3D_STRATEGY_MUX) {
+		int mux_ret = clk_set_parent(pfdevfreq->g3d_mux, pfdevfreq->g3d_pll);
+
+		if (mux_ret) {
+			dev_err(dev, "g3d: cannot mux back to g3d_pll (%d)\n", mux_ret);
+			if (!ret)
+				ret = mux_ret;
+		}
+	} else {
+		clk_prepare_enable(pfdev->clock);
+	}
+
+	/* aclk_g3d 是 PLL 的孙子，回切后 CCF 会重算它的频率；这里做一次实测校验 */
+	cur = clk_get_rate(pfdev->clock);
+	if (!ret && cur != rate) {
+		dev_err(dev, "g3d: core clock reads %lu Hz, wanted %lu Hz\n",
+			cur, rate);
+		ret = -EIO;
+	}
+
+out:
+	mutex_unlock(&pfdevfreq->g3d_lock);
+
+	return ret;
+}
+
+static int panfrost_g3d_ramp_init(struct panfrost_device *pfdev)
+{
+	struct panfrost_devfreq *pfdevfreq = &pfdev->pfdevfreq;
+	struct device *dev = pfdev->dev;
+	u32 fixed;
+	int ret;
+
+	pfdevfreq->g3d_pll = devm_clk_get_optional(dev, "g3d-pll");
+	if (IS_ERR(pfdevfreq->g3d_pll))
+		return dev_err_probe(dev, PTR_ERR(pfdevfreq->g3d_pll),
+				     "failed to get g3d-pll\n");
+
+	pfdevfreq->g3d_mux = devm_clk_get_optional(dev, "g3d-mux");
+	if (IS_ERR(pfdevfreq->g3d_mux))
+		return dev_err_probe(dev, PTR_ERR(pfdevfreq->g3d_mux),
+				     "failed to get g3d-mux\n");
+
+	pfdevfreq->g3d_safe = devm_clk_get_optional(dev, "g3d-safe");
+	if (IS_ERR(pfdevfreq->g3d_safe))
+		return dev_err_probe(dev, PTR_ERR(pfdevfreq->g3d_safe),
+				     "failed to get g3d-safe\n");
+
+	/* 非 Exynos G3D 的板子：三个 clock 都不存在，保持上游行为 */
+	if (!pfdevfreq->g3d_pll || !pfdevfreq->g3d_mux || !pfdevfreq->g3d_safe) {
+		dev_dbg(dev, "no G3D clock triplet, plain clk_set_rate only\n");
+		return 0;
+	}
+
+	if (clk_get_rate(pfdevfreq->g3d_safe) != PANFROST_G3D_SAFE_RATE) {
+		dev_warn(dev, "g3d-safe is %lu Hz (expect %lu Hz); safe ramp disabled\n",
+			 clk_get_rate(pfdevfreq->g3d_safe),
+			 PANFROST_G3D_SAFE_RATE);
+		return 0;
+	}
+
+	mutex_init(&pfdevfreq->g3d_lock);
+	pfdevfreq->g3d_strategy = PANFROST_G3D_STRATEGY_MUX;
+	pfdevfreq->g3d_ramp_ok = true;
+
+	dev_info(dev, "G3D safe ramp ready: pll=%lu Hz core=%lu Hz safe=%lu Hz\n",
+		 clk_get_rate(pfdevfreq->g3d_pll),
+		 clk_get_rate(pfdev->clock),
+		 clk_get_rate(pfdevfreq->g3d_safe));
+
+	if (!device_property_read_u32(dev, "samsung,g3d-fixed-rate-hz", &fixed) &&
+	    fixed) {
+		ret = panfrost_g3d_set_rate(pfdev, fixed);
+		if (ret)
+			dev_warn(dev, "cannot apply samsung,g3d-fixed-rate-hz=%u (%d)\n",
+				 fixed, ret);
+		else
+			dev_info(dev, "G3D fixed rate applied: %u Hz\n", fixed);
+	}
+
+	return 0;
+}
+
+static int panfrost_g3d_rate_get(void *data, u64 *val)
+{
+	struct panfrost_device *pfdev = data;
+
+	if (!pfdev->pfdevfreq.g3d_ramp_ok)
+		return -ENODEV;
+
+	*val = clk_get_rate(pfdev->pfdevfreq.g3d_pll);
+
+	return 0;
+}
+
+static int panfrost_g3d_rate_set(void *data, u64 val)
+{
+	return panfrost_g3d_set_rate(data, (unsigned long)val);
+}
+
+DEFINE_DEBUGFS_ATTRIBUTE(panfrost_g3d_rate_fops, panfrost_g3d_rate_get,
+			 panfrost_g3d_rate_set, "%llu\n");
+
+static int panfrost_g3d_strategy_get(void *data, u64 *val)
+{
+	struct panfrost_device *pfdev = data;
+
+	*val = pfdev->pfdevfreq.g3d_strategy;
+
+	return 0;
+}
+
+static int panfrost_g3d_strategy_set(void *data, u64 val)
+{
+	struct panfrost_device *pfdev = data;
+
+	if (val > PANFROST_G3D_STRATEGY_GATE)
+		return -EINVAL;
+
+	pfdev->pfdevfreq.g3d_strategy = val;
+
+	return 0;
+}
+
+DEFINE_DEBUGFS_ATTRIBUTE(panfrost_g3d_strategy_fops, panfrost_g3d_strategy_get,
+			 panfrost_g3d_strategy_set, "%llu\n");
+
+static ssize_t panfrost_g3d_state_read(struct file *file, char __user *ubuf,
+				       size_t count, loff_t *ppos)
+{
+	struct panfrost_device *pfdev = file->private_data;
+	struct panfrost_devfreq *pfdevfreq = &pfdev->pfdevfreq;
+	struct clk *parent;
+	char buf[256];
+	int len;
+
+	if (!pfdevfreq->g3d_ramp_ok) {
+		len = scnprintf(buf, sizeof(buf), "ramp=off\n");
+	} else {
+		parent = clk_get_parent(pfdevfreq->g3d_mux);
+		len = scnprintf(buf, sizeof(buf),
+				"ramp=on\nstrategy=%u\npll=%lu\ncore=%lu\n"
+				"mux_parent_rate=%lu\nsafe=%lu\n",
+				pfdevfreq->g3d_strategy,
+				clk_get_rate(pfdevfreq->g3d_pll),
+				clk_get_rate(pfdev->clock),
+				parent ? clk_get_rate(parent) : 0UL,
+				clk_get_rate(pfdevfreq->g3d_safe));
+	}
+
+	return simple_read_from_buffer(ubuf, count, ppos, buf, len);
+}
+
+static const struct file_operations panfrost_g3d_state_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = panfrost_g3d_state_read,
+	.llseek = default_llseek,
+};
+
+static void panfrost_g3d_debugfs_init(struct panfrost_device *pfdev)
+{
+	struct panfrost_devfreq *pfdevfreq = &pfdev->pfdevfreq;
+	struct dentry *dir;
+
+	dir = debugfs_create_dir("panfrost-g3d", NULL);
+	if (IS_ERR_OR_NULL(dir)) {
+		pfdevfreq->g3d_debugfs = NULL;
+		return;
+	}
+	pfdevfreq->g3d_debugfs = dir;
+
+	debugfs_create_file("rate", 0600, dir, pfdev, &panfrost_g3d_rate_fops);
+	debugfs_create_file("strategy", 0600, dir, pfdev,
+			    &panfrost_g3d_strategy_fops);
+	debugfs_create_file("state", 0400, dir, pfdev, &panfrost_g3d_state_fops);
+}
