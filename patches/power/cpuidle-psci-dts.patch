 			/*
 			 * DSH 2026-10-22: Cortex-A53 的 DMIPS/MHz ≈ 2.3。
@@ -213,6 +261,17 @@
 	psci {
 		compatible = "arm,psci";
 		method = "smc";
+		/*
+		 * DSH 2026-10-23: S-Boot 的 PSCI 虽然只能按 v0.1 绑定描述
+		 * （函数号从 DT 读，没有 FEATURES 调用），但 CPU_SUSPEND 是
+		 * 实打实实现的。vendor 内核（LOS20, exynos7420.dtsi:333）
+		 * 就是用 <0xC4000001> 走 CPU_SUSPEND 做 C2/LPM 的。
+		 *
+		 * 不写这一条时 psci_ops.cpu_suspend == NULL，于是
+		 * cpuidle-psci 在 psci_cpu_init_idle() 里第一行就
+		 * return -EOPNOTSUPP —— 内核日志表现为 "cpuidle 驱动: none"。
+		 */
+		cpu_suspend = <0xc4000001>;
 		cpu_off = <0x84000002>;
 		cpu_on = <0xc4000003>;
 	};
