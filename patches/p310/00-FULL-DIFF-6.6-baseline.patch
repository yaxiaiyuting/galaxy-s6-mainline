+static bool dsh_trace_vt_driver(const struct tty_driver *driver)
+{
+	return driver->type == TTY_DRIVER_TYPE_CONSOLE &&
+	       driver->major == TTY_MAJOR && driver->minor_start == 1;
+}
+
+/* Every completed step is also a progress heartbeat.  Preserve the tty
+ * index in the stage so a slow 63-device registration stays distinguishable
+ * from one device stuck in allocation, driver core, cdev, or uevent work.
+ */
+static void dsh_trace_vt_device(const struct tty_driver *driver,
+			      unsigned int index, unsigned long phase)
+{
+	if (dsh_trace_vt_driver(driver))
+		dsh_mark(0x460000UL | ((unsigned long)index << 8) | phase);
+}
+
 static int tty_cdev_add(struct tty_driver *driver, dev_t dev,
 		unsigned int index, unsigned int count)
 {
@@ -3231,6 +3249,7 @@ struct device *tty_register_device_attr(struct tty_driver *driver,
 	else
 		tty_line_name(driver, index, name);
 
+	dsh_trace_vt_device(driver, index, 1);
 	dev = kzalloc(sizeof(*dev), GFP_KERNEL);
 	if (!dev)
 		return ERR_PTR(-ENOMEM);
@@ -3245,7 +3264,9 @@ struct device *tty_register_device_attr(struct tty_driver *driver,
 
 	dev_set_uevent_suppress(dev, 1);
 
+	dsh_trace_vt_device(driver, index, 2);
 	retval = device_register(dev);
+	dsh_trace_vt_device(driver, index, 3);
 	if (retval)
 		goto err_put;
 
@@ -3260,13 +3281,17 @@ struct device *tty_register_device_attr(struct tty_driver *driver,
 			kfree(tp);
 		}
 
+		dsh_trace_vt_device(driver, index, 4);
 		retval = tty_cdev_add(driver, devt, index, 1);
+		dsh_trace_vt_device(driver, index, 5);
 		if (retval)
 			goto err_del;
 	}
 
 	dev_set_uevent_suppress(dev, 0);
+	dsh_trace_vt_device(driver, index, 6);
 	kobject_uevent(&dev->kobj, KOBJ_ADD);
+	dsh_trace_vt_device(driver, index, 7);
 
 	return dev;
 
@@ -3416,6 +3441,10 @@ int tty_register_driver(struct tty_driver *driver)
 	int i;
 	dev_t dev;
 	struct device *d;
+	bool trace_vt = dsh_trace_vt_driver(driver);
+
+	if (trace_vt)
+		dsh_mark(0x4600);
 
 	if (!driver->major) {
 		error = alloc_chrdev_region(&dev, driver->minor_start,
@@ -3430,6 +3459,8 @@ int tty_register_driver(struct tty_driver *driver)
 	}
 	if (error < 0)
 		goto err;
+	if (trace_vt)
+		dsh_mark(0x4601);
 
 	if (driver->flags & TTY_DRIVER_DYNAMIC_ALLOC) {
 		error = tty_cdev_add(driver, dev, 0, driver->num);
@@ -3437,9 +3468,15 @@ int tty_register_driver(struct tty_driver *driver)
 			goto err_unreg_char;
 	}
 
+	if (trace_vt)
+		dsh_mark(0x4602);
 	mutex_lock(&tty_mutex);
+	if (trace_vt)
+		dsh_mark(0x4603);
 	list_add(&driver->tty_drivers, &tty_drivers);
 	mutex_unlock(&tty_mutex);
+	if (trace_vt)
+		dsh_mark(0x4604);
 
 	if (!(driver->flags & TTY_DRIVER_DYNAMIC_DEV)) {
 		for (i = 0; i < driver->num; i++) {
@@ -3450,7 +3487,11 @@ int tty_register_driver(struct tty_driver *driver)
 			}
 		}
 	}
+	if (trace_vt)
+		dsh_mark(0x4605);
 	proc_tty_register_driver(driver);
+	if (trace_vt)
+		dsh_mark(0x4606);
 	driver->flags |= TTY_DRIVER_INSTALLED;
 	return 0;
 
@@ -3617,25 +3658,33 @@ static struct ctl_table tty_table[] = {
  */
 int __init tty_init(void)
 {
+	extern void dsh_mark(unsigned long);
+	dsh_mark(0x4410);
 	register_sysctl_init("dev/tty", tty_table);
+	dsh_mark(0x4411);
 	cdev_init(&tty_cdev, &tty_fops);
 	if (cdev_add(&tty_cdev, MKDEV(TTYAUX_MAJOR, 0), 1) ||
 	    register_chrdev_region(MKDEV(TTYAUX_MAJOR, 0), 1, "/dev/tty") < 0)
 		panic("Couldn't register /dev/tty driver\n");
+	dsh_mark(0x4412);
 	device_create(&tty_class, NULL, MKDEV(TTYAUX_MAJOR, 0), NULL, "tty");
+	dsh_mark(0x4413);
 
 	cdev_init(&console_cdev, &console_fops);
 	if (cdev_add(&console_cdev, MKDEV(TTYAUX_MAJOR, 1), 1) ||
 	    register_chrdev_region(MKDEV(TTYAUX_MAJOR, 1), 1, "/dev/console") < 0)
 		panic("Couldn't register /dev/console driver\n");
+	dsh_mark(0x4414);
 	consdev = device_create_with_groups(&tty_class, NULL,
 					    MKDEV(TTYAUX_MAJOR, 1), NULL,
 					    cons_dev_groups, "console");
 	if (IS_ERR(consdev))
 		consdev = NULL;
+	dsh_mark(0x4415);
 
 #ifdef CONFIG_VT
 	vty_init(&console_fops);
 #endif
+	dsh_mark(0x4417);
 	return 0;
 }
