+	 */
+	status = readl(ctx->dsim_regs + DSIM_STATUS);
+	if (status == 0xffffffff) {
+		pr_err(DSH_DISP_TAG " decon: DSIM not responding (STATUS=0x%08x), backlight disabled\n",
+		       status);
+		iounmap(ctx->dsim_regs);
+		ctx->dsim_regs = NULL;
+		return;
+	}
+
+	/* 诊断模式：只读状态、不注册、不发包 */
