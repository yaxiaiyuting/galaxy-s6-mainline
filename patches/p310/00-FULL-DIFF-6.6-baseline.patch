+static int dsh_bl_get_brightness(struct backlight_device *bl)
+{
+	return bl->props.brightness;
+}
+
+static int dsh_bl_update_status(struct backlight_device *bl)
+{
+	struct decon_context *ctx = bl_get_data(bl);
+
+	/* DPMS off 期间只记住亮度，绝不把面板点亮 */
+	if (ctx->panel_off)
+		return 0;
+
+	return dsh_dsim_set_level(ctx, bl->props.brightness);
+}
+
+static const struct backlight_ops dsh_bl_ops = {
+	.get_brightness	= dsh_bl_get_brightness,
+	.update_status	= dsh_bl_update_status,
+};
