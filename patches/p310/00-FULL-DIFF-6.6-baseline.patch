+		dev_err(dev, "failed to register backlight (%ld)\n", PTR_ERR(bl));
+		iounmap(ctx->dsim_regs);
+		ctx->dsim_regs = NULL;
+		return;
+	}
+
+	ctx->bl_dev = bl;
+
+	pr_err(DSH_DISP_TAG " decon: backlight registered (level=%u, DSIM STATUS=%08x)\n",
+	       bl->props.brightness, status);
+
+	/* 立刻下发一次，确认 DCS 通道是否真的通（看 dmesg 有无失败打印） */
+	dsh_dsim_set_level(ctx, bl->props.brightness);
+}
+
+static void dsh_bl_unregister(struct decon_context *ctx)
+{
+	if (ctx->bl_dev) {
+		backlight_device_unregister(ctx->bl_dev);
+		ctx->bl_dev = NULL;
+	}
+
+	if (ctx->dsim_regs) {
+		iounmap(ctx->dsim_regs);
+		ctx->dsim_regs = NULL;
+	}
+}
