+/* The G9209 firmware scans ARGB8888 RAM, while Mutter supplies XRGB8888.
+ * The generic helper stages and converts every line before memcpy_toio().
+ * Fuse these operations for this board's Normal-NC/WC framebuffer RAM; the
+ * opaque alpha is still required by the firmware's existing display setup.
+ */
+static bool simpledrm_g9209_blit(struct simpledrm_device *sdev,
+			       const struct iosys_map *dst,
+			       const struct iosys_map *src,
+			       const struct drm_framebuffer *fb,
+			       const struct drm_rect *clip)
+{
+#if defined(CONFIG_ARM64) && !defined(CONFIG_CPU_BIG_ENDIAN)
