diff --git a/drivers/input/keyboard/cypress-mbr-touchkey.c b/drivers/input/keyboard/cypress-mbr-touchkey.c
new file mode 100644
index 000000000..9513d850d
--- /dev/null
+++ b/drivers/input/keyboard/cypress-mbr-touchkey.c
@@ -0,0 +1,254 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Cypress CY8CMBR31x5 (MBR) capacitive touch key controller
+ *
+ * The CY8CMBR31x5 is a CapSense "MBR" controller used on several Samsung
+ * Exynos boards (e.g. Galaxy S6 "zeroflte") to report the capacitive BACK
+ * and RECENT keys.  It is a separate I2C device from the touchscreen
+ * controller and keeps its firmware in internal flash, so the host only
+ * has to read the key status register.
+ *
+ * Register 0x03 contains one two-bit field per key:
+ *
+ *   0b00 - no event
+ *   0b01 - key pressed
+ *   0b10 - key released
+ *
+ * The controller asserts its (active low) interrupt line whenever a key
+ * changes state; the register is read from the threaded interrupt handler.
+ * The bit layout matches the Samsung 3.10 driver this was ported from
+ * (drivers/input/keyboard/cypress_20075/cypress-touchkey.c).
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/property.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+
+#define MBR_TOUCHKEY_KEYCODE_REG	0x03
+#define MBR_TOUCHKEY_FW_VER_REG		0x04
+#define MBR_TOUCHKEY_KEY_MASK		GENMASK(1, 0)
+#define MBR_TOUCHKEY_KEY_PRESS		0x01
+#define MBR_TOUCHKEY_MAX_KEYS		4
+#define MBR_TOUCHKEY_DEV_NAME		"mbr-touchkey"
+
+struct mbr_touchkey_data {
+	struct i2c_client *client;
+	struct input_dev *input;
+	u32 keycodes[MBR_TOUCHKEY_MAX_KEYS];
+	bool pressed[MBR_TOUCHKEY_MAX_KEYS];
+	int num_keycodes;
+};
+
+static irqreturn_t mbr_touchkey_irq_handler(int irq, void *dev_id)
+{
+	struct mbr_touchkey_data *touchkey = dev_id;
+	int val;
+	int i;
+
+	val = i2c_smbus_read_byte_data(touchkey->client,
+				       MBR_TOUCHKEY_KEYCODE_REG);
+	if (val < 0) {
+		dev_err_ratelimited(&touchkey->client->dev,
+				    "failed to read key status: %d\n", val);
+		return IRQ_HANDLED;
+	}
+
+	for (i = 0; i < touchkey->num_keycodes; i++) {
+		unsigned int state = (val >> (2 * i)) & MBR_TOUCHKEY_KEY_MASK;
+		bool press = state & MBR_TOUCHKEY_KEY_PRESS;
+
+		/*
+		 * 0b00 means "no event" and must not be reported as a
+		 * release: the controller only writes 0b10 on release.
+		 * 0b01 (and the unexpected 0b11) mean the key is down.
+		 */
+		if (!state)
+			continue;
+
+		if (press) {
+			if (touchkey->pressed[i])
+				continue;
+			touchkey->pressed[i] = true;
+			input_report_key(touchkey->input,
+					 touchkey->keycodes[i], 1);
+		} else {
+			touchkey->pressed[i] = false;
+			input_report_key(touchkey->input,
+					 touchkey->keycodes[i], 0);
+		}
+	}
+
+	input_sync(touchkey->input);
+
+	return IRQ_HANDLED;
+}
+
+static int mbr_touchkey_probe(struct i2c_client *client)
+{
+	struct mbr_touchkey_data *touchkey;
+	struct input_dev *input;
+	int val;
+	int error;
+	int i;
+
+	if (!i2c_check_functionality(client->adapter,
+				     I2C_FUNC_SMBUS_BYTE_DATA))
+		return dev_err_probe(&client->dev, -EOPNOTSUPP,
+				     "I2C adapter lacks SMBus byte data support\n");
+
+	if (client->irq <= 0)
+		return dev_err_probe(&client->dev, -ENODEV,
+				     "missing interrupt\n");
+
+	/*
+	 * The CY8CMBR31x5 core rail (vtouch_3.3v = S2MPS15 LDO21 on
+	 * zeroflte) is not enabled by the bootloader: reading PMIC
+	 * register 0x48 after boot shows bit[7:6] = 00 (off) and the
+	 * controller then NAKs its address.  Enable it explicitly here
+	 * so probe ordering is handled by the regulator core's deferred
+	 * probe rather than by initcall order.
+	 *
+	 * devm_regulator_get_enable() also disables the rail again when
+	 * the device goes away; a missing supply is not fatal (dummy
+	 * regulator), which keeps the driver usable on boards where the
+	 * rail is always on.
+	 */
+	error = devm_regulator_get_enable(&client->dev, "vdd");
+	if (error)
+		return dev_err_probe(&client->dev, error,
+				     "failed to enable VDD supply\n");
+
+	/* Datasheet/vendor ic-stabilizing-time: let the IC boot. */
+	msleep(150);
+
+	touchkey = devm_kzalloc(&client->dev, sizeof(*touchkey), GFP_KERNEL);
+	if (!touchkey)
+		return -ENOMEM;
+
+	touchkey->client = client;
+
+	touchkey->num_keycodes =
+		device_property_read_u32_array(&client->dev, "linux,keycodes",
+					       touchkey->keycodes,
+					       MBR_TOUCHKEY_MAX_KEYS);
+	if (touchkey->num_keycodes <= 0) {
+		touchkey->keycodes[0] = KEY_MENU;
+		touchkey->keycodes[1] = KEY_BACK;
+		touchkey->num_keycodes = 2;
+	}
+
+	/* Sanity check: the controller must answer before we register input. */
+	val = i2c_smbus_read_byte_data(client, MBR_TOUCHKEY_KEYCODE_REG);
+	if (val < 0)
+		return dev_err_probe(&client->dev, val,
+				     "touchkey controller does not respond\n");
+
+	val = i2c_smbus_read_byte_data(client, MBR_TOUCHKEY_FW_VER_REG);
+	if (val >= 0)
+		dev_info(&client->dev, "Cypress MBR touchkey, firmware 0x%02x\n",
+			 val);
+	else
+		dev_warn(&client->dev, "cannot read firmware version: %d\n",
+			 val);
+
+	input = devm_input_allocate_device(&client->dev);
+	if (!input)
+		return -ENOMEM;
+
+	input->name = MBR_TOUCHKEY_DEV_NAME;
+	input->id.bustype = BUS_I2C;
+	input->dev.parent = &client->dev;
+
+	for (i = 0; i < touchkey->num_keycodes; i++)
+		input_set_capability(input, EV_KEY, touchkey->keycodes[i]);
+
+	touchkey->input = input;
+	i2c_set_clientdata(client, touchkey);
+
+	/*
+	 * Register the input device before hooking up the interrupt: the
+	 * ATTN line may already be asserted when we request the IRQ, and
+	 * the threaded handler must not report keys on an unregistered
+	 * input device.
+	 */
+	error = input_register_device(input);
+	if (error)
+		return dev_err_probe(&client->dev, error,
