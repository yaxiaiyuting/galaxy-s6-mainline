new file mode 100644
index 000000000..acd5c5188
--- /dev/null
+++ b/drivers/gpu/drm/tiny/simpledrm-g9209-copy.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef SIMPLEDRM_G9209_COPY_H
+#define SIMPLEDRM_G9209_COPY_H
+
+/* AArch64 general registers only: no kernel SIMD/FPSIMD state is touched.
+ * Both mappings must be Normal memory (including Normal-NC/write-combined
+ * framebuffer RAM), never Device MMIO. Pointers must be 32-bit aligned.
+ * Read each source pixel once and force opaque alpha while streaming to dst.
+ */
+static inline void simpledrm_g9209_xrgb_to_argb(void *dst, const void *src,
+					      unsigned int pixels)
+{
+	unsigned long blocks = pixels / 8, tail = pixels % 8;
+	unsigned long a, b, c, d;
+
+	asm volatile (
+		"cbz %[blocks], 2f\n"
+		".p2align 4\n"
+		"1:\n"
+		"ldp %[a], %[b], [%[src]], #16\n"
+		"ldp %[c], %[d], [%[src]], #16\n"
+		"orr %[a], %[a], #0xff000000ff000000\n"
+		"orr %[b], %[b], #0xff000000ff000000\n"
+		"orr %[c], %[c], #0xff000000ff000000\n"
+		"orr %[d], %[d], #0xff000000ff000000\n"
+		"stp %[a], %[b], [%[dst]], #16\n"
+		"stp %[c], %[d], [%[dst]], #16\n"
+		"subs %[blocks], %[blocks], #1\n"
+		"b.ne 1b\n"
+		"2:\n"
+		"cbz %[tail], 4f\n"
+		"3:\n"
+		"ldr %w[a], [%[src]], #4\n"
+		"orr %w[a], %w[a], #0xff000000\n"
+		"str %w[a], [%[dst]], #4\n"
+		"subs %[tail], %[tail], #1\n"
+		"b.ne 3b\n"
+		"4:\n"
+		: [dst] "+&r" (dst), [src] "+&r" (src),
+		  [blocks] "+&r" (blocks), [tail] "+&r" (tail),
+		  [a] "=&r" (a), [b] "=&r" (b), [c] "=&r" (c), [d] "=&r" (d)
+		:
+		: "cc", "memory");
+}
+#endif
