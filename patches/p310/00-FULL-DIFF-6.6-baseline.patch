@@ -1471,6 +1664,7 @@ static int exynos_iommu_of_xlate(struct device *dev,
 }
 
 static const struct iommu_ops exynos_iommu_ops = {
+	.owner = THIS_MODULE,
 	.domain_alloc = exynos_iommu_domain_alloc,
 	.device_group = generic_device_group,
 #ifdef CONFIG_ARM
@@ -1515,7 +1709,9 @@ static int __init exynos_iommu_init(void)
 		goto err_zero_lv2;
 	}
 
+	pr_emerg("IOMMU: init enter\n");
 	ret = platform_driver_register(&exynos_sysmmu_driver);
+	pr_emerg("IOMMU: platform_driver_register ret=%d\n", ret);
 	if (ret) {
 		pr_err("%s: Failed to register driver\n", __func__);
 		goto err_reg_driver;
@@ -1528,4 +1724,16 @@ static int __init exynos_iommu_init(void)
 	kmem_cache_destroy(lv2table_kmem_cache);
 	return ret;
 }
-core_initcall(exynos_iommu_init);
+
+static void __exit exynos_iommu_exit(void)
+{
+	platform_driver_unregister(&exynos_sysmmu_driver);
+	kmem_cache_free(lv2table_kmem_cache, zero_lv2_table);
+	kmem_cache_destroy(lv2table_kmem_cache);
+}
+
+module_init(exynos_iommu_init);
+module_exit(exynos_iommu_exit);
+
+MODULE_DESCRIPTION("Samsung Exynos IOMMU (System MMU) driver");
+MODULE_LICENSE("GPL v2");
diff --git a/drivers/mfd/madera-core.c b/drivers/mfd/madera-core.c
index bdbd5bfc9..bc1e7bb6a 100644
--- a/drivers/mfd/madera-core.c
+++ b/drivers/mfd/madera-core.c
@@ -713,20 +713,57 @@ int madera_dev_init(struct madera *madera)
 		}
 	}
 
-	/* Init 32k clock sourced from MCLK2 */
-	ret = clk_prepare_enable(madera->mclk[MADERA_MCLK2].clk);
-	if (ret) {
-		dev_err(madera->dev, "Failed to enable 32k clock: %d\n", ret);
-		goto err_reset;
-	}
+	/*
+	 * DSH 2026-10-21: 处理「本板没有 MCLK2 (32.768kHz)」的情况。
+	 *
+	 * S6 (zeroflte) 的硬件设计里，WM1840/CS47L85 的 MCLK2 引脚**没有
+	 * 接任何 32.768kHz 时钟源**（vendor DTS 的 wm1840 节点根本没有
+	 * clocks 属性，只有 wlf,reset / wlf,ldoena 两个 GPIO）。
+	 *
+	 * 原驱动无条件 clk_prepare_enable(mclk[MCLK2].clk) —— 当它是一个
+	 * 空 clock 时返回错误，然后 goto err_reset，导致：
+	 *   "Polling BOOT_DONE_STS timed out" → probe 失败 -110
+	 * 实测 dmesg:
+	 *   madera spi1.0: Missing MCLK2, requires 32kHz clock
+	 *   madera spi1.0: Polling BOOT_DONE_STS timed out
+	 *   madera: probe of spi1.0 failed with error -110
+	 *
+	 * 修法：MCLK2 不存在时把 CLK_32K_SRC 设成 2 (NONE) —— 这正是
