+	 */
+	pr_err("DSH-DPMS: atomic_disable CRTC%d active=%d enabled=%d\n",
+	       crtc->base.id, crtc->state->active,
+	       crtc->state->enable);
+
 	drm_crtc_vblank_off(crtc);
 
 	if (exynos_crtc->ops->atomic_disable)
diff --git a/drivers/gpu/drm/exynos/exynos_drm_dma.c b/drivers/gpu/drm/exynos/exynos_drm_dma.c
index a971590b8..8d7750996 100644
--- a/drivers/gpu/drm/exynos/exynos_drm_dma.c
+++ b/drivers/gpu/drm/exynos/exynos_drm_dma.c
@@ -6,6 +6,7 @@
 
 #include <linux/dma-map-ops.h>
 #include <linux/iommu.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 
 #include <drm/drm_print.h>
@@ -96,11 +97,13 @@ int exynos_drm_register_dma(struct drm_device *drm, struct device *dev,
 			    void **dma_priv)
 {
 	struct exynos_drm_private *priv = drm->dev_private;
+	int ret;
 
 	if (!priv->dma_dev) {
 		priv->dma_dev = dev;
 		DRM_INFO("Exynos DRM: using %s device for DMA mapping operations\n",
 			 dev_name(dev));
+		pr_err("DSH-DISP dma: dma_dev=%s\n", dev_name(dev));
 	}
 
 	if (!IS_ENABLED(CONFIG_EXYNOS_IOMMU))
@@ -112,17 +115,34 @@ int exynos_drm_register_dma(struct drm_device *drm, struct device *dev,
 		if (IS_ENABLED(CONFIG_ARM_DMA_USE_IOMMU))
 			mapping = arm_iommu_create_mapping(&platform_bus_type,
 				EXYNOS_DEV_ADDR_START, EXYNOS_DEV_ADDR_SIZE);
-		else if (IS_ENABLED(CONFIG_IOMMU_DMA))
+		else if (IS_ENABLED(CONFIG_IOMMU_DMA)) {
 			mapping = iommu_get_domain_for_dev(priv->dma_dev);
-		else
+
+			/*
+			 * The device is wired to a SYSMMU in DT but the IOMMU
+			 * provider has not attached a domain yet. Returning 0
+			 * here would permanently cache an IOMMU-less mapping
+			 * and the DECON would keep rejecting non-contiguous
+			 * dma-bufs, so defer until the IOMMU is really up.
+			 */
+			if (!mapping &&
+			    (of_property_present(dev->of_node, "iommus") ||
+			     of_property_present(priv->dma_dev->of_node,
+						 "iommus")))
+				return -EPROBE_DEFER;
+		} else
 			mapping = ERR_PTR(-ENODEV);
 
 		if (IS_ERR(mapping))
 			return PTR_ERR(mapping);
 		priv->mapping = mapping;
+		pr_err("DSH-DISP dma: mapping=%px (domain) from %s\n",
+		       mapping, dev_name(priv->dma_dev));
 	}
 
-	return drm_iommu_attach_device(drm, dev, dma_priv);
+	ret = drm_iommu_attach_device(drm, dev, dma_priv);
+	pr_err("DSH-DISP dma: attach %s ret=%d\n", dev_name(dev), ret);
+	return ret;
 }
 
