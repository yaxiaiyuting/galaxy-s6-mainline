@@ -36,6 +38,22 @@
 #define DRIVER_DESC	"Samsung SoC DRM"
 #define DRIVER_DATE	"20180330"
 
+/*
+ * DSH 2026-10-20: DECON bring-up kill switches for staged validation.
+ * Defaults are the zenlte/upstream behaviour.
+ *
+ *   aperture=0 : keep simpledrm (do not remove the bootloader framebuffer)
+ *   fbdev=0    : skip exynos_drm_fbdev_setup() so the first atomic modeset
+ *                (and thus decon_atomic_enable) only happens when a userspace
+ *                client explicitly does one.
+ */
+bool dsh_disp_aperture = true;
+module_param_named(aperture, dsh_disp_aperture, bool, 0644);
+bool dsh_disp_fbdev = true;
+module_param_named(fbdev, dsh_disp_fbdev, bool, 0644);
+
+#define DSH_DISP_TAG "DSH-DISP"
+
 /*
  * Interface history:
  *
@@ -241,6 +259,25 @@ static int exynos_drm_bind(struct device *dev)
 	unsigned int clone_mask;
 	int ret;
 
+	pr_err(DSH_DISP_TAG " bind: enter (%s), aperture=%d fbdev=%d\n",
+	       dev_name(dev), dsh_disp_aperture, dsh_disp_fbdev);
+
+	/*
+	 * Remove the bootloader's simple-framebuffer (simpledrm) before taking
+	 * over.  Otherwise userspace ends up with two DRM devices/connectors
+	 * (simpledrm + exynos) driving the same panel, which confuses touch
+	 * input mapping and per-monitor scaling.
+	 */
+	if (dsh_disp_aperture) {
+		pr_err(DSH_DISP_TAG " bind: drm_aperture_remove_framebuffers()\n");
+		ret = drm_aperture_remove_framebuffers(&exynos_drm_driver);
+		if (ret)
+			return ret;
+		pr_err(DSH_DISP_TAG " bind: simpledrm removed\n");
+	} else {
+		pr_err(DSH_DISP_TAG " bind: keep simpledrm (aperture=0)\n");
+	}
+
 	drm = drm_dev_alloc(&exynos_drm_driver, dev);
 	if (IS_ERR(drm))
 		return PTR_ERR(drm);
@@ -270,7 +307,9 @@ static int exynos_drm_bind(struct device *dev)
 		encoder->possible_clones = clone_mask;
 
 	/* Try to bind all sub drivers. */
+	pr_err(DSH_DISP_TAG " bind: component_bind_all()...\n");
 	ret = component_bind_all(drm->dev, drm);
+	pr_err(DSH_DISP_TAG " bind: component_bind_all ret=%d\n", ret);
 	if (ret)
 		goto err_mode_config_cleanup;
 
@@ -284,12 +323,20 @@ static int exynos_drm_bind(struct device *dev)
 	drm_kms_helper_poll_init(drm);
 
 	/* register the DRM device */
+	pr_err(DSH_DISP_TAG " bind: drm_dev_register()...\n");
 	ret = drm_dev_register(drm, 0);
+	pr_err(DSH_DISP_TAG " bind: drm_dev_register ret=%d\n", ret);
 	if (ret < 0)
 		goto err_cleanup_poll;
 
-	exynos_drm_fbdev_setup(drm);
+	if (dsh_disp_fbdev) {
+		pr_err(DSH_DISP_TAG " bind: exynos_drm_fbdev_setup()...\n");
+		exynos_drm_fbdev_setup(drm);
+	} else {
+		pr_err(DSH_DISP_TAG " bind: fbdev setup SKIPPED (fbdev=0)\n");
+	}
 
+	pr_err(DSH_DISP_TAG " bind: done\n");
 	return 0;
 
 err_cleanup_poll:
