+/* The G9209 firmware scans ARGB8888 RAM, while Mutter supplies XRGB8888.
+ * The generic helper stages and converts every line before memcpy_toio().
+ * Fuse these operations for this board's Normal-NC/WC framebuffer RAM; the
+ * opaque alpha is still required by the firmware's existing display setup.
+ */
+static bool simpledrm_g9209_blit(struct simpledrm_device *sdev,
+			       const struct iosys_map *dst,
+			       const struct iosys_map *src,
+			       const struct drm_framebuffer *fb,
+			       const struct drm_rect *clip)
+{
+#if defined(CONFIG_ARM64) && !defined(CONFIG_CPU_BIG_ENDIAN)
+	u8 *dst_line;
+	const u8 *src_line;
+	unsigned int y, width = drm_rect_width(clip);
+
+	if (!sdev->g9209_fast_blit || src->is_iomem ||
+	    fb->format->format != DRM_FORMAT_XRGB8888)
+		return false;
+
+	/* simpledrm maps this reserved DRAM using memremap_wc/ioremap_wc,
+	 * which are Normal memory on arm64. This must never target Device MMIO.
+	 */
+	dst_line = dst->is_iomem ? (__force void *)dst->vaddr_iomem : dst->vaddr;
+	src_line = src->vaddr + drm_fb_clip_offset(fb->pitches[0], fb->format, clip);
+	if (((unsigned long)dst_line | (unsigned long)src_line |
+	     sdev->pitch | fb->pitches[0]) & 3)
+		return false;
+
+	for (y = 0; y < drm_rect_height(clip); y++) {
+		simpledrm_g9209_xrgb_to_argb(dst_line, src_line, width);
+		dst_line += sdev->pitch;
+		src_line += fb->pitches[0];
+	}
+	return true;
+#else
+	return false;
+#endif
+}
