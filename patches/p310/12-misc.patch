+extern unsigned long dsh_diag_test_mode;
+
+static void dsh_trace_vt_device(const struct device *dev, unsigned int phase)
+{
+	if (READ_ONCE(dsh_diag_test_mode) == 1 &&
+	    MAJOR(dev->devt) == TTY_MAJOR &&
+	    MINOR(dev->devt) >= 1 && MINOR(dev->devt) <= 63)
+		dsh_mark(0x470000UL | (MINOR(dev->devt) << 8) | phase);
+}
+
 /**
  * device_add - add device to device hierarchy.
  * @dev: device.
@@ -3564,6 +3576,7 @@ int device_add(struct device *dev)
 		glue_dir = kobj;
 		goto Error;
 	}
+	dsh_trace_vt_device(dev, 1);
 
 	/* notify platform of device entry */
 	device_platform_notify(dev);
@@ -3578,6 +3591,7 @@ int device_add(struct device *dev)
 	error = device_add_attrs(dev);
 	if (error)
 		goto AttrsError;
+	dsh_trace_vt_device(dev, 2);
 	error = bus_add_device(dev);
 	if (error)
 		goto BusError;
@@ -3595,7 +3609,9 @@ int device_add(struct device *dev)
 		if (error)
 			goto SysEntryError;
 
+		dsh_trace_vt_device(dev, 3);
 		devtmpfs_create_node(dev);
+		dsh_trace_vt_device(dev, 4);
 	}
 
 	/* Notify clients of device addition.  This call must come
@@ -3637,6 +3653,7 @@ int device_add(struct device *dev)
 
 	sp = class_to_subsys(dev->class);
 	if (sp) {
+		dsh_trace_vt_device(dev, 5);
 		mutex_lock(&sp->mutex);
 		/* tie the class to the device */
 		klist_add_tail(&dev->p->knode_class, &sp->klist_devices);
@@ -3646,6 +3663,7 @@ int device_add(struct device *dev)
 			if (class_intf->add_dev)
 				class_intf->add_dev(dev);
 		mutex_unlock(&sp->mutex);
+		dsh_trace_vt_device(dev, 6);
 		subsys_put(sp);
 	}
 done:
