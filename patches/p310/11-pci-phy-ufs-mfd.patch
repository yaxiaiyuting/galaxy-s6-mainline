diff --git a/drivers/mfd/madera-core.c b/drivers/mfd/madera-core.c
index bdbd5bfc9..bc1e7bb6a 100644
--- a/drivers/mfd/madera-core.c
+++ b/drivers/mfd/madera-core.c
@@ -713,20 +713,57 @@ int madera_dev_init(struct madera *madera)
 		}
 	}
 
-	/* Init 32k clock sourced from MCLK2 */
-	ret = clk_prepare_enable(madera->mclk[MADERA_MCLK2].clk);
-	if (ret) {
-		dev_err(madera->dev, "Failed to enable 32k clock: %d\n", ret);
-		goto err_reset;
-	}
+	/*
+	 * DSH 2026-10-21: 处理「本板没有 MCLK2 (32.768kHz)」的情况。
+	 *
+	 * S6 (zeroflte) 的硬件设计里，WM1840/CS47L85 的 MCLK2 引脚**没有
+	 * 接任何 32.768kHz 时钟源**（vendor DTS 的 wm1840 节点根本没有
+	 * clocks 属性，只有 wlf,reset / wlf,ldoena 两个 GPIO）。
+	 *
+	 * 原驱动无条件 clk_prepare_enable(mclk[MCLK2].clk) —— 当它是一个
+	 * 空 clock 时返回错误，然后 goto err_reset，导致：
+	 *   "Polling BOOT_DONE_STS timed out" → probe 失败 -110
+	 * 实测 dmesg:
+	 *   madera spi1.0: Missing MCLK2, requires 32kHz clock
+	 *   madera spi1.0: Polling BOOT_DONE_STS timed out
+	 *   madera: probe of spi1.0 failed with error -110
+	 *
+	 * 修法：MCLK2 不存在时把 CLK_32K_SRC 设成 2 (NONE) —— 这正是
+	 * mainline arizona-core.c 对 ARIZONA_32KZ_NONE 的做法
+	 * （arizona-core.c:1302-1305），说明硬件本身支持无 32k 运行。
+	 */
+	if (!madera->mclk[MADERA_MCLK2].clk) {
+		dev_info(madera->dev,
+			 "no MCLK2 32k clock, using CLK_32K_SRC=NONE\n");
+		ret = regmap_update_bits(madera->regmap,
+				MADERA_CLOCK_32K_1,
+				MADERA_CLK_32K_ENA_MASK |
+				MADERA_CLK_32K_SRC_MASK,
+				0 /* ENA=0, SRC=2 (NONE) */ | 2);
+		if (ret) {
+			dev_err(madera->dev,
+				"Failed to init 32k clock: %d\n", ret);
+			goto err_reset;
+		}
+	} else {
+		/* Init 32k clock sourced from MCLK2 */
+		ret = clk_prepare_enable(madera->mclk[MADERA_MCLK2].clk);
+		if (ret) {
+			dev_err(madera->dev,
+				"Failed to enable 32k clock: %d\n", ret);
+			goto err_reset;
+		}
 
-	ret = regmap_update_bits(madera->regmap,
-			MADERA_CLOCK_32K_1,
-			MADERA_CLK_32K_ENA_MASK | MADERA_CLK_32K_SRC_MASK,
-			MADERA_CLK_32K_ENA | MADERA_32KZ_MCLK2);
-	if (ret) {
-		dev_err(madera->dev, "Failed to init 32k clock: %d\n", ret);
-		goto err_clock;
+		ret = regmap_update_bits(madera->regmap,
+				MADERA_CLOCK_32K_1,
+				MADERA_CLK_32K_ENA_MASK |
+				MADERA_CLK_32K_SRC_MASK,
+				MADERA_CLK_32K_ENA | MADERA_32KZ_MCLK2);
+		if (ret) {
+			dev_err(madera->dev,
+				"Failed to init 32k clock: %d\n", ret);
+			goto err_clock;
+		}
 	}
 
 	pm_runtime_set_active(madera->dev);
