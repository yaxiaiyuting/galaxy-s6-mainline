diff --git a/drivers/pci/controller/dwc/pci-exynos7420.c b/drivers/pci/controller/dwc/pci-exynos7420.c
new file mode 100644
index 000000000..6890ad152
--- /dev/null
+++ b/drivers/pci/controller/dwc/pci-exynos7420.c
@@ -0,0 +1,701 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * PCIe host controller driver for Samsung Exynos7420
+ *
+ * The Exynos7420 PCIe root complex is built around a Synopsys DesignWare
+ * core, but it differs from the Exynos5433 variant in several ways:
+ *
+ *  - the PHY is a "combo" PHY programmed with a fixed register sequence
+ *    (taken from the Samsung 3.10 BSP, pci-exynos7420_cal.c); the PHY
+ *    reference clock/reset controls live in a SYSREG block and in the
+ *    ELBI register space,
+ *  - all PCIe clock gates live in CMU_FSYS1 (there is no per-clock CCF
+ *    binding for them in mainline yet),
+ *  - the DBI register space must be accessed while APP_REQ_EXIT_L1 is
+ *    forced and APP_REQ_EXIT_L1_MODE is switched to software mode.
+ *
+ * The controller is used for the WiFi channel (pcie1, bus address
+ * 0x157b0000) on SM-G9209/G920F/G925F class boards; the same IP is also
+ * used for the external modem channel (pcie0) on some variants.
+ *
+ * Register layout and sequences are derived from the Samsung universal7420
+ * 3.10 BSP (drivers/pci/host/pci-exynos.c, pci-exynos7420.c,
+ * pci-exynos7420_cal.c) and from the zenlte mainline 6.6 port.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/interrupt.h>
+#include <linux/irqreturn.h>
+#include <linux/kernel.h>
+#include <linux/mod_devicetable.h>
+#include <linux/of.h>
+#include <linux/module.h>
+#include <linux/pci.h>
+#include <linux/platform_device.h>
+
+#include "pcie-designware.h"
+
+/* PCIe ELBI registers */
+#define EXYNOS7420_PCIE_IRQ_PULSE		0x000
+#define EXYNOS7420_PCIE_IRQ_LEVEL		0x004
+#define EXYNOS7420_PCIE_IRQ_SPECIAL		0x008
+#define EXYNOS7420_PCIE_IRQ_EN_PULSE		0x00c
+#define EXYNOS7420_PCIE_IRQ_EN_LEVEL		0x010
+#define EXYNOS7420_PCIE_IRQ_EN_SPECIAL		0x014
+#define EXYNOS7420_PCIE_SW_WAKE			0x018
+#define EXYNOS7420_PCIE_BUS_EN			BIT(1)
+#define EXYNOS7420_PCIE_APP_LTSSM_ENABLE	0x02c
+#define EXYNOS7420_PCIE_L1_BUG_FIX_ENABLE	0x038
+#define EXYNOS7420_PCIE_APP_REQ_EXIT_L1		0x040
+#define EXYNOS7420_PCIE_ELBI_RDLH_LINKUP	0x074
+#define EXYNOS7420_PCIE_ELBI_XMLH_LINKUP	BIT(4)
+#define EXYNOS7420_PCIE_CORE_RESETN_DISABLE	0x0f0
+#define EXYNOS7420_PCIE_APP_REQ_EXIT_L1_MODE	0x0f4
+#define EXYNOS7420_PCIE_ELBI_SLV_AWMISC		0x11c
+#define EXYNOS7420_PCIE_ELBI_SLV_ARMISC		0x120
+#define EXYNOS7420_PCIE_ELBI_SLV_DBI_ENABLE	BIT(21)
+
+/* PHY PCS/PMA reset registers, accessed through the ELBI window */
+#define EXYNOS7420_PCIE_PCS_G_RST		0x130
+#define EXYNOS7420_PCIE_PMA_INIT_RST		0x134
+
+/* ELBI interrupt bits */
+#define EXYNOS7420_PCIE_IRQ_INTA_ASSERT		BIT(0)
+#define EXYNOS7420_PCIE_IRQ_INTB_ASSERT		BIT(2)
+#define EXYNOS7420_PCIE_IRQ_INTC_ASSERT		BIT(4)
+#define EXYNOS7420_PCIE_IRQ_INTD_ASSERT		BIT(6)
+#define EXYNOS7420_PCIE_IRQ_MSI_ENABLE		BIT(1)
+#define EXYNOS7420_PCIE_IRQ_LINKDOWN_ENABLE	BIT(4)
+#define EXYNOS7420_PCIE_IRQ_LINK_DOWN		BIT(2)
+
+#define EXYNOS7420_PCIE_ELBI_LTSSM_ENABLE	0x1
+
+/* SYSREG PCIe PHY controls (offset inside the mapped "block" register) */
+#define EXYNOS7420_PCIE_SYSREG_REFCLK_MASK	(0x3 << 4)
+#define EXYNOS7420_PCIE_SYSREG_PHY_CTRL_MASK	(0x3 << 2)
+#define EXYNOS7420_PCIE_SYSREG_PHY_CTRL_VAL	BIT(2)
+#define EXYNOS7420_PCIE_SYSREG_CMN_RST		BIT(7)
+#define EXYNOS7420_PCIE_SYSREG_CMN_RST_TIME_US	20
+
+/* CMU_FSYS1 register offsets (all PCIe gates live in this block) */
+#define EXYNOS7420_FSYS1_ENABLE_ACLK		0x0800
+#define EXYNOS7420_FSYS1_ENABLE_PCLK		0x0900
+#define EXYNOS7420_FSYS1_ENABLE_SCLK11		0x0a04
+#define EXYNOS7420_FSYS1_ENABLE_SCLK12		0x0a08
+#define EXYNOS7420_FSYS1_ENABLE_SCLK13		0x0a0c
+
+/* PCIe WiFi1/ch1 gates, see the Samsung 3.10 clk-exynos7420.c tables */
+#define EXYNOS7420_FSYS1_PCIE_ACLK_GATES	(BIT(9) | BIT(10) | BIT(11) | \
+						 BIT(12) | BIT(13) | BIT(17) | \
+						 BIT(18) | BIT(20) | BIT(21) | \
+						 BIT(24))
+#define EXYNOS7420_FSYS1_PCIE_PCLK_GATES	(BIT(22) | BIT(26) | BIT(27) | \
+						 BIT(28) | BIT(29) | BIT(31))
+#define EXYNOS7420_FSYS1_PCIE_SCLK11_GATES	(BIT(0) | BIT(8) | BIT(12) | \
+						 BIT(16))
+#define EXYNOS7420_FSYS1_PCIE_SCLK12_GATES	(BIT(8) | BIT(12))
+#define EXYNOS7420_FSYS1_PCIE_SCLK13_GATES	BIT(28)
+
+/* CMU Q-channel force-on register (CMU_FSYS1 + 0xf00), bit 0 */
+#define EXYNOS7420_PCIE_QCH_FORCE_ON		BIT(0)
+
+/* PMU PCIE PHY power control register, bit 0 */
+#define EXYNOS7420_PCIE_PMU_PHY_CONTROL		BIT(0)
+
+/* PHY register offsets (word index) used by the power up/down sequences */
+#define EXYNOS7420_PCIE_PHY_PWR_CTRL		(0x15 * 4)
+#define EXYNOS7420_PCIE_PHY_ALL_PWR_DOWN	(0xf << 3)
+#define EXYNOS7420_PCIE_PHY_PMA_CTRL0		(0x4e * 4)
+#define EXYNOS7420_PCIE_PHY_PMA_CTRL1		(0x4f * 4)
+
+#define EXYNOS7420_PCIE_LINKUP_TIMEOUT_US	100000
+#define EXYNOS7420_PCIE_PERST_DELAY_US		20000
+#define EXYNOS7420_PCIE_PWR_ON_DELAY_MS		100
+
+/**
+ * struct exynos7420_pcie - Exynos7420 PCIe RC private data
+ * @pci: DesignWare PCIe core
+ * @elbi_base: ELBI (link/interrupt) registers
+ * @phy_base: combo PHY registers
+ * @block_base: SYSREG block holding PHY refclk/reset controls
+ * @pmu_base: PMU PCIE_PHY_CONTROL register
+ * @cmu_base: CMU Q-channel force-on register
+ * @phy_pcs_base: PHY PCS control register
+ * @gates_base: CMU_FSYS1 gate registers
+ * @perst_gpio: PERST# (active low)
+ * @wl_en_gpio: WL_REG_ON / WLAN_EN
+ * @dbi_lock: serializes the DBI access dance
+ * @skip_phy_sysreg: board workaround, do not touch the SYSREG block
+ * @skip_phy_pcs: board workaround, do not touch the PHY PCS register
+ */
+struct exynos7420_pcie {
+	struct dw_pcie pci;
+	void __iomem *elbi_base;
+	void __iomem *phy_base;
+	void __iomem *block_base;
+	void __iomem *pmu_base;
+	void __iomem *cmu_base;
+	void __iomem *phy_pcs_base;
+	void __iomem *gates_base;
+	struct gpio_desc *perst_gpio;
+	struct gpio_desc *wl_en_gpio;
+	raw_spinlock_t dbi_lock;
+	bool skip_phy_sysreg;
+	bool skip_phy_pcs;
+};
+
+static inline struct exynos7420_pcie *to_exynos7420_pcie(struct dw_pcie *pci)
+{
+	return container_of(pci, struct exynos7420_pcie, pci);
+}
+
+/* ------------------------------------------------------------------ */
+/* DBI access                                                          */
+/* ------------------------------------------------------------------ */
+
+/*
+ * The DBI register space is only reachable while the L1 exit request is
+ * forced and the L1 exit mode is switched to software.  The Samsung BSP
+ * does this around every single DBI access for this SoC; mirror that.
+ */
+static void exynos7420_pcie_dbi_prepare(struct exynos7420_pcie *ep, bool on)
+{
+	if (on) {
+		writel(1, ep->elbi_base + EXYNOS7420_PCIE_APP_REQ_EXIT_L1);
+		writel(0, ep->elbi_base +
+		       EXYNOS7420_PCIE_APP_REQ_EXIT_L1_MODE);
+	} else {
+		writel(1, ep->elbi_base +
+		       EXYNOS7420_PCIE_APP_REQ_EXIT_L1_MODE);
+		writel(0, ep->elbi_base + EXYNOS7420_PCIE_APP_REQ_EXIT_L1);
+	}
+}
+
+static u32 exynos7420_pcie_read_dbi(struct dw_pcie *pci, void __iomem *base,
+				    u32 reg, size_t size)
+{
+	struct exynos7420_pcie *ep = to_exynos7420_pcie(pci);
+	unsigned long flags;
+	u32 val = 0;
+
+	raw_spin_lock_irqsave(&ep->dbi_lock, flags);
+	exynos7420_pcie_dbi_prepare(ep, true);
+	dw_pcie_read(base + reg, size, &val);
+	exynos7420_pcie_dbi_prepare(ep, false);
+	raw_spin_unlock_irqrestore(&ep->dbi_lock, flags);
+
+	return val;
+}
+
+static void exynos7420_pcie_write_dbi(struct dw_pcie *pci, void __iomem *base,
+				      u32 reg, size_t size, u32 val)
+{
+	struct exynos7420_pcie *ep = to_exynos7420_pcie(pci);
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&ep->dbi_lock, flags);
+	exynos7420_pcie_dbi_prepare(ep, true);
+	dw_pcie_write(base + reg, size, val);
+	exynos7420_pcie_dbi_prepare(ep, false);
+	raw_spin_unlock_irqrestore(&ep->dbi_lock, flags);
+}
+
+static int exynos7420_pcie_rd_own_conf(struct pci_bus *bus, unsigned int devfn,
+				       int where, int size, u32 *val)
+{
+	struct dw_pcie *pci = to_dw_pcie_from_pp(bus->sysdata);
+
+	if (PCI_SLOT(devfn))
+		return PCIBIOS_DEVICE_NOT_FOUND;
+
+	*val = dw_pcie_read_dbi(pci, where, size);
+
+	return PCIBIOS_SUCCESSFUL;
+}
+
+static int exynos7420_pcie_wr_own_conf(struct pci_bus *bus, unsigned int devfn,
+				       int where, int size, u32 val)
+{
+	struct dw_pcie *pci = to_dw_pcie_from_pp(bus->sysdata);
+
+	if (PCI_SLOT(devfn))
+		return PCIBIOS_DEVICE_NOT_FOUND;
+
+	dw_pcie_write_dbi(pci, where, size, val);
+
+	return PCIBIOS_SUCCESSFUL;
+}
+
+static struct pci_ops exynos7420_pci_ops = {
+	.read = exynos7420_pcie_rd_own_conf,
+	.write = exynos7420_pcie_wr_own_conf,
+};
+
+/* ------------------------------------------------------------------ */
+/* Link handling                                                       */
+/* ------------------------------------------------------------------ */
+
+static int exynos7420_pcie_link_up(struct dw_pcie *pci)
+{
+	struct exynos7420_pcie *ep = to_exynos7420_pcie(pci);
+	u32 val;
+
+	val = readl(ep->elbi_base + EXYNOS7420_PCIE_ELBI_RDLH_LINKUP) & 0x1f;
+
+	return val >= 0x0d && val <= 0x15;
+}
+
+static int exynos7420_pcie_start_link(struct dw_pcie *pci)
+{
+	struct exynos7420_pcie *ep = to_exynos7420_pcie(pci);
+
+	dev_info(pci->dev, "starting LTSSM\n");
+	writel(EXYNOS7420_PCIE_ELBI_LTSSM_ENABLE,
+	       ep->elbi_base + EXYNOS7420_PCIE_APP_LTSSM_ENABLE);
+
+	return 0;
+}
+
+static void exynos7420_pcie_stop_link(struct dw_pcie *pci)
+{
+	struct exynos7420_pcie *ep = to_exynos7420_pcie(pci);
+
+	writel(0, ep->elbi_base + EXYNOS7420_PCIE_APP_LTSSM_ENABLE);
+}
+
+/* ------------------------------------------------------------------ */
+/* Clock gates / power                                                 */
+/* ------------------------------------------------------------------ */
+
+static void exynos7420_pcie_gates_set(struct exynos7420_pcie *ep, bool on)
+{
+	void __iomem *g = ep->gates_base;
+	u32 val;
+
+	if (!g)
+		return;
+
+	/* aclk gates */
+	val = readl(g + EXYNOS7420_FSYS1_ENABLE_ACLK);
+	if (on)
+		val |= EXYNOS7420_FSYS1_PCIE_ACLK_GATES;
+	else
+		val &= ~EXYNOS7420_FSYS1_PCIE_ACLK_GATES;
+	writel(val, g + EXYNOS7420_FSYS1_ENABLE_ACLK);
+
+	/* pclk gates */
+	val = readl(g + EXYNOS7420_FSYS1_ENABLE_PCLK);
+	if (on)
+		val |= EXYNOS7420_FSYS1_PCIE_PCLK_GATES;
+	else
+		val &= ~EXYNOS7420_FSYS1_PCIE_PCLK_GATES;
+	writel(val, g + EXYNOS7420_FSYS1_ENABLE_PCLK);
+
+	/* sclk gates: PHY refclk, PCIe link, TLX400 */
+	val = readl(g + EXYNOS7420_FSYS1_ENABLE_SCLK11);
+	if (on)
+		val |= EXYNOS7420_FSYS1_PCIE_SCLK11_GATES;
+	else
+		val &= ~EXYNOS7420_FSYS1_PCIE_SCLK11_GATES;
+	writel(val, g + EXYNOS7420_FSYS1_ENABLE_SCLK11);
+
+	/* sclk gates: PHY TX0/RX0 symbol clocks */
+	val = readl(g + EXYNOS7420_FSYS1_ENABLE_SCLK12);
+	if (on)
+		val |= EXYNOS7420_FSYS1_PCIE_SCLK12_GATES;
+	else
+		val &= ~EXYNOS7420_FSYS1_PCIE_SCLK12_GATES;
+	writel(val, g + EXYNOS7420_FSYS1_ENABLE_SCLK12);
+
+	/* sclk gates: combo PHY 26 MHz */
+	val = readl(g + EXYNOS7420_FSYS1_ENABLE_SCLK13);
+	if (on)
+		val |= EXYNOS7420_FSYS1_PCIE_SCLK13_GATES;
+	else
+		val &= ~EXYNOS7420_FSYS1_PCIE_SCLK13_GATES;
+	writel(val, g + EXYNOS7420_FSYS1_ENABLE_SCLK13);
+
+	dev_info(ep->pci.dev, "PCIe clock gates %s\n", on ? "enabled" : "disabled");
+}
+
+static void exynos7420_pcie_pmu_power(struct exynos7420_pcie *ep, bool on)
+{
+	u32 val;
+
+	if (!ep->pmu_base)
+		return;
+
+	val = readl(ep->pmu_base);
+	if (on)
+		val |= EXYNOS7420_PCIE_PMU_PHY_CONTROL;
+	else
+		val &= ~EXYNOS7420_PCIE_PMU_PHY_CONTROL;
+	writel(val, ep->pmu_base);
+}
+
+static void exynos7420_pcie_phy_all_power_down(struct exynos7420_pcie *ep,
+					       bool enable)
+{
+	u32 val;
+
+	/* PHY all power down: PWR_CTRL bits 3..6 and the PMA control words */
+	val = readl(ep->phy_base + EXYNOS7420_PCIE_PHY_PWR_CTRL);
+	if (enable)
+		val |= EXYNOS7420_PCIE_PHY_ALL_PWR_DOWN;
+	else
+		val &= ~EXYNOS7420_PCIE_PHY_ALL_PWR_DOWN;
+	writel(val, ep->phy_base + EXYNOS7420_PCIE_PHY_PWR_CTRL);
+
+	writel(enable ? 0xff : 0x00, ep->phy_base + EXYNOS7420_PCIE_PHY_PMA_CTRL0);
+	writel(enable ? 0x3f : 0x00, ep->phy_base + EXYNOS7420_PCIE_PHY_PMA_CTRL1);
+}
+
+/* ------------------------------------------------------------------ */
+/* Combo PHY configuration (Samsung CAL sequence, 26 MHz reference)    */
+/* ------------------------------------------------------------------ */
+
+static const u32 exynos7420_pcie_phy_cmn_cfg[26] = {
+	0x01, 0x0f, 0xa6, 0x71, 0x90, 0x62, 0x20, 0x00, 0x00, 0xa7, 0x0a,
+	0x37, 0x20, 0x08, 0xef, 0xfc, 0x96, 0x14, 0x00, 0x10, 0x68, 0x01,
+	0x00, 0x00, 0x04, 0x20,
+};
+
+static const u32 exynos7420_pcie_phy_trsv_cfg[41] = {
+	0x31, 0xf4, 0xf4, 0x80, 0x25, 0x40, 0xc0, 0x03, 0x35, 0x55, 0x4c,
+	0xc3, 0x10, 0x54, 0x70, 0xc5, 0x00, 0x2f, 0x44, 0xa4, 0x00, 0x3b,
+	0x34, 0xa7, 0x64, 0x00, 0x1f, 0x83, 0x1b, 0x01, 0xe0, 0x00, 0x00,
+	0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x1d, 0x00,
+};
+
+static void exynos7420_pcie_phy_config(struct exynos7420_pcie *ep)
+{
+	void __iomem *phy = ep->phy_base;
+	void __iomem *block = ep->block_base;
+	unsigned int i;
+	u32 val;
+
+	if (block && !ep->skip_phy_sysreg) {
+		/* select the proper PHY reference clock source */
+		val = readl(block);
+		writel(val & ~EXYNOS7420_PCIE_SYSREG_REFCLK_MASK, block);
+		val = readl(block);
+		writel((val & ~EXYNOS7420_PCIE_SYSREG_PHY_CTRL_MASK) |
+		       EXYNOS7420_PCIE_SYSREG_PHY_CTRL_VAL, block);
+	}
+
+	/* PCS/PMA initialisation resets, via the ELBI window */
+	writel(1, ep->elbi_base + EXYNOS7420_PCIE_PCS_G_RST);
+	udelay(10);
+	writel(0, ep->elbi_base + EXYNOS7420_PCIE_PCS_G_RST);
+	udelay(10);
+
+	writel(1, ep->elbi_base + EXYNOS7420_PCIE_PMA_INIT_RST);
+	udelay(10);
+	writel(0, ep->elbi_base + EXYNOS7420_PCIE_PMA_INIT_RST);
+	udelay(10);
+
+	/* PHY common block */
+	for (i = 0; i < ARRAY_SIZE(exynos7420_pcie_phy_cmn_cfg); i++)
+		writel(exynos7420_pcie_phy_cmn_cfg[i], phy + i * 4);
+
+	/* PHY transceiver/receiver block */
+	for (i = 0; i < ARRAY_SIZE(exynos7420_pcie_phy_trsv_cfg); i++)
+		writel(exynos7420_pcie_phy_trsv_cfg[i], phy + (0x30 + i) * 4);
+
+	if (ep->phy_pcs_base && !ep->skip_phy_pcs)
+		writel(0x2, ep->phy_pcs_base);
+
+	if (block && !ep->skip_phy_sysreg) {
+		/* PHY common block reset pulse */
+		val = readl(block);
+		writel(val & ~EXYNOS7420_PCIE_SYSREG_CMN_RST, block);
+		val = readl(block);
+		writel(val | EXYNOS7420_PCIE_SYSREG_CMN_RST, block);
+		udelay(EXYNOS7420_PCIE_SYSREG_CMN_RST_TIME_US);
+		val = readl(block);
+		writel(val & ~EXYNOS7420_PCIE_SYSREG_CMN_RST, block);
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* Interrupts (legacy INTx pulse + DesignWare MSI)                     */
+/* ------------------------------------------------------------------ */
+
+static irqreturn_t exynos7420_pcie_irq_handler(int irq, void *arg)
+{
+	struct exynos7420_pcie *ep = arg;
+	struct dw_pcie_rp *pp = &ep->pci.pp;
+	u32 val;
+
+	val = readl(ep->elbi_base + EXYNOS7420_PCIE_IRQ_PULSE);
+	writel(val, ep->elbi_base + EXYNOS7420_PCIE_IRQ_PULSE);
+
+	val = readl(ep->elbi_base + EXYNOS7420_PCIE_IRQ_LEVEL);
+	writel(val, ep->elbi_base + EXYNOS7420_PCIE_IRQ_LEVEL);
+
+	val = readl(ep->elbi_base + EXYNOS7420_PCIE_IRQ_SPECIAL);
+	if (val & EXYNOS7420_PCIE_IRQ_LINK_DOWN)
+		dev_info_ratelimited(ep->pci.dev, "PCIe link down event\n");
+	writel(val, ep->elbi_base + EXYNOS7420_PCIE_IRQ_SPECIAL);
+
+#ifdef CONFIG_PCI_MSI
+	if (pp->has_msi_ctrl && pp->irq_domain)
+		dw_handle_msi_irq(pp);
+#endif
+
+	return IRQ_HANDLED;
+}
+
+/* ------------------------------------------------------------------ */
+/* Host init                                                           */
+/* ------------------------------------------------------------------ */
+
+static int exynos7420_pcie_host_init(struct dw_pcie_rp *pp)
+{
+	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
+	struct exynos7420_pcie *ep = to_exynos7420_pcie(pci);
+	u32 val;
+
+	dev_info(pci->dev, "host init: releasing PERST\n");
+	gpiod_set_value_cansleep(ep->perst_gpio, 0); /* deassert (active low) */
+	usleep_range(EXYNOS7420_PCIE_PERST_DELAY_US,
+		     EXYNOS7420_PCIE_PERST_DELAY_US + 2000);
+
+	/* APP_REQ_EXIT_L1_MODE = HW mode, core resetn disable, Q-channel on */
+	writel(1, ep->elbi_base + EXYNOS7420_PCIE_APP_REQ_EXIT_L1_MODE);
+	writel(1, ep->elbi_base + EXYNOS7420_PCIE_CORE_RESETN_DISABLE);
+	if (ep->cmu_base)
+		writel(readl(ep->cmu_base) | EXYNOS7420_PCIE_QCH_FORCE_ON,
+		       ep->cmu_base);
+
+	dev_info(pci->dev, "host init: configuring combo PHY\n");
+	exynos7420_pcie_phy_config(ep);
+	dev_info(pci->dev, "host init: combo PHY configured\n");
+
+	writel(1, ep->elbi_base + EXYNOS7420_PCIE_L1_BUG_FIX_ENABLE);
+
+	/* bus number enable (clear BUS_EN) */
+	val = readl(ep->elbi_base + EXYNOS7420_PCIE_SW_WAKE);
+	writel(val & ~EXYNOS7420_PCIE_BUS_EN,
+	       ep->elbi_base + EXYNOS7420_PCIE_SW_WAKE);
+
+	/* quiesce legacy INTx, enable the MSI interrupt source */
+	writel(0, ep->elbi_base + EXYNOS7420_PCIE_IRQ_EN_PULSE);
+	writel(EXYNOS7420_PCIE_IRQ_MSI_ENABLE,
+	       ep->elbi_base + EXYNOS7420_PCIE_IRQ_EN_LEVEL);
+	writel(0, ep->elbi_base + EXYNOS7420_PCIE_IRQ_EN_SPECIAL);
+
+	/* hand over the root bus config access to the DBI dance helpers */
+	pp->bridge->ops = &exynos7420_pci_ops;
+
+	return 0;
+}
+
+static const struct dw_pcie_host_ops exynos7420_pcie_host_ops = {
+	.host_init = exynos7420_pcie_host_init,
+};
+
+static const struct dw_pcie_ops exynos7420_dw_pcie_ops = {
+	.read_dbi = exynos7420_pcie_read_dbi,
+	.write_dbi = exynos7420_pcie_write_dbi,
+	.link_up = exynos7420_pcie_link_up,
+	.start_link = exynos7420_pcie_start_link,
+	.stop_link = exynos7420_pcie_stop_link,
+};
+
+/* ------------------------------------------------------------------ */
+/* Probe / remove                                                      */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Map a register block without reserving the memory region.  Some of the
+ * PCIe registers (e.g. the PMU PHY control word) live inside blocks that
+ * are already claimed by another device (the Exynos PMU syscon), so
+ * devm_ioremap_resource() would fail with -EBUSY.
+ */
+static void __iomem *exynos7420_pcie_ioremap_optional(struct platform_device *pdev,
+						      const char *name)
+{
+	struct resource *res;
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, name);
+	if (!res)
+		return NULL;
+
+	return devm_ioremap(&pdev->dev, res->start, resource_size(res));
+}
+
+static int exynos7420_pcie_get_resources(struct exynos7420_pcie *ep,
+					 struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+
+	ep->elbi_base = exynos7420_pcie_ioremap_optional(pdev, "elbi");
+	if (!ep->elbi_base)
+		return -ENODEV;
+	if (IS_ERR(ep->elbi_base))
+		return PTR_ERR(ep->elbi_base);
+
+	ep->phy_base = exynos7420_pcie_ioremap_optional(pdev, "phy");
+	if (!ep->phy_base)
+		return -ENODEV;
+	if (IS_ERR(ep->phy_base))
+		return PTR_ERR(ep->phy_base);
+
+	ep->block_base = exynos7420_pcie_ioremap_optional(pdev, "block");
+	if (IS_ERR(ep->block_base))
+		return PTR_ERR(ep->block_base);
+
+	ep->cmu_base = exynos7420_pcie_ioremap_optional(pdev, "cmu");
+	if (IS_ERR(ep->cmu_base))
+		return PTR_ERR(ep->cmu_base);
+
+	ep->phy_pcs_base = exynos7420_pcie_ioremap_optional(pdev, "phy_pcs");
+	if (IS_ERR(ep->phy_pcs_base))
+		return PTR_ERR(ep->phy_pcs_base);
+
+	ep->pmu_base = exynos7420_pcie_ioremap_optional(pdev, "pmu");
+	if (IS_ERR(ep->pmu_base))
+		return PTR_ERR(ep->pmu_base);
+
+	ep->gates_base = exynos7420_pcie_ioremap_optional(pdev, "gates");
+	if (IS_ERR(ep->gates_base))
+		return PTR_ERR(ep->gates_base);
+
+	dev_dbg(dev, "all Exynos7420 PCIe register blocks mapped\n");
+
+	return 0;
+}
+
+static int exynos7420_pcie_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct exynos7420_pcie *ep;
+	struct dw_pcie *pci;
+	struct dw_pcie_rp *pp;
+	int irq;
+	int ret;
+
+	ep = devm_kzalloc(dev, sizeof(*ep), GFP_KERNEL);
+	if (!ep)
+		return -ENOMEM;
+
+	pci = &ep->pci;
+	pci->dev = dev;
+	pci->ops = &exynos7420_dw_pcie_ops;
+	pp = &pci->pp;
+	pp->ops = &exynos7420_pcie_host_ops;
+	raw_spin_lock_init(&ep->dbi_lock);
+
+	ep->skip_phy_sysreg = of_property_read_bool(dev->of_node,
+						    "samsung,skip-phy-sysreg");
+	ep->skip_phy_pcs = of_property_read_bool(dev->of_node,
+						 "samsung,skip-phy-pcs");
+
+	ret = exynos7420_pcie_get_resources(ep, pdev);
+	if (ret)
+		return ret;
+
+	ep->perst_gpio = devm_gpiod_get_optional(dev, "perst", GPIOD_OUT_HIGH);
+	if (IS_ERR(ep->perst_gpio))
+		return dev_err_probe(dev, PTR_ERR(ep->perst_gpio),
+				     "failed to get PERST gpio\n");
+
+	ep->wl_en_gpio = devm_gpiod_get_optional(dev, "wl-en", GPIOD_OUT_LOW);
+	if (IS_ERR(ep->wl_en_gpio))
+		return dev_err_probe(dev, PTR_ERR(ep->wl_en_gpio),
+				     "failed to get WL_EN gpio\n");
+
+	/* External interrupt shared by MSI and the legacy INTx lines */
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	/*
+	 * Order matters: the controller/PHY blocks only answer on the bus once
+	 * their CMU_FSYS1 gates are running and the PHY is powered, so enable
+	 * those before touching any PCIe register.  The Samsung BSP does the
+	 * same in exynos_pcie_poweron().
+	 */
+	dev_info(dev, "powering on WiFi module\n");
+	exynos7420_pcie_gates_set(ep, true);
+	if (ep->wl_en_gpio) {
+		gpiod_set_value_cansleep(ep->wl_en_gpio, 1);
+		msleep(EXYNOS7420_PCIE_PWR_ON_DELAY_MS);
+	}
+	exynos7420_pcie_pmu_power(ep, true);
+	exynos7420_pcie_phy_all_power_down(ep, false);
+
+	/* Make sure no stale interrupt condition is pending */
+	writel(readl(ep->elbi_base + EXYNOS7420_PCIE_IRQ_PULSE),
+	       ep->elbi_base + EXYNOS7420_PCIE_IRQ_PULSE);
+	writel(readl(ep->elbi_base + EXYNOS7420_PCIE_IRQ_LEVEL),
+	       ep->elbi_base + EXYNOS7420_PCIE_IRQ_LEVEL);
+	writel(readl(ep->elbi_base + EXYNOS7420_PCIE_IRQ_SPECIAL),
+	       ep->elbi_base + EXYNOS7420_PCIE_IRQ_SPECIAL);
+	writel(0, ep->elbi_base + EXYNOS7420_PCIE_IRQ_EN_PULSE);
+	writel(0, ep->elbi_base + EXYNOS7420_PCIE_IRQ_EN_LEVEL);
+	writel(0, ep->elbi_base + EXYNOS7420_PCIE_IRQ_EN_SPECIAL);
+
+	ret = devm_request_irq(dev, irq, exynos7420_pcie_irq_handler,
+			       IRQF_SHARED, "exynos7420-pcie", ep);
+	if (ret)
+		goto err_power_off;
+
+	/* No chained MSI handler: the ELBI IRQ handler dispatches MSI itself */
+	pp->msi_irq[0] = -ENODEV;
+
+	ret = dw_pcie_host_init(pp);
+	if (ret) {
+		dev_err(dev, "failed to initialize PCIe host (%d)\n", ret);
+		goto err_power_off;
+	}
+
+	platform_set_drvdata(pdev, ep);
+	dev_info(dev, "exynos7420 PCIe host ready\n");
+
+	return 0;
+
+err_power_off:
+	exynos7420_pcie_phy_all_power_down(ep, true);
+	exynos7420_pcie_pmu_power(ep, false);
+	if (ep->wl_en_gpio)
+		gpiod_set_value_cansleep(ep->wl_en_gpio, 0);
+	exynos7420_pcie_gates_set(ep, false);
+	return ret;
+}
+
+static int exynos7420_pcie_remove(struct platform_device *pdev)
+{
+	struct exynos7420_pcie *ep = platform_get_drvdata(pdev);
+
+	dw_pcie_host_deinit(&ep->pci.pp);
+	gpiod_set_value_cansleep(ep->perst_gpio, 1); /* assert reset */
+	exynos7420_pcie_phy_all_power_down(ep, true);
+	exynos7420_pcie_pmu_power(ep, false);
+	if (ep->wl_en_gpio)
+		gpiod_set_value_cansleep(ep->wl_en_gpio, 0);
+	exynos7420_pcie_gates_set(ep, false);
+
+	return 0;
+}
+
+static const struct of_device_id exynos7420_pcie_of_match[] = {
+	{ .compatible = "samsung,exynos7420-pcie" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, exynos7420_pcie_of_match);
+
+static struct platform_driver exynos7420_pcie_driver = {
+	.probe = exynos7420_pcie_probe,
+	.remove = exynos7420_pcie_remove,
+	.driver = {
+		.name = "exynos7420-pcie",
+		.of_match_table = exynos7420_pcie_of_match,
+	},
+};
+module_platform_driver(exynos7420_pcie_driver);
+
+MODULE_DESCRIPTION("Samsung Exynos7420 PCIe host controller driver");
+MODULE_LICENSE("GPL v2");
