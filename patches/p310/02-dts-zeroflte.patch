+	 * 这条总线上还能摸到（在某些 boot 状态下）MAX77838 的 0x60，
+	 * 但 mainline 实测只有 0x59 稳定 ACK。
+	 */
+	i2c_max77838: i2c-s2mpb02 {
+		compatible = "i2c-gpio";
+		sda-gpios = <&gpg3 2 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&gpg3 3 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <5>;
+		i2c-gpio,timeout-ms = <100>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		status = "okay";
