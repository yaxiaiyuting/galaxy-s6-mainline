diff --git a/arch/arm64/boot/dts/exynos/exynos7420-zeroflte.dts b/arch/arm64/boot/dts/exynos/exynos7420-zeroflte.dts
--- a/arch/arm64/boot/dts/exynos/exynos7420-zeroflte.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7420-zeroflte.dts
@@ -388,16 +388,34 @@
  *     （现有 s2mpb02/s2mps15 的 i2c-gpio 就在同一 bank 的 gpg3 上工作）。
  *   - IRQ = gpa0-0，低有效、下降沿（vendor request_threaded_irq 用
  *     IRQF_TRIGGER_FALLING）。
- *   - 核心电源 vtouch_3.3v = S2MPS15 LDO21。原厂 DTS 标
- *     `regulator-boot-on`，vendor 驱动 `cypress,boot-on-ldo = "true"`
- *     时也**不会**去 enable 它 —— 即 S-Boot 已经打开并移交给内核。
- *     本 DTS 不声明该 LDO：未在 DT 中声明的 regulator 其 constraints
- *     为空，regulator core 的 late cleanup 会跳过它，不会被关掉。
+ *
+ * 【DSH 2026-10-21 实测修正 —— 之前"芯片不响应"的两个真正原因】
+ *
+ *   1) 核心电源 vtouch_3.3v = S2MPS15 LDO21 **在启动后是关着的**。
+ *      旧注释假设"S-Boot 已打开、未声明的 regulator 不会被关"，实测
+ *      不成立：mainline 的 s2mps11 驱动会给 s2mps15 的每个 LDO 都注册
+ *      regulator（即使 DT 里没有子节点），当前 /sys/class/regulator/
+ *      regulator.22 (LDO21) = disabled；直接读 PMIC 寄存器 0x48
+ *      (L1CTRL+20) = 0x3c，bit[7:6]=00 即硬件关闭。
+ *      现场实验：写 0x48=0xfc (bit[7:6]=11) 上电后，0x20 立刻回
+ *      ACK，0x03=0x00、0x04=0x0d；再写回 0x3c 断电，又变回 -ENXIO。
+ *      ⇒ 由驱动通过 `vdd-supply` 显式上电（见 touch-power.dtsi 的
+ *        LDO21 节点），并等 150ms 稳定时间，不再依赖 bootloader 状态。
+ *
+ *   2) ATTN (gpa0-0) 之前既没配成 EINT，也没有上拉。
+ *      读 0x10580008 (GPA0PUD) 为 0x5df5，pin0 的 2-bit PUD 字段 =
+ *      0b01 (pull-down)；CON 为 func=0 (GPIO 输入)。实测该线是
+ *      高阻/开漏输出：PUD=none/down 时 DAT 读到 0，只有 PUD=up 时才
+ *      读到 1（板上没有外部上拉）。旧 DTS 完全没给 gpa0-0 配 pinctrl，
+ *      所以中断永远不会来，而且下拉会把线钉死。
+ *      ⇒ 加 touchkey_irq_pins：gpa0-0 = EINT + pull-up。
+ *
  *   - 状态寄存器 0x03：每个键 2 bit，0b01=按下，0b10=抬起
  *     （vendor 驱动 touchkey_keycode[] = { 0, KEY_RECENT, KEY_BACK }，
  *      即 bit[1:0]=RECENT、bit[3:2]=BACK）。
- *     主线没有 Android 专用的 KEY_RECENT(254)，用语义等价的
- *     KEY_APPSELECT(580) 代替。
+ *     主线没有 Android 专用的 KEY_RECENT(254)；KEY_APPSELECT(580)
+ *     超过 255，xkb/GNOME 收不到，所以改用 KEY_MENU(139) —— 语义上
+ *     都是"最近任务/菜单"，用户态可再重映射成 Super。
  *   - 固件（cypress/cypress_zerof.fw）烧在 IC 内部 flash，原厂驱动只在
  *     版本不匹配时才走 ISP 重刷；主线驱动不刷固件，只读状态寄存器。
  * ==========================================================================
@@ -407,6 +425,17 @@
 		compatible = "i2c-gpio";
 		#address-cells = <1>;
 		#size-cells = <0>;
+
+		/*
+		 * pinctrl 必须放在 i2c-gpio 节点上：设备核心在 probe 前应用
+		 * default state，保证 gpd1-2/3 先被切成 GPIO（而不是 bootloader
+		 * 留下的外设功能），随后 i2c-gpio 才去 gpiod_get。
+		 * SDA/SCL 板上已有外部上拉；这里再开内部上拉作冗余，
+		 * 与 vendor hs_i2c3_bus 的 pull-up 配置一致。
+		 */
+		pinctrl-names = "default";
+		pinctrl-0 = <&touchkey_i2c_pins>;
+
 		sda-gpios = <&gpd1 2 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
 		scl-gpios = <&gpd1 3 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
 		i2c-gpio,delay-us = <5>;
@@ -417,11 +446,31 @@
 			reg = <0x20>;
 			interrupt-parent = <&gpa0>;
 			interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
-			linux,keycodes = <KEY_APPSELECT KEY_BACK>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&touchkey_irq_pins>;
+			vdd-supply = <&touchkey_ldo21>;
+			linux,keycodes = <KEY_MENU KEY_BACK>;
 		};
 	};
 };
 
+&pinctrl_bus0 {
+	touchkey_i2c_pins: touchkey-i2c-pins {
+		samsung,pins = "gpd1-2", "gpd1-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
+	};
+};
+
+&pinctrl_alive {
+	touchkey_irq_pins: touchkey-irq-pins {
+		samsung,pins = "gpa0-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+	};
+};
+
 /*
  * 显示控制器 DECON（0x13930000）。
  *
diff --git a/arch/arm64/boot/dts/exynos/exynos7420-zeroflte-touch-power.dtsi b/arch/arm64/boot/dts/exynos/exynos7420-zeroflte-touch-power.dtsi
--- a/arch/arm64/boot/dts/exynos/exynos7420-zeroflte-touch-power.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7420-zeroflte-touch-power.dtsi
@@ -55,6 +55,32 @@
 					regulator-always-on;
 					regulator-boot-on;
 				};
+
+				/*
+				 * DSH 2026-10-21: 触摸键 BACK/RECENT 的核心电源
+				 * vtouch_3.3v = S2MPS15 LDO21（vendor:
+				 * cypress,linked-vdd-backlight = "ldo21"）。
+				 *
+				 * 实测：启动后该 rail 是关的 —— regulator.22
+				 * state=disabled，PMIC 0x48 (L1CTRL+20) = 0x3c
+				 * (bit[7:6]=00)。CY8CMBR31x5 没电时 I2C 0x20
+				 * 返回 -ENXIO；手工写 0x48=0xfc 后马上能读出
+				 * 0x03=0x00 / 0x04=0x0d，写回 0x3c 又变回 -ENXIO。
+				 *
+				 * 不用 regulator-always-on：由 mbr-touchkey 驱动
+				 * 通过 touchkey@20 的 vdd-supply 显式 enable，
+				 * 这样 probe 顺序由 regulator 框架的 deferred probe
+				 * 保证，且驱动会等 150ms 的 IC 稳定时间。
+				 * regulator-boot-on 仅用于表达"上电时可能已被
+				 * bootloader 打开"，避免 core 的 late cleanup
+				 * 在多消费者场景下误关（当前单消费者，不影响）。
+				 */
+				touchkey_ldo21: LDO21 {
+					regulator-name = "vtouch_3.3v";
+					regulator-min-microvolt = <3300000>;
+					regulator-max-microvolt = <3300000>;
+					regulator-boot-on;
+				};
 			};
 		};
 	};
