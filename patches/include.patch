diff --git a/include/linux/dsh_diag.h b/include/linux/dsh_diag.h
new file mode 100644
index 000000000..a6cf9b675
--- /dev/null
+++ b/include/linux/dsh_diag.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_DSH_DIAG_H
+#define _LINUX_DSH_DIAG_H
+
+#define DSH_DIAG_MAGIC		0x4453484449414731UL
+#define DSH_DIAG_VERSION		1UL
+#define DSH_DIAG_RECORD_BYTES	608UL
+#define DSH_DIAG_TEXT_BYTES	512
+
+/* Board-local ARM64 ABI shared with the diagnostic loader.  Checksum is
+ * FNV-1a64 over all 608 bytes, treating the checksum field itself as zero.
+ * Keep the fields as 64-bit unsigned long words in the declared order.
+ */
+struct dsh_diag_record {
+	unsigned long magic;
+	unsigned long version;
+	unsigned long bytes;
+	unsigned long build_id;
+	unsigned long run_id;
+	unsigned long sequence;
+	unsigned long stage;
+	unsigned long initcall;
+	unsigned long caller;
+	unsigned long fmt;
+	unsigned long text_len;
+	unsigned long checksum;
+	char text[DSH_DIAG_TEXT_BYTES];
+};
+
+extern struct dsh_diag_record dsh_diag;
+
+void dsh_mark(unsigned long value);
+void dsh_diag_note(unsigned long stage, const char *message);
+void dsh_diag_panic(const char *message, unsigned long fmt,
+		    unsigned long caller);
+void dsh_diag_early_guard(void);
+
+#endif /* _LINUX_DSH_DIAG_H */
