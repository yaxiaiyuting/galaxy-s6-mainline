[Desktop Entry]
Name=SPlayer
Comment=简约的跨平台音乐播放器
# G9209: 必须走 X11(Xwayland) + 软件渲染，否则 Electron 会在 render node 上
# 调 DRM_IOCTL_MODE_CREATE_DUMB（modeset 类 ioctl，render node 不允许）
# → EPERM 反复重试 → mutter 的 MetaDisplay 被销毁
# → "meta_later_add: assertion 'display' failed" → 整个 GNOME 会话崩溃 → 系统重启
Exec=/opt/SPlayer/SPlayer --no-sandbox --disable-gpu --disable-gpu-compositing --use-gl=swiftshader --disable-dev-shm-usage --disable-features=Vulkan,UseSkiaRenderer %U
Terminal=false
Type=Application
Icon=SPlayer
Categories=AudioVideo;Audio;Player;
StartupWMClass=SPlayer
