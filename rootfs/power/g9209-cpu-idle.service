[Unit]
Description=G9209 CPU idle policy (offline big cores when screen off)
After=gdm.service
Wants=gdm.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/g9209-cpu-idle.sh
Restart=always
RestartSec=5
# 退出时恢复所有核心（脚本里也有 trap，双保险）
ExecStopPost=/bin/sh -c 'for c in 1 2 3 4 6 7; do [ "$(cat /sys/devices/system/cpu/cpu$c/online 2>/dev/null)" = "0" ] && echo 1 > /sys/devices/system/cpu/cpu$c/online; done; true'

[Install]
WantedBy=multi-user.target
